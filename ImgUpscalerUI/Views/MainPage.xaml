<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ALHPro.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBgBrush}">

    <!-- 整体留边 + 圆角卡片布局(用系统标题栏:窗口秒显,无黑屏;左上角图片在左导航顶部) -->
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <!-- 左侧导航 -->
            <ColumnDefinition Width="170"/>
            <!-- 主工作区 -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧导航栏(圆角卡片) ============ -->
        <Border Grid.Column="0" Background="{StaticResource AppPanelBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 左上角:图标 + 软件名(图片用打包资源 ms-appx 加载,稳定) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="16,14,0,12"
                            VerticalAlignment="Center">
                    <Image x:Name="NavLogoIcon" Width="24" Height="24" Stretch="Uniform"
                           VerticalAlignment="Center" Source="ms-appx:///Assets/ALHPro_icon.png"/>
                    <TextBlock Text="ALH Pro" FontSize="20" FontWeight="SemiBold"
                               Foreground="#E8ECF2" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 导航项 -->
                <ListView x:Name="NavList" Grid.Row="1" SelectionChanged="NavList_SelectionChanged"
                          Background="Transparent" BorderThickness="0">
                    <ListViewItem x:Name="NavUpscale" Tag="upscale" Padding="14,10">
                        <TextBlock Text="图片放大" FontSize="13"/>
                    </ListViewItem>
                    <ListViewItem x:Name="NavCutout" Tag="cutout" Padding="14,10">
                        <TextBlock Text="AI 抠图" FontSize="13"/>
                    </ListViewItem>
                    <ListViewItem x:Name="NavVideo" Tag="video" Padding="14,10">
                        <TextBlock Text="视频处理" FontSize="13"/>
                    </ListViewItem>
                    <ListViewItem x:Name="NavAudio" Tag="audio" Padding="14,10">
                        <TextBlock Text="音频处理" FontSize="13"/>
                    </ListViewItem>
                </ListView>

                <!-- 底部署名 + 常用入口 + 关于 -->
                <StackPanel Grid.Row="2" Padding="14,12" Spacing="6">
                    <TextBlock Text="AlL.H" FontSize="16" FontWeight="SemiBold"
                               Foreground="#E8ECF2"/>
                    <Button Content="请作者喝咖啡" Click="CoffeeCard_Click" HorizontalAlignment="Stretch"
                            Padding="0,5" FontSize="11" Margin="0,2,0,0"
                            ToolTipService.ToolTip="完全自愿:请作者喝一杯咖啡(软件无广告/无账号)"/>
                    <Button Content="ALH Pro 社区" Click="Community_Click" HorizontalAlignment="Stretch"
                            Padding="0,5" FontSize="11" Margin="0,2,0,0"
                            ToolTipService.ToolTip="官方交流社区:使用问题 / 功能建议 / 处理效果交流"/>
                    <Button Content="使用教程" Click="Tutorial_Click" HorizontalAlignment="Stretch"
                            Padding="0,5" FontSize="11" Margin="0,2,0,0"
                            ToolTipService.ToolTip="图文操作说明:每个功能怎么用、参数什么时候调、常见问题处理"/>
                    <Button Content="设置" Click="Settings_Click" HorizontalAlignment="Stretch"
                            Padding="0,5" FontSize="11" Margin="0,2,0,0"
                            ToolTipService.ToolTip="设置:计算设备、诊断日志等"/>
                    <Button Content="关于" Click="About_Click" HorizontalAlignment="Stretch"
                            Padding="0,5" FontSize="11" Margin="0,2,0,0"/>

                    <!-- ============ 左栏底部「广告」动态区(作者 GitHub 投放,5 张卡本地 30s 轮播;可点/滑动切上下一张) ============ -->
                    <Border x:Name="AdCard" CornerRadius="10" Background="#14FFFFFF"
                            BorderBrush="#22FFFFFF" BorderThickness="1" Margin="0,6,0,0" Padding="12,8"
                            HorizontalAlignment="Stretch"
                            ManipulationMode="TranslateX" ManipulationDelta="AdCard_ManipulationDelta"
                            ManipulationCompleted="AdCard_ManipulationCompleted"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- 内容:图(可选) + 标题 + 正文;顶部留白避免与右上角关闭按钮重叠;文字 Wrap 强制换行显示完整 -->
                            <StackPanel Grid.Row="0" Spacing="5" Margin="0,6,0,0" Tapped="AdCardTapped">
                                <!-- 图:居中、圆角、固定高度,Width 自适应不撑满;无图自动隐藏 -->
                                <Border x:Name="AdImageFrame" CornerRadius="8" Background="#22FFFFFF"
                                        HorizontalAlignment="Center" Padding="4" Visibility="Collapsed">
                                    <Image x:Name="AdImage" Width="84" Height="84" Stretch="UniformToFill"/>
                                </Border>
                                <!-- 标题行:标题 + 可选「推广」角标。用 Grid 分两列:* 列给标题=受限宽度→强制换行;Auto 列给角标。合规:广告可识别 -->
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="AdTitle" Grid.Column="0" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#E8ECF2" TextWrapping="Wrap" TextTrimming="None"
                                               Visibility="Collapsed"/>
                                    <Border x:Name="AdSponsorBadge" Grid.Column="1" Background="#33E8A33D"
                                            CornerRadius="4" Padding="4,1" VerticalAlignment="Top"
                                            Margin="6,0,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="AdSponsorText" FontSize="8" Foreground="#E8B04A"
                                                   Text="推广"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="AdText" FontSize="10" Opacity="0.85" LineHeight="14"
                                           Foreground="#C7CEDA" TextWrapping="Wrap" TextTrimming="None"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                            <!-- 上一张/下一张:独立一行、卡片最底部、最小紧凑,不挡任何内容 -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center" Margin="0,6,0,0">
                                <Button Content="◀" FontSize="9" Padding="7,1" MinWidth="0"
                                        Background="#1AFFFFFF" BorderThickness="0" Foreground="#AAFFFFFF"
                                        CornerRadius="6" Click="AdPrev_Click" ToolTipService.ToolTip="上一张(点击或向左滑动)"/>
                                <TextBlock Text="·" FontSize="9" Opacity="0.3" VerticalAlignment="Center"/>
                                <Button Content="▶" FontSize="9" Padding="7,1" MinWidth="0"
                                        Background="#1AFFFFFF" BorderThickness="0" Foreground="#AAFFFFFF"
                                        CornerRadius="6" Click="AdNext_Click" ToolTipService.ToolTip="下一张(点击或向左滑动)"/>
                            </StackPanel>
                            <!-- 关闭按钮:贴右上角(在卡片内、不超出),内容顶部已留白不会压到标题 -->
                            <Button x:Name="AdCloseBtn" Content="✕" FontSize="9" Padding="4,1" MinWidth="0"
                                    Background="#1AFFFFFF" BorderThickness="0" Foreground="#66FFFFFF"
                                    CornerRadius="6"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0"
                                    Click="AdClose_Click" ToolTipService.ToolTip="本次运行隐藏广告"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 主工作区 ============ -->
        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 中央内容区 -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 新版本提示条:启动检查发现新版时出现(可点「去下载」或关闭) -->
                <Border x:Name="UpdateBar" Grid.Row="0" Visibility="Collapsed"
                        Background="#2EE8A33D" BorderBrush="#77E8A33D" BorderThickness="1"
                        CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Image Source="ms-appx:///Assets/ALHPro_icon.png" Width="18" Height="18"
                                   VerticalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock x:Name="UpdateBarText" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="UpdateBarNetDiskBtn" Grid.Column="1" Content="网盘下载" FontSize="12"
                                Padding="14,4" Margin="10,0,8,0" Click="UpdateBarNetDisk_Click"
                                Background="Transparent" BorderBrush="#55FFFFFF"/>
                        <Button x:Name="UpdateBarGoBtn" Grid.Column="2" Content="GitHub下载" FontSize="12"
                                Padding="14,4" Margin="0,0,8,0" Style="{StaticResource AccentButtonStyle}"
                                Click="UpdateBarGo_Click"/>
                        <Button Grid.Column="3" Content="✕" FontSize="12" Padding="10,4"
                                Background="Transparent" BorderThickness="0"
                                Click="UpdateBarClose_Click"/>
                    </Grid>
                </Border>

                <Grid x:Name="ContentRoot" Grid.Row="1"/>
            </Grid>

            <!-- 底部状态栏:左侧常规状态,右侧休息提示 + 「跳过休息」按钮 + 最右侧作者提示(提前提示;随窗口宽度自动贴右) -->
            <Border Grid.Row="1" Background="{StaticResource AppPanel2Brush}"
                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Margin="0,10,0,0" Padding="12,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.55" Text="就绪"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="RestHint" Grid.Column="1" FontSize="11"
                               FontWeight="SemiBold" Margin="16,0,0,0" Visibility="Collapsed"
                               Foreground="#E8A33D" Text="休息中"
                               ToolTipService.ToolTip="设备降温休息中"/>
                    <Button x:Name="SkipRestBtn" Grid.Column="2" Content="跳过休息"
                            Margin="10,0,0,0" Padding="16,4" FontSize="12"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="Collapsed" Click="SkipRestBtn_Click"
                            ToolTipService.ToolTip="立即跳过本次休息,继续处理"/>
                    <!-- 作者提示:状态栏最右列(随窗口宽度贴右);从 GitHub hint/ 更新,每 30 秒换一条,可点跳转 -->
                    <Border x:Name="TipStrip" Grid.Column="3" CornerRadius="8" Padding="10,5"
                            Background="#2A10141C" BorderBrush="#33FFFFFF" BorderThickness="1"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="Collapsed" Tapped="TipStrip_Tapped">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon x:Name="TipIcon" Glyph="&#xE946;" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TipText" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextWrapping="NoWrap" MaxWidth="240"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="TipCloseBtn" Content="✕" FontSize="9" Padding="4,1" MinWidth="0"
                                    Background="Transparent" BorderThickness="0" Foreground="#88FFFFFF"
                                    CornerRadius="6" VerticalAlignment="Center"
                                    Click="TipClose_Click" ToolTipService.ToolTip="本次运行隐藏提示"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 启动自检遮罩:首次启动 / 版本更新后才显示;自检完成前遮挡主界面,避免用户在未完成设备适配时误操作 -->
        <Grid x:Name="SelfCheckOverlay" Grid.ColumnSpan="2"
              Background="#CC0C1016" Visibility="Collapsed" IsHitTestVisible="True">
            <Border Background="{StaticResource AppPanelBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="36,28" MaxWidth="540" MaxHeight="560"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12" Width="470">
                    <TextBlock x:Name="SelfCheckTitle" Text="本机设备自检" FontSize="20" FontWeight="SemiBold"
                               Foreground="#E8ECF2" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SelfCheckHint" FontSize="12" Opacity="0.7"
                               TextWrapping="Wrap" HorizontalAlignment="Center"
                               Text="正在检测本机计算环境,请稍候。"/>
                    <StackPanel x:Name="SelfCheckItems" Spacing="9" Margin="0,8,0,0">
                        <!-- 每一行:自检项名称 + 状态(代码动态填充) -->
                    </StackPanel>
                    <ProgressRing x:Name="SelfCheckProgress" IsActive="False" Width="46" Height="46"
                                  HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <!-- 报告区:固定高度(超出可滚动),「确定」按钮始终贴在它下边、位置稳定 -->
                    <ScrollViewer x:Name="SelfCheckScroll" Height="340" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SelfCheckReport" Spacing="3"/>
                    </ScrollViewer>
                    <Button x:Name="SelfCheckOkBtn" Content="确定" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Center" MinWidth="120" Margin="0,10,0,0"
                            Visibility="Collapsed" Click="SelfCheckOk_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 请作者喝咖啡 赞助提示遮罩 -->
        <Grid x:Name="SponsorOverlay" Grid.ColumnSpan="2"
              Background="#D8000000" Visibility="Collapsed" IsHitTestVisible="True">
            <Border Background="{StaticResource AppPanelBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="40,32" MaxWidth="540"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="感谢使用 ALH Pro" FontSize="22" FontWeight="SemiBold"
                               Foreground="#E8ECF2" TextAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Text="如果 ALH Pro 对你有帮助,欢迎请作者喝杯咖啡,支持作者持续更新与修复。"
                               FontSize="14" Opacity="0.92" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="你的支持是作者持续优化软件的最大动力。"
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="请作者喝咖啡" Style="{StaticResource AccentButtonStyle}" Padding="18,7"
                                Click="SponsorCoffee_Click"/>
                        <Button Content="暂时不了" Padding="18,7" Click="SponsorClose_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
