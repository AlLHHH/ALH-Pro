<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ALHPro.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBgBrush}">

    <!-- 整体留边 + 圆角卡片布局(用系统标题栏:窗口秒显,无黑屏;左上角图片在左导航顶部) -->
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <!-- 左侧导航 -->
            <ColumnDefinition Width="170"/>
            <!-- 主工作区 -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧导航栏(圆角卡片) ============ -->
        <Border Grid.Column="0" Background="{StaticResource AppPanelBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 左上角:图标 + 软件名(图片用打包资源 ms-appx 加载,稳定) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="16,14,0,12"
                            VerticalAlignment="Center">
                    <Image x:Name="NavLogoIcon" Width="24" Height="24" Stretch="Uniform"
                           VerticalAlignment="Center" Source="ms-appx:///Assets/ALHPro_icon.png"/>
                    <TextBlock Text="ALH Pro" FontSize="20" FontWeight="SemiBold"
                               Foreground="#E8ECF2" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 导航项 -->
                <ListView x:Name="NavList" Grid.Row="1" SelectionChanged="NavList_SelectionChanged"
                          Background="Transparent" BorderThickness="0">
                    <ListViewItem x:Name="NavUpscale" Tag="upscale" Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <FontIcon Glyph="&#xE8B9;" FontSize="14"/>
                            <TextBlock Text="图片放大" FontSize="13"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="NavCutout" Tag="cutout" Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <FontIcon Glyph="&#xE16B;" FontSize="14"/>
                            <TextBlock Text="AI 抠图" FontSize="13"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem x:Name="NavVideo" Tag="video" Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <FontIcon Glyph="&#xE714;" FontSize="14"/>
                            <TextBlock Text="视频处理" FontSize="13"/>
                        </StackPanel>
                    </ListViewItem>
                </ListView>

                <!-- 底部署名 + 诊断日志 + 关于 -->
                <StackPanel Grid.Row="2" Padding="14,12" Spacing="6">
                    <TextBlock Text="AlL.H" FontSize="16" FontWeight="SemiBold"
                               Foreground="#E8ECF2"/>
                    <Button Content="☕ 请作者喝咖啡" Click="CoffeeCard_Click" HorizontalAlignment="Stretch"
                            Padding="0,5" FontSize="11" Margin="0,2,0,0"
                            ToolTipService.ToolTip="完全自愿:请作者喝一杯咖啡(软件无广告/无账号)"/>
                    <Button Content="💬 ALH Pro 社区" Click="Community_Click" HorizontalAlignment="Stretch"
                            Padding="0,5" FontSize="11" Margin="0,2,0,0"
                            ToolTipService.ToolTip="官方交流社区:使用问题 / 功能建议 / 处理效果交流(友好交流,不爆粗口)"/>
                    <Button Content="📖 使用教程" Click="Tutorial_Click" HorizontalAlignment="Stretch"
                            Padding="0,5" FontSize="11" Margin="0,2,0,0"
                            ToolTipService.ToolTip="图文操作说明:每个功能怎么用、参数什么时候调、常见问题处理"/>
                    <Button Content="设置" Click="Settings_Click" HorizontalAlignment="Stretch"
                            Padding="0,5" FontSize="11" Margin="0,2,0,0"
                            ToolTipService.ToolTip="设置:诊断日志等"/>
                    <Button Content="关于" Click="About_Click" HorizontalAlignment="Stretch"
                            Padding="0,5" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 主工作区 ============ -->
        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 中央内容区 -->
            <Grid x:Name="ContentRoot" Grid.Row="0"/>

            <!-- 底部状态栏:左侧常规状态,右侧休息提示 + 显眼的「跳过休息」按钮(休息时出现) -->
            <Border Grid.Row="1" Background="{StaticResource AppPanel2Brush}"
                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Margin="0,10,0,0" Padding="12,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.55" Text="就绪"
                               Tapped="StatusText_Tapped" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="单击查看日志详情"/>
                    <TextBlock x:Name="RestHint" Grid.Column="1" FontSize="11"
                               FontWeight="SemiBold" Margin="16,0,0,0" Visibility="Collapsed"
                               Foreground="#E8A33D" Text="😴 休息中"
                               ToolTipService.ToolTip="设备降温休息中"/>
                    <Button x:Name="SkipRestBtn" Grid.Column="2" Content="跳过休息"
                            Margin="10,0,0,0" Padding="16,4" FontSize="12"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="Collapsed" Click="SkipRestBtn_Click"
                            ToolTipService.ToolTip="立即跳过本次休息,继续处理"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
