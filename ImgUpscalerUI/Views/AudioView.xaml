<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="ALHPro.Views.AudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧:参数面板 -->
        <Border Grid.Column="0" Background="{StaticResource AppPanelBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="12" Margin="0,0,10,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="14,16" Spacing="14">

                    <TextBlock Text="输入" Style="{StaticResource SectionTitle}"/>
                    <Button x:Name="PickAudioBtn" Content="选择音频文件(可多选)..." Click="PickAudioBtn_Click"
                            HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="AudioInfo" Text="未选择音频"
                               Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis"/>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <TextBlock Text="音频增强" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="降噪" Style="{StaticResource SectionTitle}"/>
                    <RadioButtons x:Name="DenoiseRadios" SelectedIndex="0" ToolTipService.ToolTip="FFT 降噪(afftdn):去底噪/电流声/压缩噪点(仅录音/降噪场景适用;对已混音音乐可能削细节)"
                                  SelectionChanged="Options_Changed">
                        <RadioButton Content="关"/>
                        <RadioButton Content="弱"/>
                        <RadioButton Content="强"/>
                    </RadioButtons>

                    <CheckBox x:Name="LoudnessCheck" Content="响度归一(音量统一)" ToolTipService.ToolTip="EBU R128 响度标准化:音量忽大忽小统一,听感更稳"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>

                    <CheckBox x:Name="LowcutCheck" Content="低切(去低频隆隆声)" ToolTipService.ToolTip="40Hz 高通:去掉低频轰鸣/底噪,人声/音乐更干净"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>

                    <CheckBox x:Name="EqCheck" Content="清晰增强(高频微调)" ToolTipService.ToolTip="3.5kHz 柔和提升 2dB:话语/乐器更明亮清晰"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <TextBlock Text="输出格式" Style="{StaticResource SectionTitle}"/>
                    <RadioButtons x:Name="FmtRadios" SelectedIndex="0" ToolTipService.ToolTip="WAV/FLAC 无损;MP3 有损(文件小)"
                                  SelectionChanged="Options_Changed">
                        <RadioButton Content="MP3 (推荐,兼容)"/>
                        <RadioButton Content="WAV (无损)"/>
                        <RadioButton Content="FLAC (无损)"/>
                    </RadioButtons>

                    <TextBlock Text="控制" Style="{StaticResource SectionTitle}"/>
                    <Button x:Name="RunBtn" Content="开始处理" HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="RunBtn_Click"/>
                    <Button x:Name="CancelBtn" Content="强制结束" HorizontalAlignment="Stretch"
                            IsEnabled="False" Click="CancelBtn_Click"/>
                    <ProgressBar x:Name="AudioProgress" Minimum="0" Maximum="100" Value="0"/>
                    <TextBlock x:Name="AudioStatus" Text="" Style="{StaticResource HintText}" TextWrapping="Wrap"/>

                    <!-- 日志(左下,仿视频页) -->
                    <Border Background="{StaticResource AppBgBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8,6">
                        <ScrollViewer x:Name="LogScroll" MaxHeight="180" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogText" FontSize="10" Opacity="0.7"
                                       TextWrapping="Wrap" Text="日志:等待任务..."/>
                        </ScrollViewer>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右侧:工具 + 列表 + 预览(带裁剪) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 列表工具栏 -->
            <Grid Grid.Row="0" ColumnSpacing="8" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="AddAudioBtn" Content="添加音频" FontSize="12"
                        Padding="10,5" Click="PickAudioBtn_Click"/>
                <Button x:Name="RemoveAudioBtn" Grid.Column="1" Content="删除选中" FontSize="12"
                        Padding="10,5" IsEnabled="False" Click="RemoveAudio_Click"/>
                <Button x:Name="ClearAudioBtn" Grid.Column="2" Content="清空" FontSize="12"
                        Padding="10,5" IsEnabled="False" Click="ClearAudio_Click"/>
                <Button x:Name="ClearDoneAudioBtn" Grid.Column="3" Content="清除已完成" FontSize="12"
                        Padding="10,5" IsEnabled="False" Click="ClearDoneAudio_Click"
                        ToolTipService.ToolTip="清除所有已完成的项目"/>
                <TextBlock Grid.Column="4" Text="双击预览 · 拖动波形两端裁剪" FontSize="11"
                           Opacity="0.5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <!-- 列表(支持框选多选 + Delete 删除) -->
            <Grid x:Name="AudioListHost" Grid.Row="1" AllowDrop="True"
                  DragOver="DropAudio_DragOver" Drop="DropAudio_Drop"
                  PointerPressed="AudioListHost_PointerPressed"
                  PointerMoved="AudioListHost_PointerMoved"
                  PointerReleased="AudioListHost_PointerReleased"
                  PointerCaptureLost="AudioListHost_PointerCaptureLost">
                <ListView x:Name="AudioList" SelectionMode="Multiple"
                          Background="{StaticResource AppPanelBrush}"
                          BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                          CornerRadius="12" Padding="8" Margin="0,0,0,10"
                          AllowDrop="True" DragOver="DropAudio_DragOver" Drop="DropAudio_Drop"
                          SelectionChanged="AudioList_SelectionChanged"
                          DoubleTapped="AudioList_DoubleTapped"
                          KeyDown="AudioList_KeyDown"
                          ToolTipService.ToolTip="">   <!-- 显式空提示:覆盖 WinUI 对空列表悬停的默认"删除"伪影提示 -->
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Display}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!-- 框选矩形(橡皮筋) -->
                <Canvas IsHitTestVisible="False">
                    <Rectangle x:Name="RbRectA" Stroke="#4C8DFF" StrokeThickness="1"
                               Fill="#404C8DFF" Visibility="Collapsed"/>
                </Canvas>
            </Grid>

            <!-- 预览区:波形 + 播放 + 首尾裁剪(双击列表项才展开) -->
            <Border Grid.Row="2" Background="{StaticResource AppPanel2Brush}"
                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                    Visibility="Collapsed" x:Name="PreviewPanel">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PreviewName" Text="" Style="{StaticResource HintText}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PreviewMeta" Grid.Column="1" FontSize="11" Opacity="0.6"
                                   Text=""/>
                        <Button x:Name="PreviewCloseBtn" Grid.Column="2" Content="✕" FontSize="14"
                                Width="32" Height="30" Padding="0" Background="Transparent" BorderThickness="0"
                                Click="PreviewCloseBtn_Click" ToolTipService.ToolTip="关闭预览"/>
                    </Grid>

                    <!-- 波形图:自绘(峰值条 + 播放进度线 + 裁剪把手) -->
                    <Grid x:Name="WaveHost" Height="72" PointerPressed="WaveHost_PointerPressed"
                          PointerMoved="WaveHost_PointerMoved" PointerReleased="WaveHost_PointerReleased">
                        <Border Background="{StaticResource AppBgBrush}" CornerRadius="6"/>
                        <Canvas x:Name="WaveCanvas" SizeChanged="WaveCanvas_SizeChanged"/>

                        <!-- 裁剪区间高亮 -->
                        <Rectangle x:Name="TrimRange" Fill="#304C8DFF"
                                   HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                   Visibility="Collapsed"/>
                        <!-- 播放进度线 -->
                        <Rectangle x:Name="PlayLine" Width="2" Fill="#4C8DFF"
                                   HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                   Visibility="Collapsed"/>
                        <!-- 裁剪把手:左右各一个(可拖) -->
                        <Rectangle x:Name="TrimStartThumb" Width="10" Fill="#4C8DFF" RadiusX="3" RadiusY="3"
                                   HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                   PointerPressed="TrimThumb_PointerPressed" PointerMoved="TrimThumb_PointerMoved"
                                   PointerReleased="TrimThumb_PointerReleased"
                                   Visibility="Collapsed"/>
                        <Rectangle x:Name="TrimEndThumb" Width="10" Fill="#4C8DFF" RadiusX="3" RadiusY="3"
                                   HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                   PointerPressed="TrimThumb_PointerPressed" PointerMoved="TrimThumb_PointerMoved"
                                   PointerReleased="TrimThumb_PointerReleased"
                                   Visibility="Collapsed"/>
                    </Grid>

                    <!-- 控制条:自绘(播放/暂停 + 时间 + 音量) — 不用 MediaPlayerElement 自带控件 -->
                    <Grid ColumnSpacing="8" x:Name="ControlBar">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PlayBtn" Width="44" Height="36" Padding="0"
                                Background="{StaticResource AppPanelBrush}" Click="PlayBtn_Click">
                            <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="14"/>
                        </Button>
                        <Button x:Name="ResetBtn" Grid.Column="1" Content="再听一次" FontSize="11" Padding="10,4"
                                Click="ResetBtn_Click"/>
                        <TextBlock x:Name="TimeText" Grid.Column="2" Text="0:00 / 0:00" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <!-- 音量:拖动滑动条调音量(拖到最左=静音) -->
                        <Slider x:Name="VolSlider" Grid.Column="3" Width="130" Minimum="0" Maximum="100"
                                Value="100" VerticalAlignment="Center" StepFrequency="5"
                                ValueChanged="VolSlider_ValueChanged"/>
                        <TextBlock Grid.Column="5" Text="点波形跳位置" FontSize="11" Opacity="0.5"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="6" Text="拖两端裁剪" FontSize="11" Opacity="0.5"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- 裁剪信息(只读显示) -->
                    <TextBlock x:Name="TrimHint" Text="" FontSize="11" Opacity="0.6"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
