<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="ALHPro.Views.AudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧:参数面板 -->
        <Border Grid.Column="0" Background="{StaticResource AppPanelBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="12" Margin="0,0,10,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="14,16" Spacing="14">

                    <TextBlock Text="输入" Style="{StaticResource SectionTitle}"/>
                    <Button x:Name="PickAudioBtn" Content="选择音频文件(可多选)..." Click="PickAudioBtn_Click"
                            HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="AudioInfo" Text="未选择音频"
                               Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis"/>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <TextBlock Text="音频增强" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="降噪" Style="{StaticResource SectionTitle}"/>
                    <RadioButtons x:Name="DenoiseRadios" SelectedIndex="0" ToolTipService.ToolTip="宽带降噪(anlmdn):去底噪/电流声/压缩噪点"
                                  SelectionChanged="Options_Changed">
                        <RadioButton Content="关"/>
                        <RadioButton Content="弱"/>
                        <RadioButton Content="强"/>
                    </RadioButtons>

                    <CheckBox x:Name="LoudnessCheck" Content="响度归一(音量统一)" ToolTipService.ToolTip="EBU R128 响度标准化:音量忽大忽小统一,听感更稳"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>

                    <CheckBox x:Name="LowcutCheck" Content="低切(去低频隆隆声)" ToolTipService.ToolTip="40Hz 高通:去掉低频轰鸣/底噪,人声/音乐更干净"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>

                    <CheckBox x:Name="EqCheck" Content="清晰增强(高频微调)" ToolTipService.ToolTip="3.5kHz 柔和提升 2dB:话语/乐器更明亮清晰"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <TextBlock Text="输出格式" Style="{StaticResource SectionTitle}"/>
                    <RadioButtons x:Name="FmtRadios" SelectedIndex="0" ToolTipService.ToolTip="WAV/FLAC 无损;MP3 有损(文件小)"
                                  SelectionChanged="Options_Changed">
                        <RadioButton Content="MP3 (推荐,兼容)"/>
                        <RadioButton Content="WAV (无损)"/>
                        <RadioButton Content="FLAC (无损)"/>
                    </RadioButtons>

                    <TextBlock Text="控制" Style="{StaticResource SectionTitle}"/>
                    <Button x:Name="RunBtn" Content="开始处理" HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="RunBtn_Click"/>
                    <Button x:Name="CancelBtn" Content="强制结束" HorizontalAlignment="Stretch"
                            IsEnabled="False" Click="CancelBtn_Click"/>
                    <ProgressBar x:Name="AudioProgress" Minimum="0" Maximum="100" Value="0"/>
                    <TextBlock x:Name="AudioStatus" Text="" Style="{StaticResource HintText}" TextWrapping="Wrap"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右侧:文件列表 + 预览(带裁剪) + 日志 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="AudioListHost" Grid.Row="0" AllowDrop="True"
                  DragOver="DropAudio_DragOver" Drop="DropAudio_Drop">
                <ListView x:Name="AudioList" SelectionMode="Multiple"
                          Background="{StaticResource AppPanelBrush}"
                          BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                          CornerRadius="12" Padding="8" Margin="0,0,0,10"
                          AllowDrop="True" DragOver="DropAudio_DragOver" Drop="DropAudio_Drop"
                          SelectionChanged="AudioList_SelectionChanged"
                          DoubleTapped="AudioList_DoubleTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Display}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 预览区:播放 + 首尾裁剪(仿视频页,简化:滑块拖拽) -->
            <Border Grid.Row="1" Background="{StaticResource AppPanel2Brush}"
                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="PreviewName" Text="选中音频后可预览/裁剪" Style="{StaticResource HintText}"/>
                    <MediaPlayerElement x:Name="PreviewPlayer" Height="40"
                                        AreTransportControlsEnabled="True"/>
                    <Grid ColumnSpacing="8" x:Name="TrimRow" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TrimStartLabel" Text="起点 0:00" FontSize="11" Opacity="0.7"/>
                        <Slider x:Name="TrimStartSlider" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.01"
                                ValueChanged="TrimStartSlider_ValueChanged"/>
                        <Slider x:Name="TrimEndSlider" Grid.Column="2" Minimum="0" Maximum="1" StepFrequency="0.01"
                                ValueChanged="TrimEndSlider_ValueChanged"/>
                        <TextBlock x:Name="TrimEndLabel" Grid.Column="3" Text="终点 0:00" FontSize="11" Opacity="0.7"
                                   TextAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource AppPanel2Brush}"
                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="10,6">
                <TextBlock x:Name="LogText" FontSize="11" Opacity="0.8" Text="" TextWrapping="Wrap"
                           MaxHeight="90"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
