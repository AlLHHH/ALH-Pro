                        <TextBox x:Name="CustomHeightBox" Grid.Column="3" Text="1080"
                                 IsSpellCheckEnabled="False" TextChanged="Text_Changed"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <TextBlock Text="视频降噪" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="DenoiseToggle" Content="启用视频降噪" ToolTipService.ToolTip="去视频噪点/闪烁/压缩块。两种执行方式(自动选):① 超分用 waifu2x → 交给模型自带降噪(更对症、不额外耗时),此时即使不开本开关也用 2 档(实测压缩素材提升、干净素材基本无损);② 其它情况(Real-ESRGAN / 未超分) → 拆帧阶段用 ffmpeg nlmeans 在原始分辨率上降噪(实测比放在合帧阶段快 2.5~3.5 倍)"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>
                    <TextBlock x:Name="DenoiseKindLabel" Text="降噪算法" Style="{StaticResource SectionTitle}"/>
                    <ComboBox x:Name="DenoiseKindCombo" SelectedIndex="0" SelectionChanged="Combo_Changed"
                              ToolTipService.ToolTip="nlmeans + hqdn3d = 空间域与时间域联合降噪(默认):实测帧间抖动 −25%、细节保留 90%,综合最优&#x0a;nlmeans = 仅空间域降噪:去除单帧噪点,对细纹理有一定平滑作用(实测细节保留 71%)&#x0a;hqdn3d = 仅时间域降噪:去除帧间闪烁与颗粒,细节保留最佳,但不处理单帧噪点(实测其空间参数加倍后单帧噪点无变化),快速运动场景可能产生拖影">
                        <ComboBoxItem Content="nlmeans + hqdn3d（推荐）"/>
                        <ComboBoxItem Content="nlmeans（仅空间域降噪）"/>
                        <ComboBoxItem Content="hqdn3d（仅时间域降噪）"/>
                    </ComboBox>
                    <TextBlock x:Name="DenoiseStrongLabel" Text="降噪强度" Style="{StaticResource SectionTitle}"/>
                    <RadioButtons x:Name="DenoiseStrongRadios" SelectedIndex="0" ToolTipService.ToolTip="越强去噪越多,但可能抹掉细纹理。结合模式下强度主要加在时间维(空间固定轻档,实测这样抖动更低、细节更多)"
                                  SelectionChanged="Combo_Changed">
                        <RadioButton Content="弱"/>
                        <RadioButton Content="中"/>
                        <RadioButton Content="强"/>
                    </RadioButtons>

                    <TextBlock Text="视频调整 (后处理)" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Spacing="2">
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="锐化:只提细节,带阈值保护平坦区与噪点(实测 50 档只掉 0.35 dB;旧版会让边缘区掉 4.9 dB、白边和锯齿明显)">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="锐化" VerticalAlignment="Center"/>
                            <Slider Margin="-11,0,-11,0" x:Name="SharpenSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="SharpenVal" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="清晰:大半径局部对比度(只动中调,不硬吃边缘),画面更通透">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="清晰" VerticalAlignment="Center"/>
                            <Slider Margin="-11,0,-11,0" x:Name="ClaritySlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="ClarityVal" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="钝化蒙版:只锐化超过阈值的明显边缘,平坦区完全不动。实测是唯一不伤边缘结构的锐化档(边缘 SSIM 反升),预设里给得最多">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="钝化蒙版" VerticalAlignment="Center"/>
                            <Slider Margin="-11,0,-11,0" x:Name="UsmSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="UsmVal" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="保留细节:对比度自适应锐化(按局部对比决定增益),设计上不产生白边,实测全档最干净(平坦区误差几乎不涨)">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="保留细节" VerticalAlignment="Center"/>
                            <Slider Margin="-11,0,-11,0" x:Name="DetailSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="DetailVal" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="边缘抗锯齿:只削阶梯边缘和振铃(实测细节 −7%、结构指标反升)。超分后的斜线/曲线发锯就开它">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="边缘抗锯齿" VerticalAlignment="Center"/>
                            <Slider Margin="-11,0,-11,0" x:Name="PostAaSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="PostAaVal" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <!-- 【边缘增强 · 2026-09-15 新增】用户反馈"边缘糊、像没对上焦"。
                             实测(1080p → 2x,游戏帧):官方 v3 边缘宽度 2.23px → 加 0.3 档后 2.15px、
                             强边缘对比 52.3 → 58.0(+11%);其它模型用 0.6 档:2.24 → 2.16px、56.6 → 69.3(+22%),
                             过冲只涨 0.35~0.73 个百分点。阈值取 8 = 只动明确边缘(平坦区/噪点/细碎纹理不动),
                             这就是它和「锐化」(阈值 3/6、作用面更宽)的区别。
                             默认按模型给(见 VideoView.xaml.cs 的 RecommendedEdgeBoost):v3 → 30,其它四支 → 60。 -->
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="边缘增强:只加强「明确的边缘」(阈值保护平坦区与噪点),让轮廓更利落、不再发虚。实测边缘宽度变窄、强边缘对比 +11~22%,过冲仅 +0.35~0.73 个百分点。与「锐化」的区别是作用面更窄——只碰轮廓,不碰细纹。默认随模型给:animevideov3 用 30,其它四支用 60">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="边缘增强" VerticalAlignment="Center"/>
                            <Slider Margin="-11,0,-11,0" x:Name="PostEdgeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="PostEdgeVal" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                    <!-- 【已移除「去模糊」】视频侧 ffmpeg 没有反卷积滤镜,那档本质只是"大半径锐化",
                         与「清晰」重复且名不副实;图片页的「去模糊」是真 Richardson-Lucy 反卷积,那边保留。
                         实测与理由见 _qa\ab_waifu\POSTPROC_REPORT.md -->
                        <!-- 【已删除「去频闪」与「去杂色」两个滑条】
                             去频闪(deflicker):ffmpeg 该滤镜按时间窗口中值归一化亮度且不识别转场,
                             实测把每个硬切点前 3 帧压暗/提亮最多 76 级(0~255 的 30%)——即"转场前两帧黑一下/亮一下"。
                             它本是为延时摄影设计的,正常视频无此问题;属"不适用且有害",故整项移除。
                             去杂色(nlmeans):与上方「视频降噪」是同一滤镜的重复入口,同时开启时代码本就把本项跳过,
                             常见配置下等于空操作。降噪请用「视频降噪」(它在超分之前生效,那才是正确位置)。 -->
                        <Button x:Name="PostResetBtn" Content="重置调整" HorizontalAlignment="Right"
                                FontSize="12" Padding="12,4" Click="PostResetBtn_Click"
                                ToolTipService.ToolTip="把所有后处理参数清零"/>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <TextBlock Text="补帧 (RIFE)" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="InterpToggle" Content="启用补帧(生成中间帧)" ToolTipService.ToolTip="补帧:在原帧之间脑补出中间帧,让动作更流畅(动画/电影感)"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>

                    <TextBlock Text="补帧模型" Style="{StaticResource SectionTitle}"/>
                    <ComboBox x:Name="InterpModelCombo" HorizontalAlignment="Stretch"
                              ToolTipService.ToolTip="补帧模型:悬停每一项看官方说明、速度与模型大小。&#x0a;下拉已精简为两支 v4 架构模型 —— 选哪支都能用 3x/4x/12x/16x、指定帧率与「高质量 TTA」。&#x0a;以前选过 动漫专用 / 高清 / 超高清 / 经典兼容 的话,设置会自动改用 v4.13。"
                              SelectedIndex="0" SelectionChanged="Combo_Changed">
                        <!-- 【2026-09-16 用户裁决:只留 13 + 一个兼容性强的】下拉从 7 项精简到 2 项。
                             删掉的 5 项:通用画质再新(v4.26 —— engines\rife 里根本没有这个目录,且 TTA 卡死早已置灰,是个僵尸项)、
                             动漫专用(RIFE Anime)、高清(RIFE HD)、超高清(RIFE UHD)、经典兼容(RIFE v2.3)。
                             后 4 项是老三网络架构(各 57.3 / 54.0 MB),功能砍半:只能 2x 级联,不支持 3x/4x、指定帧率与 TTA。
                             留 v4.6 当备用的理由:与 v4.13 同架构、功能完全一样,只是旧一版 ⇒ 万一 v4.13 在某台机器上出问题,
                             切过去不丢任何功能;反之拿老架构当备用代价太大(用户一旦选到就只能 2x)。
                             ⚠ 序号即取值口径:0=v4.13、1=v4.6。老设置里存的 2~6 会被读设置时的范围检查挡掉 ⇒ 自动落到 0(v4.13)。
                             权重已移到 alh-pro\_retired_rife\(装机包因此小约 226MB),要恢复就搬回 engines\rife\ 并把本段改回来。 -->
                        <ComboBoxItem Content="通用画质最新 (RIFE v4.13)"
                                      ToolTipService.ToolTip="通用画质最新 (RIFE v4.13):官方 RIFE 的 ncnn 实现;官方 README 的模型表最新只列到 v4.6,v4.13 比它更新(出处:rife-ncnn-vulkan README)。&#x0a;本工程推荐:支持任意帧数精确补齐、3x/4x/12x/16x 与「高质量 TTA」,最稳。&#x0a;速度:1080p 约 0.06~0.09 秒/输出帧。&#x0a;模型大小:10.3 MB。"/>
                        <ComboBoxItem Content="通用画质 (RIFE v4.6)"
                                      ToolTipService.ToolTip="通用画质 (RIFE v4.6):官方 README 模型表里的 4.6 版(上游 4.6)。&#x0a;与 v4.13 同架构、功能完全一样(3x/4x、指定帧率、TTA 都支持),效果与稳定性略逊;留作 v4.13 在你机器上出问题时的备用。&#x0a;模型大小:10.1 MB。"/>
                    </ComboBox>
                    <!-- 补帧模型提示:随所选模型动态更新,说明推荐/各模型的问题(选 v4.13 提示推荐,选其它提示风险) -->
                    <TextBlock x:Name="InterpModelHint" FontSize="10" Opacity="0.65" TextWrapping="Wrap"
                               Margin="0,2,0,4" Text="通用画质 v4.13 为推荐模型(帧数精确、稳定);v4.6 与它同架构、功能一样,是备选。两支都支持 3x/4x 与指定帧率。"/>

                    <Button x:Name="FpsToggleBtn" Content="视频帧率 ▾" HorizontalAlignment="Stretch"
                            Click="FpsToggleBtn_Click"
                            ToolTipService.ToolTip="输入帧率设置:各视频默认帧率 / 帧率偏移 / 单独调整各视频帧率。
默认「各视频默认帧率」=每个视频按自身原始帧率处理,无需任何设置。"/>
                    <StackPanel x:Name="FpsPanel" Spacing="8" Margin="0,8,0,4" Visibility="Collapsed">
                        <RadioButtons x:Name="FpsModeRadios" SelectedIndex="0"
                                      SelectionChanged="Combo_Changed">
                            <RadioButton Content="各视频默认帧率(原帧率)"/>
                            <RadioButton Content="帧率偏移(统一减帧率)"/>
                            <RadioButton Content="单独调整各视频帧率"/>
                        </RadioButtons>

                        <!-- 模式 0:默认帧率(无额外控件) -->
                        <TextBlock x:Name="FpsDefaultHint"
                                   Text="各视频按自身原始帧率处理(自动探测),无需任何设置。"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap"/>

                        <!-- 模式 1:帧率偏移(滑条) -->
                        <Grid x:Name="FpsOffsetPanel" ColumnSpacing="8" Visibility="Collapsed"
                              ToolTipService.ToolTip="多视频统一帧率偏移:0=各视频用自己原帧率;-1~-20=原帧率减 N">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="帧率偏移" VerticalAlignment="Center"/>
                            <Slider Margin="-11,0,-11,0" x:Name="FpsOffsetSlider" Grid.Column="1" Minimum="-20" Maximum="0"
