<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="ALHPro.Views.VideoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 【蓝色「测试」小药丸 · 2026-09-15 第二次改小;2026-09-21 先撤掉、当天又按用户裁决放回】
             【命名 · 用户 2026-09-21 第四次定稿:名字前面加 alh】四项自训模型写作 `类别 · alh+名字（快）`:
             `现实 · alhreal2x（快）` / `游戏 · alhgame2x（快）` / `游戏 · alhgame2x-v2（快）` / `游戏 · alhgame2x-v3（快）`
             (用户原话"改名字 前面加上alh";写法示例 `现实 alhreal2x` 由用户给出 —— alh 与名字**连写、不加连字符**)。
             类别词仍是「游戏」/「现实」,**不出现"实验/实验性"字样**;括号里写**速度档**(`快`,见 Core.ExperimentalEsrgan.SpeedTier)——
             【2026-09-16 用户定稿】"括号内要写快 而不是时间":括号与官方项共用一套词(`快`/`中`/`超慢`),
             测出来的秒/帧数字挪到悬停提示与下拉下方那行提示里(那两处才是写数字的地方)。
             【宽度这笔账 · 2026-09-21 真机实测,不是估算】收起状态(组合框 235px)的像素布局:
               内容起点 x=16(3px 蓝条)→ 文字 x=25..183 → 下拉箭头 x=207..214 ⇒ 文字右侧**只剩约 18px**。
               行 = 蓝条 3 + 间距 6 + 文字 + 间距 6 [+ 药丸 30];自训四项最长那两行文字实测 168px,
               带药丸要 36px ⇒ **超出 18px、药丸会被箭头裁掉**(即 2026-09-14 那次"下拉框被遮挡")。
             【裁决 · 2026-09-21 用户选"加宽 22px"】左栏 300 → 322(见上面 ColumnDefinitions 的注释):
               余量 18 → 40px ⇒ 药丸原样放回仍有余量 ✓
             ⚠ 以后再动这一行:**必须量收起状态**(截图找箭头的左边缘),别只看展开的下拉 ——
               展开态的下拉项是**按内容自动变宽**的(实测:内容 177px → 项宽 201px、内容 195px → 项宽 219px),
               "展开态没被裁"**不等于**"收起态不会被裁"。 -->
        <Style x:Key="TestBadgePill" TargetType="Border">
            <Setter Property="Background" Value="#232E42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TestBadgeText" TargetType="TextBlock">
            <Setter Property="Text" Value="测试"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8FA9D6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 【宽度 300 → 322 · 2026-09-21 用户裁决】
                 【为什么要加这 22px】自训四项的名字加了项目前缀 `alh`(用户 2026-09-21:"改名字 前面加上alh"),
                 而末尾那个蓝色「测试」药丸要放回去。收起状态实测(截图找像素,不是估算):
                   组合框宽 235px 时,内容起点 x=16(3px 蓝条)→ 文字 x=25..183 → 下拉箭头 x=207..214
                   ⇒ 文字右侧只剩 **约 18px**;药丸要 6(间距)+30(药丸)= 36px ⇒ **放不下,硬塞会被箭头裁掉**
                   (那正是 2026-09-14 用户抱怨过的"下拉框被遮挡")。
                 三条出路(改类别词 / 换更小的标记 / 加宽面板)摆在用户面前,用户选了**加宽 22px**:
                 300 → 322 ⇒ 文字右侧余量 18 → 40px,药丸放回后仍有余量 ✓
                 【与 2026-09-14 那次"410 → 300"不矛盾】那次是 110px 的大改(右侧任务列表明显被挤窄),用户要求缩回;
                 这次是 22px 的最小必要增量,且是用户点名选的方案。
                 【其余标签不受影响】该面板里那些标签本来就按 ≈212px 可用宽度缩写过了,加宽只会给它们留更多余量。 -->
            <ColumnDefinition Width="322"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource AppPanelBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="12" Margin="0,0,10,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="14,16" Spacing="14">

                    <TextBlock Text="输入" Style="{StaticResource SectionTitle}"/>
                    <Button x:Name="PickVideoBtn" Content="选择视频文件(可多选)..." Click="PickVideoBtn_Click"
                            HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="VideoInfo" Text="未选择视频"
                               Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="裁剪:在右侧选中视频后可设置开始/结束时间" Style="{StaticResource HintText}"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <TextBlock Text="视频超分" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="UpscaleToggle" Content="启用超分(逐帧放大)" ToolTipService.ToolTip="逐帧 AI 放大画面"
                              IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed"/>

                    <TextBlock Text="放大倍数" Style="{StaticResource SectionTitle}"/>
                    <RadioButtons x:Name="VideoScaleRadios" SelectedIndex="1" ToolTipService.ToolTip="输出放大倍数(3x 内部按引擎支持倍数处理)"
                                  SelectionChanged="Combo_Changed">
                        <!-- 【2026-09-21 用户定案:1x 档整体换成 Anime4K 修复】
                             旧文案是「1x 超分（2x 放大后缩回）」—— 那条路我们自己早就实测判定是**错的用法**:
                             缩回会把细节又缩掉(源 detail 1176 → 818,比原片还软),同类软件根本不提供这种组合。
                             新做法:Anime4K 着色器(libplacebo + custom_shader_path)在**原分辨率**上做修复+锐化,不放大也不缩回。
                             实测(用户自己的 1080p 片子,同帧):边宽 6.76 → **5.96**、纹理 detail 不丢、与源细节层相关 0.909、
                             代价**平坦区噪声 1.74×**;与 Video2X 自带的 Anime4K 逐帧 44.4 dB = 同一处理。
                             ⚠ 回退:本机探测不过(缺 Vulkan/libplacebo)时自动退回旧的「2x 超分后缩回」并写日志,绝不让整批失败。 -->
                        <RadioButton x:Name="VScale1xRadio" Content="1x 修复"
                                     ToolTipService.ToolTip="1x 修复(**不放大**,画面尺寸不变):两个条目二选一。&#x0a;「动漫 · Anime4K 修复(快)」= 开源着色器在原分辨率做修复+锐化,不跑超分模型,约 15 FPS@1080p,适合有压缩损伤/偏软的素材。&#x0a;「现实 · 1x 修复(中)」= 用自训的「现实 · alhreal2x」按 2x 超分后再精确缩回原尺寸,干净素材上更接近原片(PSNR 36.8 对 35.8dB、噪点 1.54× 对 1.85×),代价是要跑完整一遍 2x、慢约 5 倍。&#x0a;Anime4K 需要能用的 Vulkan 显卡(探测不过会自动改用「现实 · 1x 修复」并写日志)。"/>
                        <RadioButton x:Name="VScale2xRadio" Content="2x"/>
                        <RadioButton x:Name="VScale3xRadio" Content="3x"/>
                        <RadioButton x:Name="VScale4xRadio" Content="4x"/>
                    </RadioButtons>
                    <!-- 【2026-09-21 再更新】1x 现在有**两个**条目(动漫 · Anime4K 修复 / 现实 · 1x 修复),
                         这句静态兜底文案也要跟着说清"两个都在做什么" —— 运行时那行是动态的(见 OneXScaleHint)。 -->
                    <TextBlock x:Name="ScaleHint" Text="1x 修复不放大(在「超分模型」里选:动漫用 Anime4K 着色器原分辨率修复,现实用自训模型 2x 后缩回);2x 及以上由超分模型放大,倍率越高越慢、显存占用越大"
                               Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                    <Grid x:Name="CustomSizePanel" ColumnSpacing="8" Visibility="Collapsed"
                          ToolTipService.ToolTip="自定义输出分辨率:超分后精确缩放到指定宽×高(留空=按倍率)">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="宽" VerticalAlignment="Center"/>
                        <TextBox x:Name="CustomWidthBox" Grid.Column="1" Text="1920"
                                 IsSpellCheckEnabled="False" TextChanged="Text_Changed"/>
                        <TextBlock Text="高" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox x:Name="CustomHeightBox" Grid.Column="3" Text="1080"
                                 IsSpellCheckEnabled="False" TextChanged="Text_Changed"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <TextBlock Text="超分引擎" Style="{StaticResource SectionTitle}"/>
                    <!-- 【顺序:Real-ESRGAN 在上、waifu2x 在下】(用户要求)列表顺序只影响界面,
                         存盘值仍用旧约定(0=waifu2x / 1=realesrgan),转换在 VideoView 的 EngineFromStored/EngineToStored,
                         这样老用户已保存的选择不会被翻转。 -->
                    <RadioButtons x:Name="VideoEngineRadios" SelectedIndex="0" ToolTipService.ToolTip="超分引擎:Real-ESRGAN 会主动合成细节(动漫/写实都明显变清晰);waifu2x 只做去噪/去压缩块 —— 干净素材上看起来≈单纯放大,只适合有噪点的老片源"
                                  SelectionChanged="Combo_Changed">
                        <RadioButton Content="Real-ESRGAN"/>
                        <RadioButton Content="waifu2x"/>
                    </RadioButtons>
                    <TextBlock x:Name="VideoModelLabel" Text="超分模型" Style="{StaticResource SectionTitle}"/>
                    <ComboBox x:Name="VideoWaifu2xModelCombo" ToolTipService.ToolTip="waifu2x 模型(动漫/通用/现实)"
                              SelectionChanged="Combo_Changed">
                        <!-- 【标签长度 · 2026-09-14】第 2 项原来写全名 `models-upconv_7_anime_style_art_rgb`,
                             界面字体实测 398px —— 比加宽后的下拉(可用 ~322px)还长,必然被裁。
                             改成 `upconv_7_anime`:与「预设摘要」里既有的叫法(`动漫·upconv_7_anime`,
                             见 VideoView.xaml.cs 的 UpWaifu2xModelNames)一致,长度 ~250px 可完整显示。
                             Tag 仍是引擎要的目录全名,不受显示名影响。 -->
                        <ComboBoxItem Content="通用 · cunet（24MB·中）" Tag="models-cunet"
                                      ToolTipService.ToolTip="通用 · cunet:官方 waifu2x 默认模型(cunet 架构,比 upconv_7 新、更慢、更干净)。&#x0a;适用:通用画面,动漫与实拍均可。&#x0a;速度 1080p 约 0.37 秒/帧 · 模型大小 24 MB。"/>
                        <ComboBoxItem Content="动漫 · upconv_7_anime（快）" Tag="models-upconv_7_anime_style_art_rgb"
                                      ToolTipService.ToolTip="动漫 · upconv_7_anime:官方 waifu2x 动漫模型(upconv_7 架构,比 cunet 快、画面略软)。&#x0a;适用:动漫 / 线稿。&#x0a;模型大小 5.3 MB。"/>
                        <ComboBoxItem Content="现实 · upconv_7_photo（快）" Tag="models-upconv_7_photo"
                                      ToolTipService.ToolTip="现实 · upconv_7_photo:官方 waifu2x 照片模型。&#x0a;适用:实拍照片。&#x0a;速度 1080p 约 1.29 秒/帧 · 模型大小 5.3 MB。"/>
                    </ComboBox>
                    <ComboBox x:Name="VideoEsrganModelCombo" Visibility="Collapsed"
                              ToolTipService.ToolTip="Real-ESRGAN 模型(按速度与体积排列)。&#x0a;末尾四项为本项目自训的 2x 模型(现实 · alhreal2x / 游戏 · alhgame2x / 游戏 · alhgame2x-v2 / 游戏 · alhgame2x-v3;名字里的 alh 与末尾那个蓝色「测试」小标都表示「这不是官方权重」)。"
                              SelectionChanged="Combo_Changed">
                        <!-- 【标签长度 · 2026-09-14 用户反馈"下拉框被遮挡"】左栏内部留白吃掉约 104px,
                             即使左栏加宽到 410,ComboBox 也只有 306px ⇒ 文字可用宽度 ~250px。
                             用界面字体(微软雅黑 14px)实测带厂商前缀的老写法最长达 310px,收起状态必被裁。
                             所以去掉冗余前缀(`realesr-` / `realesrgan-` / `models-`;引擎名由上面的
                             「超分引擎」与 ToolTip 说明,预设摘要里也一直是这个短叫法),现在最长 ~240px ✓。
                             ⚠ 读模型名一律走 Tag(引擎要的全名),不许改成读 Content —— 见 VideoView.xaml.cs 的 SelModel。 -->
                        <ComboBoxItem Content="动漫 · animevideov3（快）" Tag="realesr-animevideov3"
                                      ToolTipService.ToolTip="动漫 · animevideov3:官方动漫视频模型(体积最小、速度最快的一档)。&#x0a;适用:动漫长视频。&#x0a;速度 1080p 约 0.26~0.30 秒/帧 · 模型大小 3.8 MB(x2 / x3 / x4)。&#x0a;无 1x 权重:1x 会输出全黑画面,请用 2x 及以上。"/>
                        <ComboBoxItem Content="通用 · general-x4v3（快）" Tag="realesr-general-x4v3"
                                      ToolTipService.ToolTip="通用 · general-x4v3:官方通用模型,体积小、显存占用低;去模糊与去噪能力偏弱。&#x0a;速度 1080p 约 0.46 秒/帧 · 模型大小 4.9 MB。"/>
                        <!-- ↓ 第 3 项(序号 2):自转的带降噪通用模型。**这一行绝不能少** ——
                             2026-09-14 重排时曾漏掉它(只留了注释),结果下拉里 5 项变 4 项,
                             而 VideoModelOrder 仍按 5 项映射(Rev2 的 4→新 2),老用户存的序号会被解释成错的模型。
                             是"看真实界面截图"才发现的;以后改这个下拉,必须用界面确认 5 项都在且顺序如上。 -->
                        <ComboBoxItem Content="通用 · wdn-x4v3（快）" Tag="realesr-general-wdn-x4v3"
                                      ToolTipService.ToolTip="通用 · wdn-x4v3:官方通用模型(带 WDN 去噪训练),细节略多。&#x0a;速度 1080p 约 0.46 秒/帧 · 模型大小 4.9 MB。"/>
                        <!-- 【顺序 · Rev3 · 2026-09-14 用户要求】整个下拉按**速度与体积**排(快/小 → 慢/大):
                             0 realesr-animevideov3 4MB 0.26~0.30 秒/帧
                             1 realesr-general-x4v3  5MB 0.458 秒/帧
                             2 realesr-general-wdn-x4v3 5MB 0.460 秒/帧(新加,自转;实测 20 帧批跑与 general 差 0.42%)
                             3 realesrgan-x4plus-anime 9MB 3.85 秒/帧
                             4 realesrgan-x4plus      33.5MB 15.145 秒/帧(超慢,稳居最后)
                             ⚠【换位 = 改序号,必须迁移】Rev2 的 wdn 在第 4 位(当时是"末尾追加"最安全),
                             这次它要挪到第 2 位 ⇒ 映射 2→3、3→4、4→2,0/1 不变。
                             迁移已抽到 AlhPro.Core.VideoModelOrder(纯函数 + 单测),VideoView.xaml.cs 的
                             MigrateEsrganModelOrder 调用它;读设置与读预设都走那条路。
                             不迁移的后果:老用户"存的 2 = x4plus-anime"会静默变成 2 = wdn-x4v3。
                             以后若再调顺序:必须 +1 Rev、加一段映射、同步改这里与 UpEsrganModelNames。 -->
                        <ComboBoxItem Content="动漫 · x4plus-anime（中）" Tag="realesrgan-x4plus-anime"
                                      ToolTipService.ToolTip="动漫 · x4plus-anime:官方动漫插画模型。&#x0a;适用:动漫插画 / 静态图;长视频建议用 animevideov3。&#x0a;速度 1080p 约 3.3~4.4 秒/帧 · 模型大小 9.0 MB。"/>
                        <!-- 「通用 · realesrgan-x4plus」按体积(33.5MB)与耗时(最慢)排在最后,并红字标出"超慢"
                             (用户要求:不删除、只警示)。
                              依据(2026-09-11 本机 4060 Laptop 实测,源 1920×1080 每帧):x4plus 14.48s / x4plus-anime 4.84s /
                              animevideov3 0.84s;x4plus 还有"只有 4x 权重"的问题(选 2x 也照样全量算 4x 再缩回)。
                              注:本项 Content 是 StackPanel(富文本),读模型名一律走 Tag —— 不要改成读 Content。 -->
                        <ComboBoxItem Tag="realesrgan-x4plus"
                                      ToolTipService.ToolTip="通用 · x4plus:官方通用模型。&#x0a;只有 4x 权重:选 2x / 3x 也按 4x 全量计算再缩回。&#x0a;速度 1080p 约 15.9 秒/帧 · 模型大小 33.5 MB。&#x0a;建议只用于单张图片。">
                            <!-- 「慢」直接在括号里改成红字「超慢」,不再另挂一个红字标记(用户:冗余了) -->
                            <StackPanel Orientation="Horizontal" Spacing="0">
                                <TextBlock Text="通用 · x4plus（" VerticalAlignment="Center"/>
                                <TextBlock Text="超慢" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#E5484D"/>
                                <TextBlock Text="）" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <!-- ===== 【Rev4 · 2026-09-15】末尾**追加**两支自训的 2x 模型(序号 5=现实向、6=游戏向)=====
                             为什么追加在最后而不是插到中间:追加不动老序号 ⇒ Rev4 的迁移是**恒等映射**,
                             老用户存的 0~4 升级后仍然指向同一支模型(Rev2 期间加 wdn 用的也是这个手法)。
                             【命名 · 用户 2026-09-15 定稿 · 第三次改英文名】文字要**跟已有各项同一个格式**
                             —— `类别 · 名字（括号内速度）`(已有项:`动漫 · animevideov3（快）` / `通用 · x4plus（超慢）`),
                             所以这两项写成 `现实 · alhreal2x（快）` / `游戏 · alhgame2x（快）`(2026-09-21 起名字前面加 `alh`);
                             类别用「游戏」/「现实」,**名字用英文**(= 权重文件名后缀 real2x / game2x 前面加 alh),
                             括号里写**速度档**(「快」,口径见 Core.ExperimentalEsrgan.SpeedTier)——【2026-09-16 用户定稿】"括号内要写快 而不是时间",**不许出现"实验"**。
                             权重文件:engines\realesrgan\models\alhpro-real2x.param/.bin、alhpro-game2x.param/.bin
                             ⚠ Tag 必须与文件名一字不差:引擎按 `models/{Tag}.param` 取权重(视频路径下发的是
                               `-m models -n {Tag}`,见 EngineService.UpscaleDirAsync;实测这两支名字不在引擎内置表里,
                               所以它**不会**被追加 -x{scale} 后缀)。
                             ⚠ 只有 2x 原生权重:3x/4x 目标由 Core.EngineScalePolicy 固定按 2x 跑再放大到目标
                               (实测给 2x 权重下发 -s 4 会输出**镜像平铺的错帧**、exit=0 不报错)。
                             ⚠ 【R/B 缺陷 · 2026-09-15 **已修好**,别把旧说法抄回来】这两份导出权重曾经 **R/B 通道颠倒**
                               (旧实测:源 R143/G110/B92、官方 R143/G111/B89、本模型 R94/G111/B137,画面整幅偏蓝)。
                               本轮**重训 + 重新导出**后通道验收闸已 PASS(现实向 Δ+0.20/+0.34/+0.24、
                               游戏向 Δ+0.11/+0.12/+0.18,判据「每通道差 小于 5」;多宽度 1920/2048/2348/2560 全过)
                               ⇒ 界面文案里**不得再出现"偏蓝 / R-B 颠倒 / 需重新导出 / 不可用于正片"**。
                               两处文案与 Core.ExperimentalEsrgan 里的**逐字相同**(有单测钉住),改时一起改。
                             ⚠ Content 是 StackPanel(富文本),读模型名一律走 Tag —— 别改成读 Content。 -->
