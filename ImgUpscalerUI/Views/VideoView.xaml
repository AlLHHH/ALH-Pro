<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="ALHPro.Views.VideoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource AppPanelBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="12" Margin="0,0,10,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="14,16" Spacing="14">

                    <TextBlock Text="输入" Style="{StaticResource SectionTitle}"/>
                    <Button x:Name="PickVideoBtn" Content="选择视频文件(可多选)..." Click="PickVideoBtn_Click"
                            HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="VideoInfo" Text="未选择视频"
                               Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="裁剪:在右侧选中视频后可设置开始/结束时间" Style="{StaticResource HintText}"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <TextBlock Text="视频超分" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="UpscaleToggle" Content="启用超分(逐帧放大)" ToolTipService.ToolTip="逐帧 AI 放大画面"
                              IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed"/>

                    <TextBlock Text="超分引擎" Style="{StaticResource SectionTitle}"/>
                    <RadioButtons x:Name="VideoEngineRadios" SelectedIndex="0" ToolTipService.ToolTip="超分引擎:waifu2x 最快(经典动漫)/ Real-ESRGAN 写实照片"
                                  SelectionChanged="Combo_Changed">
                        <RadioButton Content="waifu2x"/>
                        <RadioButton Content="Real-ESRGAN"/>
                    </RadioButtons>
                    <TextBlock x:Name="VideoModelLabel" Text="超分模型" Style="{StaticResource SectionTitle}"/>
                    <ComboBox x:Name="VideoWaifu2xModelCombo" ToolTipService.ToolTip="waifu2x 模型(动漫/通用/现实)"
                              SelectionChanged="Combo_Changed">
                        <ComboBoxItem Content="通用 · models-cunet（24MB · 中）" Tag="models-cunet"/>
                        <ComboBoxItem Content="动漫 · models-upconv_7_anime_style_art_rgb（5MB · 快）" Tag="models-upconv_7_anime_style_art_rgb"/>
                        <ComboBoxItem Content="现实 · models-upconv_7_photo（5MB · 快）" Tag="models-upconv_7_photo"/>
                    </ComboBox>
                    <ComboBox x:Name="VideoEsrganModelCombo" Visibility="Collapsed"
                              ToolTipService.ToolTip="Real-ESRGAN 模型(动漫/通用)"
                              SelectionChanged="Combo_Changed">
                        <ComboBoxItem Content="动漫 · realesr-animevideov3（4MB · 快）" Tag="realesr-animevideov3"/>
                        <ComboBoxItem Content="动漫 · realesrgan-x4plus-anime（9MB · 中）" Tag="realesrgan-x4plus-anime"/>
                        <ComboBoxItem Content="通用 · realesrgan-x4plus（41MB · 慢）" Tag="realesrgan-x4plus"/>
                    </ComboBox>

                    <TextBlock Text="放大倍数" Style="{StaticResource SectionTitle}"/>
                    <RadioButtons x:Name="VideoScaleRadios" SelectedIndex="1" ToolTipService.ToolTip="输出放大倍数(3x 内部按引擎支持倍数处理)"
                                  SelectionChanged="Combo_Changed">
                        <RadioButton x:Name="VScale1xRadio" Content="1x 超分（2x 放大后缩回）"/>
                        <RadioButton x:Name="VScale2xRadio" Content="2x"/>
                        <RadioButton x:Name="VScale3xRadio" Content="3x"/>
                        <RadioButton x:Name="VScale4xRadio" Content="4x"/>
                        <RadioButton Content="自定义分辨率"/>
                    </RadioButtons>
                    <TextBlock x:Name="ScaleHint" Text="1x~2x 速度较快;倍率越高越慢、显存占用越大"
                               Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                    <Grid x:Name="CustomSizePanel" ColumnSpacing="8" Visibility="Collapsed"
                          ToolTipService.ToolTip="自定义输出分辨率:超分后精确缩放到指定宽×高(留空=按倍率)">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="宽" VerticalAlignment="Center"/>
                        <TextBox x:Name="CustomWidthBox" Grid.Column="1" Text="1920"
                                 IsSpellCheckEnabled="False" TextChanged="Text_Changed"/>
                        <TextBlock Text="高" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox x:Name="CustomHeightBox" Grid.Column="3" Text="1080"
                                 IsSpellCheckEnabled="False" TextChanged="Text_Changed"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <TextBlock Text="视频降噪" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="DenoiseToggle" Content="启用视频降噪" ToolTipService.ToolTip="ffmpeg 非局部均值降噪(nlmeans):去视频噪点/闪烁/压缩噪点,比 AI 逐帧快很多"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>
                    <TextBlock x:Name="DenoiseStrongLabel" Text="降噪强度" Style="{StaticResource SectionTitle}"/>
                    <RadioButtons x:Name="DenoiseStrongRadios" SelectedIndex="0" ToolTipService.ToolTip="越强去噪越多,但可能抹掉细纹理"
                                  SelectionChanged="Combo_Changed">
                        <RadioButton Content="弱"/>
                        <RadioButton Content="中"/>
                        <RadioButton Content="强"/>
                    </RadioButtons>

                    <TextBlock Text="视频调整 (后处理)" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Spacing="2">
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="锐化:增强边缘对比,画面更利落(过大会出白边)">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="锐化" VerticalAlignment="Center"/>
                            <Slider x:Name="SharpenSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="SharpenVal" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="清晰:大范围局部对比度增强,画面更通透">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="清晰" VerticalAlignment="Center"/>
                            <Slider x:Name="ClaritySlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="ClarityVal" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="钝化蒙版:只锐化物体边缘、不锐化平坦区域,让轮廓更清晰(比「锐化」更柔和)">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="钝化蒙版" VerticalAlignment="Center"/>
                            <Slider x:Name="UsmSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="UsmVal" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="保留细节:自适应锐化,平坦区不动,噪点少">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="保留细节" VerticalAlignment="Center"/>
                            <Slider x:Name="DetailSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="DetailVal" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="去模糊:减轻轻微模糊/对焦不实(过大会发灰)">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="去模糊" VerticalAlignment="Center"/>
                            <Slider x:Name="DeblurSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="DeblurVal" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="去频闪:消除亮度忽明忽暗的闪烁(补帧/超分产生的,或视频本身自带的)">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="去频闪" VerticalAlignment="Center"/>
                            <Slider x:Name="FlickerSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="FlickerVal" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="去杂色:去除彩色噪点/颗粒(源视频压缩产生的),保细节不糊">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="去杂色" VerticalAlignment="Center"/>
                            <Slider x:Name="PostDenoiseSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="PostDenoiseVal" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="边缘抗锯齿:磨平超分/放大后边缘的锯齿阶梯,细节不糊">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="边缘抗锯齿" VerticalAlignment="Center"/>
                            <Slider x:Name="PostAaSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="PostAaVal" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Button x:Name="PostResetBtn" Content="重置调整" HorizontalAlignment="Right"
                                FontSize="12" Padding="12,4" Click="PostResetBtn_Click"
                                ToolTipService.ToolTip="把所有后处理参数清零"/>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <TextBlock Text="补帧 (RIFE)" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="InterpToggle" Content="启用补帧(生成中间帧)" ToolTipService.ToolTip="补帧:在原帧之间脑补出中间帧,让动作更流畅(动画/电影感)"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>

                    <TextBlock Text="补帧模型" Style="{StaticResource SectionTitle}"/>
                    <ComboBox x:Name="InterpModelCombo" HorizontalAlignment="Stretch" ToolTipService.ToolTip="补帧模型:通用画质最新 v4.13(推荐,最新引擎) / 通用画质 v4.6 / 动漫专用 / 高清 / 超高清 / 经典兼容"
                              SelectedIndex="0" SelectionChanged="Combo_Changed">
                        <ComboBoxItem Content="通用画质最新 (RIFE v4.13)"/>
                        <ComboBoxItem Content="通用画质 (RIFE v4.6)"/>
                        <ComboBoxItem Content="通用画质再新 (RIFE v4.26)"/>
                        <ComboBoxItem Content="动漫专用 (RIFE Anime)"/>
                        <ComboBoxItem Content="高清 (RIFE HD)"/>
                        <ComboBoxItem Content="超高清 (RIFE UHD)"/>
                        <ComboBoxItem Content="经典兼容 (RIFE v2.3)"/>
                    </ComboBox>

                    <Button x:Name="FpsToggleBtn" Content="视频帧率 ▾" HorizontalAlignment="Stretch"
                            Click="FpsToggleBtn_Click"
                            ToolTipService.ToolTip="输入帧率设置:各视频默认帧率 / 帧率偏移 / 单独调整各视频帧率。
默认「各视频默认帧率」=每个视频按自身原始帧率处理,无需任何设置。"/>
                    <StackPanel x:Name="FpsPanel" Spacing="8" Margin="0,8,0,4" Visibility="Collapsed">
                        <RadioButtons x:Name="FpsModeRadios" SelectedIndex="0"
                                      SelectionChanged="Combo_Changed">
                            <RadioButton Content="各视频默认帧率(原帧率)"/>
                            <RadioButton Content="帧率偏移(统一减帧率)"/>
                            <RadioButton Content="单独调整各视频帧率"/>
                        </RadioButtons>

                        <!-- 模式 0:默认帧率(无额外控件) -->
                        <TextBlock x:Name="FpsDefaultHint"
                                   Text="各视频按自身原始帧率处理(自动探测),无需任何设置。"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap"/>

                        <!-- 模式 1:帧率偏移(滑条) -->
                        <Grid x:Name="FpsOffsetPanel" ColumnSpacing="8" Visibility="Collapsed"
                              ToolTipService.ToolTip="多视频统一帧率偏移:0=各视频用自己原帧率;-1~-20=原帧率减 N">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="帧率偏移" VerticalAlignment="Center"/>
                            <Slider x:Name="FpsOffsetSlider" Grid.Column="1" Minimum="-20" Maximum="0"
                                    StepFrequency="1" Value="0" ValueChanged="Slider_Changed"/>
                            <Button Grid.Column="2" Content="重置" FontSize="10" Padding="10,4"
                                    Click="ResetOffsetBtn_Click"
                                    ToolTipService.ToolTip="帧率偏移恢复为 0(各视频用原帧率)"/>
                        </Grid>
                        <TextBlock x:Name="FpsOffsetVal" FontSize="11" Opacity="0.6"
                                   Visibility="Collapsed" TextWrapping="Wrap"
                                   ToolTipService.ToolTip="多视频统一帧率偏移:0=各视频用自己原帧率;-1~-20=原帧率减 N"/>

                        <!-- 模式 2:单独调整(单视频=输入框;多视频=逐个调整 + 批量统一) -->
                        <Grid x:Name="FpsSingleRow" ColumnSpacing="8" Visibility="Collapsed"
                              ToolTipService.ToolTip="该视频的输入帧率(自动探测,可手动修改)">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="输入帧率" VerticalAlignment="Center"/>
                            <TextBox x:Name="InputFpsBox" Grid.Column="1" Text="30"
                                     IsSpellCheckEnabled="False" TextChanged="Text_Changed"/>
                        </Grid>
                        <Button x:Name="FpsIndividualBtn" Content="单独调整各视频帧率" Visibility="Collapsed"
                                HorizontalAlignment="Stretch" Click="FpsIndividualBtn_Click"
                                ToolTipService.ToolTip="在右侧每个视频上显示帧率输入框,逐个单独设置(设置后偏移滑条失效)"/>
                        <Button x:Name="SaveFpsBtn" Content="保存帧率设置" Visibility="Collapsed"
                                HorizontalAlignment="Stretch" Click="SaveFpsBtn_Click"
                                ToolTipService.ToolTip="把右侧各视频输入的帧率正式应用到对应视频(生效后列表显示 帧率 x)"/>
                        <Grid x:Name="AllFpsRow" ColumnSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="批量统一帧率" VerticalAlignment="Center" FontSize="12"
                                       ToolTipService.ToolTip="把右侧所有视频的输入帧率统一设为同一个值:输入数值点「应用」= 所有视频都变成该帧率并锁定(之后想个别改,点该项右侧的「恢复」再改再保存)"/>
                            <TextBox x:Name="AllFpsBox" Grid.Column="1" Text="30" HorizontalAlignment="Stretch"
                                     IsSpellCheckEnabled="False" TextChanged="Text_Changed"
                                     ToolTipService.ToolTip="要统一设置的输入帧率(正数,如 24/30/60)"/>
                            <Button Grid.Column="2" Content="应用" FontSize="11" Padding="10,4"
                                    Click="AllFpsApplyBtn_Click"
                                    ToolTipService.ToolTip="把统一帧率应用到所有视频(覆盖右侧单独设置并锁定)"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="输出倍率" Style="{StaticResource SectionTitle}"/>
                    <RadioButtons x:Name="InterpScaleRadios" SelectedIndex="0" ToolTipService.ToolTip="补帧倍率:2x/3x/4x/8x/12x/16x(3x/12x/16x 需「通用画质」系列模型,其余模型按 2x 级联;高倍率耗时显著增加,且多数播放器不支持 >120fps 输出)"
                                  SelectionChanged="Combo_Changed">
                        <RadioButton Content="2x"/>
                        <RadioButton x:Name="Scale3xRadio" Content="3x"/>
                        <RadioButton Content="4x"/>
                        <RadioButton Content="8x"/>
                        <RadioButton x:Name="Scale12xRadio" Content="12x"/>
                        <RadioButton x:Name="Scale16xRadio" Content="16x"/>
                    </RadioButtons>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="TargetFpsCheck" Content="指定输出帧率" ToolTipService.ToolTip="直接指定最终输出帧率,软件自动算够补帧倍率(如填 60,内容 12fps 会自动 5x 补到 60)"
                                  VerticalAlignment="Center"
                                  Checked="Options_Changed" Unchecked="Options_Changed"/>
                        <TextBox x:Name="TargetFpsBox" Grid.Column="1"
                                 PlaceholderText="如 60" IsEnabled="False"
                                 IsSpellCheckEnabled="False" TextChanged="Text_Changed"/>
                        <TextBlock x:Name="ScreenFpsHint" Grid.Column="2" FontSize="10" Opacity="0.6"
                                   VerticalAlignment="Center" Text=""/>
                    </Grid>

                    <!-- 可变帧率(VFR)保护:默认自动检测(加入列表时后台探测),是 VFR 素材就自动按原节奏
                         拆帧+按原始时间轴输出(防时快时慢);普通素材无影响,用户无须手动开启 -->
                    <Button x:Name="VfrToggleBtn" Content="可变帧率保护 ▾" HorizontalAlignment="Stretch"
                            Click="VfrToggleBtn_Click"
                            ToolTipService.ToolTip="默认「自动」:加入列表时自动检测,帧间隔不均匀的素材(录屏/手机/监控)
按原始节奏逐帧提取并按时序输出,不会时快时慢;普通视频不受影响。亦可手动指定「不启用」。"/>
                    <StackPanel x:Name="VfrPanel" Spacing="8" Margin="0,8,0,4" Visibility="Collapsed">
                        <RadioButtons x:Name="VfrModeRadios" SelectedIndex="0"
                                      SelectionChanged="Combo_Changed">
                            <RadioButton Content="自动(检测到可变帧率素材时启用,推荐)"/>
                            <RadioButton Content="不启用(全部按常规方式处理)"/>
                        </RadioButtons>
                        <TextBlock x:Name="VfrHintText" Text="可变帧率(VFR)视频的帧间隔不均匀,常见于录屏、手机拍摄与监控画面。若按固定帧率拆帧,帧间隔不均匀处的时间轴会被压缩或拉伸,导致播放时快时慢。
默认「自动」:加入列表时后台检测,是 VFR 素材就自动按其原始时间节奏逐帧提取、按原始时间轴输出,全程无需手动操作。"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Text="去重复帧" Style="{StaticResource SectionTitle}"/>

                    <CheckBox x:Name="DedupCheck" Content="启用去重(静态/低变化画面)" ToolTipService.ToolTip="去除重复/静止帧,动漫必备,去重后自动得出内容帧率;可单独使用,不勾补帧也能只去重导出。算法:智能=自动识别素材拍数(一拍N)均匀采样;动漫=按动画拍型(一拍二/三/四)均匀采样;手动=自己选算法调参(含内容帧率采样)"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>
                    <TextBlock Text="去重模型" Style="{StaticResource SectionTitle}"/>
                    <ComboBox x:Name="DedupModelCombo" HorizontalAlignment="Stretch" ToolTipService.ToolTip="去重模型:智能=自动识别素材拍数(一拍N)并均匀采样;动漫=按动画拍型(一拍二/三/四)均匀采样;手动=自己选算法(含内容帧率采样)自由调参"
                              SelectedIndex="2" SelectionChanged="Combo_Changed">
                        <ComboBoxItem Content="智能检测" ToolTipService.ToolTip="自动识别素材拍数(一拍N:画面每 N 帧才算一个新动作),识别到就按拍数均匀采样去重;识别不出来的素材(如实拍连续运动)原样保留。三档策略控制采用门槛"/>
                        <ComboBoxItem Content="动漫模式" ToolTipService.ToolTip="动画帧率变种(一拍N):动漫是「一拍一/二/三…」的有限动画——每 N 帧才有一帧真内容。选对档位后软件按内容帧率均匀采样+均匀补帧(不做逐帧判定,不会误删细节帧),输出标准帧率。24fps 源:一拍二=12fps 内容、一拍三=8fps"/>
                        <ComboBoxItem Content="手动模式" ToolTipService.ToolTip="自己选算法 + 自由调参:重复帧检测(mpdecimate)/ 画面变化阈值(scene)/ 帧差+SSIM/ 内容帧率采样,下方面板展开所有滑条"/>
                    </ComboBox>
                    <!-- 智能模式策略(仅智能模式显示):均衡=自动适配 激进=删得多 保守=几乎不误删 -->
                    <Grid x:Name="DedupSmartRow" ColumnSpacing="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="智能策略" VerticalAlignment="Center" FontSize="12"
                                   ToolTipService.ToolTip="智能模式自动识别素材拍数(一拍N),三档 = 识别结果的采用门槛:均衡(推荐)= 一般确定就采用(识别不靠谱就原样保留);激进= 不太确定也采用(适合确定有重复帧的素材);保守= 只有拍数很整齐、且是常见拍数(8/10/12/15/20/24/30fps)才采用"/>
                        <ComboBox x:Name="DedupSmartCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                  SelectedIndex="0" SelectionChanged="Combo_Changed">
                            <ComboBoxItem Content="均衡"/>
                            <ComboBoxItem Content="激进"/>
                            <ComboBoxItem Content="保守"/>
                        </ComboBox>
                    </Grid>
                    <!-- 动漫模式:动画帧率变种(一拍N)。选对 N → 内容帧率=输入帧率÷N → 均匀采样+均匀补帧 -->
                    <Grid x:Name="DedupAnimeRow" ColumnSpacing="8" RowSpacing="2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="动画去重档位" VerticalAlignment="Center" FontSize="12"
                                   ToolTipService.ToolTip="按动画拍型删保持帧(一拍二=每格画面放 2 帧)。去除一拍二=按拍二节奏删保持帧;去除一拍二与一拍三=拍二/拍三(或混合)都能识别删除。只删「确认为重复作画」的帧,口型/眨眼/微动永不删;全动画素材(无重复)自动原样保留——所以不需要「全动画」档,不用去重时直接关掉「启用去重」即可"/>
                        <ComboBox x:Name="DedupAnimeCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                  SelectedIndex="0" SelectionChanged="Combo_Changed">
                            <ComboBoxItem Content="去除一拍二"/>
                            <ComboBoxItem Content="去除一拍三"/>
                            <ComboBoxItem Content="去除一拍二与一拍三"/>
                            <ComboBoxItem Content="半拍二"/>
                            <ComboBoxItem Content="去除一拍四"/>
                        </ComboBox>
                        <!-- 当前档位对应的内容帧率(按输入帧率实时换算显示);单独一行,不与下拉框重叠 -->
                        <TextBlock x:Name="AnimeFpsHint" Grid.Row="1" Grid.Column="1" FontSize="10" Opacity="0.6"
                                   TextWrapping="Wrap" Text="" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- 相位自动对齐(动漫-网格采样):素材保持帧起点带相位偏移时自动对齐,高置信才移相 -->
                    <CheckBox x:Name="DedupPhaseAlignAnimeCheck" Content="相位自动对齐(网格模式)" IsChecked="True"
                              Visibility="Collapsed"
                              Click="PhaseAlign_Click"
                              ToolTipService.ToolTip="只对网格采样(动漫拍N)生效:自动估计素材保持帧的相位偏移,网格从真实保持帧起算,避免素材相位偏移时抽到中间帧。高置信(事件节奏与档位吻合、相位集中≥60%)才启用;拿不准时保持原样从段首起算"/>
                    <StackPanel x:Name="DedupManualPanel" Spacing="6" Visibility="Collapsed">
                        <!-- 算法选择 -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="算法" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox x:Name="DedupAlgoCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0"
                                      ToolTipService.ToolTip="算法:内容帧率采样=不做逐帧判定,按你填的「内容帧率」时间网格均匀采样再均匀补帧(拍N类素材首选,无误删细节帧风险;与动漫模式同构,间隔任意可填);帧差+SSIM=帧差快筛+结构相似度精确验证(最严谨);重复帧检测=mpdecimate(经典帧差法,动漫常用);画面变化阈值=scene(简单直接)"
                                      SelectionChanged="Combo_Changed">
                                <ComboBoxItem Content="内容帧率采样(默认)"/>
                                <ComboBoxItem Content="帧差+SSIM 精确去重"/>
                                <ComboBoxItem Content="重复帧检测"/>
                                <ComboBoxItem Content="画面变化阈值"/>
                            </ComboBox>
                        </Grid>
                        <!-- 内容帧率采样(手动算法第 4 项):填内容帧率 + 快捷换算(随算法选中显示) -->
                        <Grid x:Name="ContentFpsRow" ColumnSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="内容帧率" VerticalAlignment="Center" FontSize="12"
                                       ToolTipService.ToolTip="素材的真实内容帧率(手动填写):动漫「一拍二」=12fps、「一拍三」=8fps(24fps 源)。处理时按这个帧率从原视频均匀采样内容帧,再均匀补帧输出。留空=无法处理,请先填写"/>
                            <TextBox x:Name="ContentFpsBox" Grid.Column="1" HorizontalAlignment="Stretch"
                                     PlaceholderText="手动填写,如 12" InputScope="Number" FontSize="12"
                                     ToolTipService.ToolTip="填素材内容帧率(如 12/8/24)。动漫常见帧率:24fps 源一拍二=12、一拍三=8;60fps 源一拍二=30"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="保存" FontSize="11" Padding="10,3"
                                        Click="ContentFpsSaveBtn_Click"
                                        ToolTipService.ToolTip="立即保存内容帧率到设置(输入时也会自动保存;此按钮=立即确认)"/>
                                <TextBlock x:Name="ContentFpsHint" FontSize="10" Opacity="0.6" VerticalAlignment="Center" Text=""/>
                            </StackPanel>
                        </Grid>
                        <!-- 相位自动对齐(手动-内容帧率采样):素材保持帧起点带相位偏移时自动对齐,高置信才移相 -->
                        <CheckBox x:Name="DedupPhaseAlignManualCheck" Content="相位自动对齐(网格模式)" IsChecked="True"
                                  Visibility="Collapsed"
                                  Click="PhaseAlign_Click"
                                  ToolTipService.ToolTip="只对网格采样(手动-内容帧率)生效:自动估计素材保持帧的相位偏移,网格从真实保持帧起算,避免素材相位偏移时抽到中间帧。高置信(事件节奏与档位吻合、相位集中≥60%)才启用;拿不准时保持原样从段首起算"/>
                        <!-- 重复帧检测参数:变化判线 -->
                        <Grid x:Name="DedupHiRow" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="变化判线" VerticalAlignment="Center" FontSize="12"
                                       ToolTipService.ToolTip="一块画面变化超过这个数,才认为这块真的动了。调大=更宽松,删得更多;动漫一般 8~16,默认 12"/>
                            <Slider x:Name="DedupHiSlider" ToolTipService.ToolTip="一块画面变化超过这个数才算真的动了。调大=更宽松,删得更多;动漫一般 8~16,默认 12" Grid.Column="1" Minimum="4" Maximum="24"
                                    StepFrequency="1" Value="12" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="DedupHiVal" Grid.Column="2" Text="12" MinWidth="32"
                                       HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="重置" Tag="hi" FontSize="10" Padding="10,4" Click="ResetDedupBtn_Click"/>
                        </Grid>
                        <!-- 重复帧检测参数:相似判线 -->
                        <Grid x:Name="DedupLoRow" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="相似判线" VerticalAlignment="Center" FontSize="12"
                                       ToolTipService.ToolTip="一块画面变化低于这个数,就算这块没变。调大=更容易算没变,删得更多;动漫一般 4~6,默认 5"/>
                            <Slider x:Name="DedupLoSlider" ToolTipService.ToolTip="一块画面变化低于这个数就算没变。调大=更容易算没变,删得更多;动漫一般 4~6,默认 5" Grid.Column="1" Minimum="2" Maximum="10"
                                    StepFrequency="1" Value="5" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="DedupLoVal" Grid.Column="2" Text="5" MinWidth="32"
                                       HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="重置" Tag="lo" FontSize="10" Padding="10,4" Click="ResetDedupBtn_Click"/>
                        </Grid>
                        <!-- 重复帧检测参数:重复比例 -->
                        <Grid x:Name="DedupFracRow" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="重复比例" VerticalAlignment="Center" FontSize="12"
                                       ToolTipService.ToolTip="画面里至少多少比例的区域没变,才把这帧当重复帧删掉。调小=删得更多;动漫一般 0.3~0.4,默认 0.33"/>
                            <Slider x:Name="DedupFracSlider" ToolTipService.ToolTip="画面里至少多少比例的区域没变,才把这帧当重复帧删掉。调小=删得更多;动漫一般 0.3~0.4,默认 0.33" Grid.Column="1" Minimum="0.1" Maximum="0.6"
                                    StepFrequency="0.01" Value="0.33" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="DedupFracVal" Grid.Column="2" Text="0.33" MinWidth="40"
                                       HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="重置" Tag="frac" FontSize="10" Padding="10,4" Click="ResetDedupBtn_Click"/>
                        </Grid>
                        <!-- 画面变化阈值参数 -->
                        <Grid x:Name="DedupSceneRow" ColumnSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="变化阈值" VerticalAlignment="Center" FontSize="12"
                                       ToolTipService.ToolTip="两帧画面整体差异超过多少,才当新画面保留。调小=保留越多,删得越少;常见 0.02 左右"/>
                            <Slider x:Name="DedupSceneSlider" ToolTipService.ToolTip="两帧画面整体差异超过多少才当新画面保留。调小=保留越多,删得越少;常见 0.02 左右" Grid.Column="1" Minimum="0.001" Maximum="0.5"
                                    StepFrequency="0.001" Value="0.01" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="DedupSceneVal" Grid.Column="2" Text="0.010" MinWidth="40"
                                       HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="重置" Tag="scene" FontSize="10" Padding="10,4" Click="ResetDedupBtn_Click"/>
                        </Grid>
                        <!-- 帧差+SSIM:差异快筛 -->
                        <Grid x:Name="DedupSadRow" ColumnSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="差异快筛" VerticalAlignment="Center" FontSize="12"
                                       ToolTipService.ToolTip="算法「帧差法(SAD)」:两帧画面平均差异低于多少,才进入下一步 SSIM 精确验证。调大=更多帧进入验证=删得更多;建议 2~5"/>
                            <Slider x:Name="DedupSadSlider" ToolTipService.ToolTip="两帧画面平均差异低于多少,才进入下一步精确验证。调大=更多帧进入验证=删得更多;建议 2~5" Grid.Column="1" Minimum="0.5" Maximum="10"
                                    StepFrequency="0.5" Value="3.0" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="DedupSadVal" Grid.Column="2" Text="3.0" MinWidth="36"
                                       HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="重置" Tag="sad" FontSize="10" Padding="10,4" Click="ResetDedupBtn_Click"/>
                        </Grid>
                        <!-- 帧差+SSIM:相似度阈值 -->
                        <Grid x:Name="DedupSsimRow" ColumnSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="相似度阈值" VerticalAlignment="Center" FontSize="12"
                                       ToolTipService.ToolTip="算法「SSIM(结构相似性)」:从亮度/对比度/结构三维衡量画面相似度,超过多少才算真重复帧。调高=更严格=删得少;调低=删得多;建议 0.95~0.99"/>
                            <Slider x:Name="DedupSsimSlider" ToolTipService.ToolTip="画面结构相似度(SSIM)超过多少才算真重复帧。调高=更严格=删得少;调低=删得多;建议 0.95~0.99" Grid.Column="1" Minimum="0.90" Maximum="0.999"
                                    StepFrequency="0.005" Value="0.97" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="DedupSsimVal" Grid.Column="2" Text="0.970" MinWidth="44"
                                       HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="重置" Tag="ssim" FontSize="10" Padding="10,4" Click="ResetDedupBtn_Click"/>
                        </Grid>
                        <!-- 帧差+SSIM:微动防线(局部动作保护:口型/眨眼/手指) -->
                        <CheckBox x:Name="ManualProtectSmallMotionCheck" Content="微动防线(防口型/眨眼误删)" Margin="0,2,0,0"
                                  IsChecked="True" FontSize="12"
                                  ToolTipService.ToolTip="帧差+SSIM 算法专用(默认开):检测到局部小动作(张嘴/眨眼/手指抖动)时判定为真变化并保留,整幅差异小也不误删。取消勾选=只看整幅差异,删得更狠,但口型/微动帧可能被误删"/>
                    </StackPanel>
                    <!-- 转场识别(转场处不插帧)→ 用上面 SceneCheck/Slider -->
                    <TextBlock x:Name="DedupHint" Style="{StaticResource HintText}" TextWrapping="Wrap"
                               Text="去重=删重复/静止帧(按节奏治理,非逐帧二分类)。智能=自动:按节奏网格+变化帧保护处理,估不准的回退保守;动漫=选档:拍一/拍二/拍三/混合,内部固定逻辑(按档网格+变化帧保护,口型/微动不删);手动=自由调参:重复帧检测/画面变化阈值/帧差+SSIM/内容帧率采样(自填值)。&#10;「转场识别」=转场处保持不插帧(检测到切换处不插帧避免鬼影)。"/>

                    <CheckBox x:Name="SceneCheck" Content="转场识别(转场处不插帧)" ToolTipService.ToolTip="检测场景切换,转场处不插帧避免鬼影"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="转场阈值" VerticalAlignment="Center" FontSize="12"
                                   ToolTipService.ToolTip="转场阈值:越低越敏感(容易识别到更多切换),越高只认明显切换(默认 0.30)。转场识别=勾选后检测到切换处不插帧,避免补帧跨转场产生鬼影/果冻"/>
                        <Slider x:Name="SceneSlider" ToolTipService.ToolTip="转场阈值:越低越敏感,越高只认明显切换" Grid.Column="1" Minimum="0" Maximum="1"
                                StepFrequency="0.05" ValueChanged="Slider_Changed"/>
                        <TextBlock x:Name="SceneVal" Grid.Column="2" Text="0.30" MinWidth="36"
                                   HorizontalTextAlignment="Center" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="当前转场阈值:检测到的场景切换评分需超过它才视为转场"/>
                        <Button Grid.Column="3" Content="重置" FontSize="10" Padding="10,4"
                                Click="ResetSceneBtn_Click"
                                ToolTipService.ToolTip="转场阈值恢复默认 0.30"/>
                    </Grid>

                    <TextBlock Text="果冻修复" Style="{StaticResource SectionTitle}"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="运动模糊（果冻部分）" VerticalAlignment="Center" FontSize="12"
                                   ToolTipService.ToolTip="给补帧产生的「果冻」(快速运动处的画面扭曲)加上真实的运动模糊,把它盖掉、让运动更自然。只在果冻强的地方生效,静止画面不受影响;弱/中/强 = 效果越强、越慢"/>
                        <ComboBox x:Name="MotionBlurCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                  SelectedIndex="0" SelectionChanged="Combo_Changed">
                            <ComboBoxItem Content="关"/>
                            <ComboBoxItem Content="弱"/>
                            <ComboBoxItem Content="中"/>
                            <ComboBoxItem Content="强"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="DeShakeCheck" Content="画面去抖" ToolTipService.ToolTip="画面去抖:轻量稳定画面,减少手持拍摄的晃动"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>
                    <TextBlock x:Name="JellySlowHint" Visibility="Collapsed"
                               Text="⚠ 果冻修复为 CPU 逐帧滤镜,会明显增加导出时间(运动模糊最慢,画面去抖较轻)。视觉要求不高时建议关闭。"
                               Foreground="#E8A33D" FontSize="11" TextWrapping="Wrap"/>

                    <Button x:Name="AdvancedToggleBtn" Content="高级参数 ▾" HorizontalAlignment="Stretch"
                            Click="AdvancedToggleBtn_Click"
                            ToolTipService.ToolTip="进阶参数,一般不用动"/>
                    <StackPanel x:Name="AdvancedPanel" Spacing="10" Margin="0,8,0,4" Visibility="Collapsed">
                            <TextBlock Text="光流调整" Style="{StaticResource SectionTitle}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="时间步" VerticalAlignment="Center" FontSize="12"/>
                                <Slider x:Name="TimeStepSlider" ToolTipService.ToolTip="时间步:0.5=中间帧居中;调大更偏向下一帧,可缓解果冻(仅「通用画质」模型生效)" Grid.Column="1" Minimum="0.05" Maximum="0.95"
                                        StepFrequency="0.05" ValueChanged="Slider_Changed"/>
                                <TextBlock x:Name="TimeStepVal" Grid.Column="2" Text="0.50" MinWidth="36"
                                           HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Content="重置" FontSize="10" Padding="10,4"
                                        Click="ResetTimeStepBtn_Click"
                                        ToolTipService.ToolTip="时间步恢复默认 0.5"/>
                            </Grid>
                            <CheckBox x:Name="TtaCheck" Content="开启高质量(减少运动伪影,更清晰)" ToolTipService.ToolTip="高质量(TTA):反复推演减少补帧的跳步/扭曲伪影。⚠ 开启后会严重增加导出时间(约慢 5~7 倍)。默认关闭(追求速度);画质优先可手动开启"
                                      Checked="Options_Changed" Unchecked="Options_Changed"/>
                            <TextBlock Text="⚠ 开启后会严重增加导出时间" Style="{StaticResource HintText}" TextWrapping="Wrap"/>

                            <!-- 补帧输出帧率基准:放「高级参数」里,并提供黄色提示(不改默认推荐就是安全的) -->
                            <TextBlock Text="补帧输出帧率基准" Style="{StaticResource SectionTitle}"/>
                            <ComboBox x:Name="FpsBaseCombo" HorizontalAlignment="Stretch"
                                      SelectedIndex="0" SelectionChanged="Combo_Changed">
                                <ComboBoxItem Content="真实时间轴插值 (推荐)"
                                              ToolTipService.ToolTip="最忠实:每个画面该出现的位置、停顿时间都跟原片完全对齐,再用 AI 补出缺失的中间帧,看起来就是原片直接变流畅了。&#10;&#10;【可能问题】① 对长时间真正静止的背景,可能被当成「缓慢移动」处理,那段会像缓慢蠕动;② 依赖去重能把每段实际停留时长认对,极度抖动/杂乱素材会判断不准。"/>
                                <ComboBoxItem Content="匀速帧速率插值"
                                              ToolTipService.ToolTip="所有动作按相同速度均匀补帧,视觉最顺滑、速度最快(通常单次插值完成)。&#10;&#10;【可能问题】① 不保留定格节奏,动画「同一张画停几帧」的感觉会消失;② 画面出现的时间点跟原片不完全一致,若要逐帧对接原片可能对不上。"/>
                            </ComboBox>
                            <TextBlock Text="⚠ 默认推荐「真实时间轴插值」。在您不了解另一个(匀速)模式的情况下,不建议使用,以免输出节奏与原片不一致。"
                                       Foreground="#E8A33D" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>

                    <TextBlock x:Name="InterpHint" Style="{StaticResource HintText}"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="输出" Style="{StaticResource SectionTitle}"/>
                    <TextBox x:Name="OutFileBox" PlaceholderText="默认与源视频同目录"
                             IsSpellCheckEnabled="False" TextChanged="OutFileBox_TextChanged"/>
                    <Button Content="选择输出位置..." Click="BrowseOut_Click"
                            HorizontalAlignment="Stretch"/>

                    <TextBlock Text="码率 / 格式" Style="{StaticResource SectionTitle}"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="码率" VerticalAlignment="Center" FontSize="12"
                                   ToolTipService.ToolTip="输出画质:自动=均衡;低=文件小画质一般;极高=文件大画质好;自定义=按你填的码率"/>
                        <ComboBox x:Name="QualityCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                  SelectionChanged="QualityCombo_Changed">
                            <ComboBoxItem Content="自动 (推荐)"/>
                            <ComboBoxItem Content="低 (文件小)"/>
                            <ComboBoxItem Content="中"/>
                            <ComboBoxItem Content="高"/>
                            <ComboBoxItem Content="极高 (文件大)"/>
                            <ComboBoxItem Content="自定义码率..."/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="重置" FontSize="10" Padding="10,4"
                                Click="QualityReset_Click"
                                ToolTipService.ToolTip="码率恢复为自动"/>
                    </Grid>
                    <Grid x:Name="BitrateRow" ColumnSpacing="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="码率(Mbps)" VerticalAlignment="Center" FontSize="12"
                                   ToolTipService.ToolTip="自定义目标码率,如 8 = 8Mbps(1080p 常见清晰码率);越高文件越大越清晰"/>
                        <TextBox x:Name="BitrateBox" Grid.Column="1" PlaceholderText="例如 8"
                                 IsSpellCheckEnabled="False" InputScope="Number"
                                 TextChanged="BitrateBox_TextChanged"/>
                        <TextBlock Grid.Column="2" Text="Mbps" VerticalAlignment="Center" FontSize="12"/>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="格式" VerticalAlignment="Center" FontSize="12"
                                   ToolTipService.ToolTip="输出封装格式:MP4 通用性最好;MKV 兼容性略低但无损封装"/>
                        <ComboBox x:Name="FormatCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                  SelectionChanged="Combo_Changed">
                            <ComboBoxItem Content="MP4 (通用)"/>
                            <ComboBoxItem Content="MKV"/>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="编码格式" VerticalAlignment="Center" FontSize="12"
                                   ToolTipService.ToolTip="H.264=最通用,所有设备都能播;H.265=同画质文件小一半,但很老的设备/播放器可能不支持"/>
                        <ComboBox x:Name="CodecCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                  SelectionChanged="Combo_Changed">
                            <ComboBoxItem Content="H.264 (通用)"/>
                            <ComboBoxItem Content="H.265 (文件小)"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="MuteCheck" Content="静音(输出不含音频)"
                              ToolTipService.ToolTip="勾选后导出视频不带音轨(只保留画面);几帧小片段/不需要声音时用"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>
                    <CheckBox x:Name="FastModeCheck" Content="兼容模式（适合配置较低的设备）" ToolTipService.ToolTip="勾选后自动降低显存占用、防止爆显存/卡死,画质与功能基本不受影响;配置好的设备可不开"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>
                    <TextBlock x:Name="FastModeHint" Style="{StaticResource HintText}" TextWrapping="Wrap"
                               Text="给配置较低/没独显的电脑用的:自动降低显存占用、防止爆显存,画质和功能基本不受影响"/>

                    <!-- 参数预设:整套超分/后处理/补帧/去重参数快照,一键保存/应用 -->
                    <TextBlock Text="参数预设" Style="{StaticResource SectionTitle}"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="使用预设" Click="OpenPresetWindowBtn_Click"
                                HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="打开预设列表:点选应用、删除、排序"/>
                        <Button Grid.Column="1" Content="保存预设" Click="SavePresetBtn_Click"
                                HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="把当前全部视频参数保存为一个预设(上限 100 个)"/>
                    </Grid>

                    <!-- 重置参数 / 记住上次:与参数预设放一起(参数管理) -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="VideoResetBtn" Grid.Column="0" Content="重置所有参数" ToolTipService.ToolTip="恢复全部默认参数(超分/补帧/去重/后处理/输出/编码等)"
                                HorizontalAlignment="Stretch" Click="VideoResetBtn_Click"/>
                        <CheckBox x:Name="VideoRememberCheck" Grid.Column="1" Content="记住上次" IsChecked="True" ToolTipService.ToolTip="记住处理参数(不含输入帧率),下次启动自动恢复"
                                  VerticalAlignment="Center"
                                  Checked="Remember_Changed" Unchecked="Remember_Changed"/>
                    </Grid>

                    <!-- 操作按钮:上一排「开始处理」(占满变宽),中间「暂停/恢复」,最下方「停止」 -->
                    <StackPanel Spacing="8">
                        <Button x:Name="RunBtn" Content="开始处理"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" MinHeight="48"
                                IsEnabled="False" Click="RunBtn_Click"/>
                        <TextBlock x:Name="RunHint" Text="⚠ 至少启用一项处理(超分或补帧)"
                                   Foreground="#E8A33D" FontSize="11" TextWrapping="Wrap"
                                   TextAlignment="Center" Visibility="Collapsed"/>
                        <!-- 耗时提示(黄色):启用耗时功能时提示处理时间会增加 -->
                        <TextBlock x:Name="SpeedHint" Text=""
                                   Foreground="#E8A33D" FontSize="11" TextWrapping="Wrap"
                                   TextAlignment="Center" Visibility="Collapsed"/>
                        <!-- 弱设备提示(黄色)+ 一键开启兼容模式 -->
                        <StackPanel x:Name="CompatHintPanel" Orientation="Vertical" Visibility="Collapsed" Spacing="4">
                            <TextBlock x:Name="CompatHint" Foreground="#E8A33D" FontSize="11" TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                            <Button x:Name="EnableCompatBtn" Content="帮我开启兼容模式" FontSize="11" Padding="8,3"
                                    HorizontalAlignment="Center" Click="EnableCompatBtn_Click"/>
                        </StackPanel>
                        <CheckBox x:Name="SelectedOnlyCheck" Content="只处理选中的项目"
                                  ToolTipService.ToolTip="勾选后只处理右侧列表里选中的项;不勾选则处理全部"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PauseBtn" Grid.Column="0" Content="暂停"
                                    HorizontalAlignment="Stretch" MinHeight="44"
                                    IsEnabled="False" Click="PauseBtn_Click"
                                    ToolTipService.ToolTip="暂停:处理完当前这个视频后停下,可删除还没处理的项目"/>
                            <Button x:Name="ResumeBtn" Grid.Column="1" Content="恢复"
                                    HorizontalAlignment="Stretch" MinHeight="44"
                                    IsEnabled="False" Click="ResumeBtn_Click"
                                    ToolTipService.ToolTip="恢复:立即继续处理"/>
                        </Grid>
                        <Button x:Name="CancelBtn" Content="强制结束"
                                HorizontalAlignment="Stretch" MinHeight="44" Background="#E5484D" Foreground="White"
                                IsEnabled="False" Click="CancelBtn_Click"
                                ToolTipService.ToolTip="强制结束当前任务;休息时变「跳过休息」,点一下跳过休息继续处理"/>
                    </StackPanel>

                    <ProgressBar x:Name="VideoProgress" Minimum="0" Maximum="100" Value="0"/>
                    <TextBlock x:Name="VideoStatus" Style="{StaticResource HintText}"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- 输出规格提示:未处理时显示将输出的分辨率+帧率(随超分/补帧/目标帧率实时更新) -->
                    <TextBlock x:Name="VideoOutSpecText" FontSize="11" Opacity="0.75"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <Border Background="{StaticResource AppBgBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8,6">
                        <ScrollViewer x:Name="VideoLogScroll" MaxHeight="220"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="VideoLogText" FontSize="10" Opacity="0.7"
                                       TextWrapping="Wrap" Text="日志:等待任务..."/>
                        </ScrollViewer>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" Margin="0,0,10,10">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- 任务摘要:已处理几个 / 剩余几个(每个视频项上另有自己的进度条+状态+预计时间) -->
                <TextBlock x:Name="TaskSummary" Grid.Row="0" FontSize="12" Opacity="0.85"
                           Text="等待任务" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"/>
                <!-- 视频列表工具栏 -->
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AddVideosBtn" Content="添加视频" FontSize="12"
                            Padding="10,5" Click="PickVideoBtn_Click"/>
                    <Button x:Name="RemoveVideoBtn" Grid.Column="1" Content="删除选中" FontSize="12"
                            Padding="10,5" IsEnabled="False" Click="RemoveVideo_Click"/>
                    <Button x:Name="ClearVideosBtn" Grid.Column="2" Content="清空" FontSize="12"
                            Padding="10,5" IsEnabled="False" Click="ClearVideos_Click"/>
                    <Button x:Name="ClearDoneBtn" Grid.Column="3" Content="清除已完成" FontSize="12"
                            Padding="10,5" IsEnabled="False" Click="ClearDoneBtn_Click"
                            ToolTipService.ToolTip="清除所有已完成(灰)的项目"/>
                    <TextBlock Grid.Column="4" Text="双击预览 · 拖动裁剪" FontSize="11"
                               Opacity="0.5" VerticalAlignment="Center" HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
                <!-- 视频列表(支持鼠标框选多选,与图片放大一致) -->
                <Grid x:Name="VideoGridHost" Grid.Row="2"
                      PointerPressed="VideoGridHost_PointerPressed"
                      PointerMoved="VideoGridHost_PointerMoved"
                      PointerReleased="VideoGridHost_PointerReleased"
                      PointerCaptureLost="VideoGridHost_PointerCaptureLost"
                      AllowDrop="True" DragOver="DropBorder_DragOver" Drop="DropBorder_Drop">
                    <ListView x:Name="VideoList" SelectionMode="Multiple" SelectionChanged="VideoList_SelectionChanged"
                              Background="Transparent" BorderThickness="0"
                              CanDragItems="True" CanReorderItems="True"
                              DoubleTapped="VideoList_DoubleTapped" KeyDown="VideoList_KeyDown"
                              AllowDrop="True" DragOver="DropBorder_DragOver" Drop="DropBorder_Drop"
                              ToolTipService.ToolTip="">   <!-- 显式空提示:覆盖 WinUI 对空列表悬停的默认"删除"伪影提示 -->
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" Padding="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="Thumb" Source="{Binding Thumb}" Stretch="Uniform"
                                           Width="120" Height="68" Opacity="{Binding DoneItemOpacity}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" Opacity="{Binding DoneItemOpacity}"/>
                                            <Border Background="#4C8DFF" CornerRadius="4" Padding="5,2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding TrimBadgeVisibility}">
                                                <TextBlock Text="已裁剪" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="White" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Background="#8A5A12" CornerRadius="4" Padding="5,2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding VfrBadgeVisibility, FallbackValue=Collapsed}">
                                                <TextBlock Text="可变帧率" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="White" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Background="{Binding DupBadgeBrush}" CornerRadius="4" Padding="5,2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding DupBadgeVisibility, FallbackValue=Collapsed}">
                                                <TextBlock Text="{Binding DupBadgeText}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="White" VerticalAlignment="Center"
                                                           ToolTipService.ToolTip="{Binding DupSummary}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Info}" FontSize="11" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- 有效输入帧率(实时联动,醒目) -->
                                        <Border Background="#2A4C8DFF" CornerRadius="4" Padding="6,2"
                                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                                Visibility="{Binding EffFpsVisibility, FallbackValue=Collapsed}">
                                            <TextBlock Text="{Binding EffFpsText}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#7FB1FF" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding OutputInfo}" FontSize="11"
                                                   Foreground="#4C8DFF" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar Height="4" Maximum="100" Value="{Binding Progress}"
                                                     Visibility="{Binding ProgressVisibility}"/>
                                        <Grid Visibility="{Binding ProgressVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" Opacity="0.7"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding EtaText}" FontSize="10"
                                                       Foreground="#E8A33D" Margin="8,0,0,0"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    Visibility="{Binding FpsEditVisibility}">
                                            <TextBox Text="{Binding FpsEditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="11" Width="80" Height="26"
                                                     IsEnabled="{Binding FpsEditEnabled}"
                                                     PlaceholderText="帧率" IsSpellCheckEnabled="False"/>
                                            <Button Content="恢复" FontSize="10" Padding="8,3"
                                                    Click="FpsReset_Click"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    Visibility="{Binding ReRunBtnVisibility, FallbackValue=Collapsed}">
                                            <Button Content="重新激活" FontSize="10" Padding="8,3"
                                                    Click="ReRunVideoBtn_Click"/>
                                            <Button Content="删除" FontSize="10" Padding="8,3"
                                                    Click="DoneDeleteBtn_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <!-- 框选橡皮筋(Canvas 内定位) -->
                    <Canvas IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Rectangle x:Name="RbRectV" Visibility="Collapsed"
                                   Stroke="#5B8DEF" StrokeThickness="1" Fill="#335B8DEF"
                                   IsHitTestVisible="False"/>
                    </Canvas>
                </Grid>

                <StackPanel x:Name="VideoDropHint" Grid.Row="2" VerticalAlignment="Center" Spacing="12"
                            IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE714;" FontSize="48" Opacity="0.3"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="拖入项目" HorizontalAlignment="Center"
                               FontSize="15" Opacity="0.6"/>
                    <TextBlock Text="MP4 / MKV / MOV / WebM / AVI" HorizontalAlignment="Center"
                               Style="{StaticResource HintText}"/>
                    <TextBlock x:Name="CompStatus" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- 视频播放预览覆盖层 -->
                <Grid x:Name="VideoPreviewOverlay" Grid.Row="2" Visibility="Collapsed" Background="#F20D0F14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="12">
                        <TextBlock x:Name="PreviewName" VerticalAlignment="Center" FontSize="13"
                                   TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                        <Button Content="退出预览" Click="PreviewClose_Click" FontSize="13" Padding="16,7,16,7"
                                ToolTipService.ToolTip="退出预览"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="16">
                        <Grid x:Name="PreviewPlayerHost"
                              PointerMoved="PreviewPlayerHost_PointerMoved"
                              PointerExited="PreviewPlayerHost_PointerExited">
                            <MediaPlayerElement x:Name="PreviewPlayer" AreTransportControlsEnabled="True"/>
                        </Grid>
                    </Grid>
                    <Grid x:Name="BottomCtrlPanel" Grid.Row="2" Margin="12,0,12,14" RowSpacing="8"
                          Visibility="Collapsed"
                          PointerEntered="BottomCtrlPanel_PointerEntered"
                          PointerExited="BottomCtrlPanel_PointerExited">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- 时间信息 + 裁剪操作 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TrimInfo" Text="未裁剪" FontSize="11" Opacity="0.7"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="ClearTrimBtn" Content="清除裁剪" ToolTipService.ToolTip="清除当前视频的裁剪范围" FontSize="11"
                                        Padding="8,4" Click="ClearTrim_Click"/>
                                <Button x:Name="SaveTrimBtn" Content="应用裁剪" ToolTipService.ToolTip="把时间线范围应用到视频(导出即为裁剪后内容)" FontSize="11"
                                        Padding="8,4" Click="ApplyTrim_Click"/>
                            </StackPanel>
                        </Grid>
                        <!-- 时间线:拖动两端把手设置裁剪范围 -->
                        <Grid x:Name="Timeline" Grid.Row="1" Height="28" Background="Transparent"
                              SizeChanged="Timeline_SizeChanged">
                            <Border Height="6" CornerRadius="3" Background="#3A4150"
                                    VerticalAlignment="Center" Margin="14,0"/>
                            <Border x:Name="TrimRange" Height="6" CornerRadius="3" Background="#4C8DFF"
                                    VerticalAlignment="Center" HorizontalAlignment="Left" Width="0"/>
                            <Border x:Name="TrimStartThumb" Width="14" Height="20" CornerRadius="3"
                                    Background="#E8ECF2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="0,0,0,0" PointerPressed="TrimThumb_PointerPressed"
                                    PointerMoved="TrimThumb_PointerMoved" PointerReleased="TrimThumb_PointerReleased"
                                    PointerCaptureLost="TrimThumb_PointerReleased"/>
                            <Border x:Name="TrimEndThumb" Width="14" Height="20" CornerRadius="3"
                                    Background="#E8ECF2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="0,0,0,0" PointerPressed="TrimThumb_PointerPressed"
                                    PointerMoved="TrimThumb_PointerMoved" PointerReleased="TrimThumb_PointerReleased"
                                    PointerCaptureLost="TrimThumb_PointerReleased"/>
                        </Grid>
                        <!-- 重复帧预览:红色条=重复集中时段 + 两个按钮 -->
                        <Grid Grid.Row="2" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="重复帧" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DupSummaryText" Text="" FontSize="11" Opacity="0.7"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="AnalyzeDupBtn" Content="分析重复帧" FontSize="11" Padding="8,4"
                                            Click="AnalyzeDupBtn_Click"
                                            ToolTipService.ToolTip="全文分析当前视频的重复帧分布(与处理时同一套检测算法,数字一致)"/>
                                    <Button x:Name="ApplyDupBtn" Content="据此设置去重" FontSize="11" Padding="8,4"
                                            Click="ApplyDupBtn_Click"
                                            ToolTipService.ToolTip="按分析结果推荐去重模式/强度,并自动勾选去重"/>
                                </StackPanel>
                            </Grid>
                            <Canvas x:Name="DupStrip" Grid.Row="1" Height="10" VerticalAlignment="Center"
                                    Background="Transparent" SizeChanged="DupStrip_SizeChanged"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
