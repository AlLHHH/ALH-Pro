                                  IsChecked="True" FontSize="12"
                                  ToolTipService.ToolTip="帧差+SSIM 算法专用(默认开):检测到局部小动作(张嘴/眨眼/手指抖动)时判定为真变化并保留,整幅差异小也不误删。取消勾选=只看整幅差异,删得更狠,但口型/微动帧可能被误删"/>
                    </StackPanel>
                    <!-- 转场识别(转场处不插帧)→ 只有下面这一个勾选框(阈值滑块已于 2026-09-15 删除) -->
                    <TextBlock x:Name="DedupHint" Style="{StaticResource HintText}" TextWrapping="Wrap"
                               Text="去重=删重复/静止帧(按节奏治理,非逐帧二分类)。智能=自动:按节奏网格+变化帧保护处理,估不准的回退保守;动漫=选档:拍一/拍二/拍三/混合,内部固定逻辑(按档网格+变化帧保护,口型/微动不删);手动=自由调参:重复帧检测/画面变化阈值/帧差+SSIM/内容帧率采样(自填值)。&#10;「转场识别」=转场处保持不插帧(检测到切换处不插帧避免鬼影)。"/>

                    <!-- 【默认关(2026-09-15 用户定调)】转场识别 = 可开可关:用户自己决定要不要切点保护。
                         启动默认**不勾** = 与重置路径、AlhPro.Core.SceneDefaultPolicy.DefaultScene 三处一致;
                         老用户文件里的值(bind 到 Scene)**一律保留** —— 升级不改变他的勾选(迁移只对齐版本号)。
                         勾上与不勾都管**两条路径**(普通分段 / 平滑时间轴),不存在"某条路忽略开关"。 -->
                    <CheckBox x:Name="SceneCheck" Content="转场识别(转场处不插帧)"
                              ToolTipService.ToolTip="按需开启(默认不勾)。&#10;【勾上】在场景硬切处不插帧,避免「两张脸糊在一起 / 拖丝」的鬼影,并且让输出的时间轴按源片真实节奏走。实测:不勾时切点处会多出一帧半新半旧的混合帧(帧间差异仅 19.72、清晰度掉到邻帧的 32%——就是那帧鬼影);勾上后同一位置变成干净硬切(差异 82.62),成片帧数与时长完全不变(实测 179 帧 / 3.000s 前后一致)。&#10;代价:极少数被误判的位置会少插一帧(实测 1 处 = 成片 184 帧里的 2 帧变成重复帧 ≈ 1.1%,几乎看不出;已加 15 帧最小间距压制单帧闪光、逐帧交替等误判)。&#10;【不勾(取消勾选)】两条路径都不做切点保护,补帧会跨切混合:剪辑较多的素材(游戏集锦、切片、多镜头混剪)可能出现跨切鬼影。&#10;【阈值不用管:内置的,不需要调】判定用的是内置阈值(帧差 ≥25 且清晰度下降 ≥40%,帧差 ≥50 直接算切),原先那条「转场阈值」滑块已于 2026-09-15 删除(它在这些判据下根本不影响判定)。&#10;开关状态会写进日志:「▶ 参数:…转场识别=0.30…」或「…转场识别=关…」。"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>
                    <!-- 【2026-09-15 用户裁决:删除「转场阈值」滑块】(原为 TextBlock「转场阈值」+ SceneSlider +
                         SceneVal 数值 + 重置按钮 一整块 Grid)。理由:切点判据用的是**内置阈值**
                         (帧差 ≥25 且 清晰度下降 ≥40%,帧差 ≥50 直接算切),这条滑条在当前判据下**根本不影响判定**,
                         只当"开关"用 —— 而开关已经由上面的「转场识别」勾选框承担,留着它只会让人以为要调。
                         仅当内置判据拿不到采样数据、回退到 ffmpeg 的 scene 判据时,才需要这个数值:那种情况由代码用
                         **内置默认 0.3**(`SceneThresholdBuiltIn`)顶替,用户不用管。
                         VideoSettings.SceneThr 字段保留(老设置/老预设反序列化兼容),但读取时忽略、写回时写内置默认。 -->

                    <TextBlock Text="果冻修复" Style="{StaticResource SectionTitle}"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="运动模糊（果冻部分）" VerticalAlignment="Center" FontSize="12"
                                   ToolTipService.ToolTip="给补帧产生的「果冻」(快速运动处的画面扭曲)加上真实的运动模糊,把它盖掉、让运动更自然。只在果冻强的地方生效,静止画面不受影响;弱/中/强 = 效果越强、越慢"/>
                        <ComboBox x:Name="MotionBlurCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                  SelectedIndex="0" SelectionChanged="Combo_Changed">
                            <ComboBoxItem Content="关"/>
                            <ComboBoxItem Content="弱"/>
                            <ComboBoxItem Content="中"/>
                            <ComboBoxItem Content="强"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="DeShakeCheck" Content="画面去抖" ToolTipService.ToolTip="画面去抖:轻量稳定画面,减少手持拍摄的晃动"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>
                    <TextBlock x:Name="JellySlowHint" Visibility="Collapsed"
                               Text="⚠ 果冻修复为 CPU 逐帧滤镜,会明显增加导出时间(运动模糊最慢,画面去抖较轻)。视觉要求不高时建议关闭。"
                               Foreground="#E8A33D" FontSize="11" TextWrapping="Wrap"/>

                    <Button x:Name="AdvancedToggleBtn" Content="高级参数 ▾" HorizontalAlignment="Stretch"
                            Click="AdvancedToggleBtn_Click"
                            ToolTipService.ToolTip="进阶参数,一般不用动"/>
                    <StackPanel x:Name="AdvancedPanel" Spacing="10" Margin="0,8,0,4" Visibility="Collapsed">
                            <TextBlock Text="光流调整" Style="{StaticResource SectionTitle}"/>
                            <CheckBox x:Name="TtaCheck" Content="开启高质量(减少伪影)" ToolTipService.ToolTip="高质量(TTA):反复推演减少补帧的跳步/扭曲伪影。⚠ 开启后会严重增加导出时间(约慢 5~7 倍)。默认关闭(追求速度);画质优先可手动开启"
                                      Checked="Options_Changed" Unchecked="Options_Changed"/>
                            <TextBlock Text="⚠ 开启后会严重增加导出时间" Style="{StaticResource HintText}" TextWrapping="Wrap"/>

                            <!-- 【2026-09-15 用户裁决:删除「补帧输出帧率基准」下拉】(原为 SectionTitle + FpsBaseCombo
                                 (真实时间轴插值/匀速帧速率插值) + 一行黄色提示)。固定为**真实时间轴插值**(内部 fpsMode=2):
                                 "匀速"档只会丢掉原片的定格节奏、让画面出现时刻与原片对不上;而且代码里 fpsMode=0 与 =2
                                 本来就没有任何分支差别(唯一区分处早已注释掉) ⇒ 一个自己都分不清、只有坏分支的选项。
                                 VideoSettings.FpsBase 字段保留(反序列化兼容),读取忽略、写回写 0(=真实时间轴)。 -->
                        </StackPanel>

                    <TextBlock x:Name="InterpHint" Style="{StaticResource HintText}"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="输出" Style="{StaticResource SectionTitle}"/>
                    <TextBox x:Name="OutFileBox" PlaceholderText="默认与源视频同目录"
                             IsSpellCheckEnabled="False" TextChanged="OutFileBox_TextChanged"/>
                    <Button Content="选择输出位置..." Click="BrowseOut_Click"
                            HorizontalAlignment="Stretch"/>

                    <TextBlock Text="码率 / 格式" Style="{StaticResource SectionTitle}"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="码率" VerticalAlignment="Center" FontSize="12"
                                   ToolTipService.ToolTip="输出画质:自动=均衡;低=文件小画质一般;极高=文件大画质好;自定义=按你填的码率"/>
                        <ComboBox x:Name="QualityCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                  SelectionChanged="QualityCombo_Changed">
                            <ComboBoxItem Content="自动 (推荐)"/>
                            <ComboBoxItem Content="低 (文件小)"/>
                            <ComboBoxItem Content="中"/>
                            <ComboBoxItem Content="高"/>
                            <ComboBoxItem Content="极高 (文件大)"/>
                            <ComboBoxItem Content="自定义码率..."/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="重置" FontSize="10" Padding="10,4"
                                Click="QualityReset_Click"
                                ToolTipService.ToolTip="码率恢复为自动"/>
                    </Grid>
                    <Grid x:Name="BitrateRow" ColumnSpacing="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="码率(Mbps)" VerticalAlignment="Center" FontSize="12"
                                   ToolTipService.ToolTip="自定义目标码率,如 8 = 8Mbps(1080p 常见清晰码率);越高文件越大越清晰"/>
                        <TextBox x:Name="BitrateBox" Grid.Column="1" PlaceholderText="例如 8"
                                 IsSpellCheckEnabled="False" InputScope="Number"
                                 TextChanged="BitrateBox_TextChanged"/>
                        <TextBlock Grid.Column="2" Text="Mbps" VerticalAlignment="Center" FontSize="12"/>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="格式" VerticalAlignment="Center" FontSize="12"
                                   ToolTipService.ToolTip="输出封装格式:MP4 通用性最好;MKV 兼容性略低但无损封装"/>
                        <ComboBox x:Name="FormatCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                  SelectionChanged="Combo_Changed">
                            <ComboBoxItem Content="MP4 (通用)"/>
                            <ComboBoxItem Content="MKV"/>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="编码格式" VerticalAlignment="Center" FontSize="12"
                                   ToolTipService.ToolTip="H.264=最通用,所有设备都能播;H.265=同画质文件小一半,但很老的设备/播放器可能不支持"/>
                        <ComboBox x:Name="CodecCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                  SelectionChanged="Combo_Changed">
                            <ComboBoxItem Content="H.264 (通用)"/>
                            <ComboBoxItem Content="H.265 (文件小)"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="MuteCheck" Content="静音(输出不含音频)"
                              ToolTipService.ToolTip="勾选后导出视频不带音轨(只保留画面);几帧小片段/不需要声音时用"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>
                    <CheckBox x:Name="FastModeCheck" Content="兼容模式（低配设备）" ToolTipService.ToolTip="勾选后自动降低显存占用、防止爆显存/卡死,画质与功能基本不受影响;配置好的设备可不开"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>
                    <TextBlock x:Name="FastModeHint" Style="{StaticResource HintText}" TextWrapping="Wrap"
                               Text="给配置较低/没独显的电脑用的:自动降低显存占用、防止爆显存,画质和功能基本不受影响"/>
                    <!-- 【2026-09-15 用户定调:平滑时间轴从界面移除,固定为「开」】原控件:
                         这里原本有一个「平滑时间轴」勾选框(默认勾选)+ 一行灰字说明,本轮**整块删除**。
                         理由(用户原话:"平滑时间轴什么的不应该就是需要存在吗 直接默认在不就好 不要显示出来 他不开有什么功能"):
                         它不是用户偏好,而是"输出时间轴跟源片对齐"的正确性修正 —— 只在源时间轴不均匀(有顿挫)时才动手,
                         源本来就均匀时逐字走老路径;关掉只会让不均匀的节奏留在成片里,没有任何功能收益。
                         实现侧固定为启用:VideoView 恒传 smoothTimeline:true;
                         VideoSettings.SmoothTimeline 字段保留但**读取时忽略用户旧值**(见 ApplyVideoParams)。 -->

                    <!-- 参数预设:整套超分/后处理/补帧/去重参数快照,一键保存/应用 -->
                    <TextBlock Text="参数预设" Style="{StaticResource SectionTitle}"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="使用预设" Click="OpenPresetWindowBtn_Click"
                                HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="打开预设列表:点选应用、删除、排序"/>
                        <Button Grid.Column="1" Content="保存预设" Click="SavePresetBtn_Click"
                                HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="把当前全部视频参数保存为一个预设(上限 100 个)"/>
                    </Grid>

                    <!-- 重置参数 / 记住上次:与参数预设放一起(参数管理) -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="VideoResetBtn" Grid.Column="0" Content="重置所有参数" ToolTipService.ToolTip="恢复全部默认参数(超分/补帧/去重/后处理/输出/编码等)"
                                HorizontalAlignment="Stretch" Click="VideoResetBtn_Click"/>
                        <CheckBox x:Name="VideoRememberCheck" Grid.Column="1" Content="记住上次" IsChecked="True" ToolTipService.ToolTip="记住处理参数(不含输入帧率),下次启动自动恢复"
                                  VerticalAlignment="Center"
                                  Checked="Remember_Changed" Unchecked="Remember_Changed"/>
                    </Grid>

                    <!-- 操作按钮:上一排「开始处理」(占满变宽),中间「暂停/恢复」,最下方「停止」 -->
                    <StackPanel Spacing="8">
                        <Button x:Name="RunBtn" Content="开始处理"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" MinHeight="48"
                                IsEnabled="False" Click="RunBtn_Click"/>
                        <!-- 预览效果:用左侧当前参数真跑一小段(默认 3 秒),在右侧预览页直接看成片 ——
                             走的是「开始处理」同一条流水线,不降质;批量处理前先确认参数对不对,不用等全片 -->
                        <Button x:Name="PreviewBtn" Content="预览效果"
                                HorizontalAlignment="Stretch" MinHeight="38"
                                Background="#FF22C55E" BorderBrush="#FF22C55E" BorderThickness="0" Foreground="#FF052E16"
                                IsEnabled="False" Click="RunPreviewBtn_Click"
                                ToolTipService.ToolTip="先用当前参数只处理一小段(起点 2~15 秒、长度 1~10 秒,默认 3 秒),在右侧预览页直接看处理结果。同一套流水线、同样的清晰度,只是跑得短。"/>
                        <TextBlock x:Name="RunHint" Text="⚠ 至少启用一项处理(超分、补帧或去重)"
                                   Foreground="#E8A33D" FontSize="11" TextWrapping="Wrap"
                                   TextAlignment="Center" Visibility="Collapsed"/>
                        <!-- 只勾去重(不超分不补帧)时的说明:导出成片的帧率=内容帧率、时长不变 -->
                        <TextBlock x:Name="DedupOnlyHint" Text="※ 只启用去重:成片帧率会变成素材的内容帧率(时长不变,不放大也不补帧)"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap"
                                   TextAlignment="Center" Visibility="Collapsed"/>
                        <!-- 耗时提示(黄色):启用耗时功能时提示处理时间会增加 -->
                        <TextBlock x:Name="SpeedHint" Text=""
                                   Foreground="#E8A33D" FontSize="11" TextWrapping="Wrap"
                                   TextAlignment="Center" Visibility="Collapsed"/>
                        <!-- 弱设备提示(黄色)+ 一键开启兼容模式 -->
                        <StackPanel x:Name="CompatHintPanel" Orientation="Vertical" Visibility="Collapsed" Spacing="4">
                            <TextBlock x:Name="CompatHint" Foreground="#E8A33D" FontSize="11" TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                            <Button x:Name="EnableCompatBtn" Content="帮我开启兼容模式" FontSize="11" Padding="8,3"
                                    HorizontalAlignment="Center" Click="EnableCompatBtn_Click"/>
                        </StackPanel>
                        <CheckBox x:Name="SelectedOnlyCheck" Content="只处理选中的项目"
                                  ToolTipService.ToolTip="勾选后只处理右侧列表里选中的项;不勾选则处理全部"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PauseBtn" Grid.Column="0" Content="暂停"
                                    HorizontalAlignment="Stretch" MinHeight="44"
                                    IsEnabled="False" Click="PauseBtn_Click"
                                    ToolTipService.ToolTip="暂停:处理完当前这个视频后停下,可删除还没处理的项目"/>
                            <Button x:Name="ResumeBtn" Grid.Column="1" Content="恢复"
                                    HorizontalAlignment="Stretch" MinHeight="44"
                                    IsEnabled="False" Click="ResumeBtn_Click"
                                    ToolTipService.ToolTip="恢复:立即继续处理"/>
                        </Grid>
                        <Button x:Name="CancelBtn" Content="强制结束"
                                HorizontalAlignment="Stretch" MinHeight="44" Background="#E5484D" Foreground="White"
                                IsEnabled="False" Click="CancelBtn_Click"
                                ToolTipService.ToolTip="强制结束当前任务;休息时变「跳过休息」,点一下跳过休息继续处理"/>
                    </StackPanel>

                    <ProgressBar x:Name="VideoProgress" Minimum="0" Maximum="100" Value="0"/>
                    <TextBlock x:Name="VideoStatus" Style="{StaticResource HintText}"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- 输出规格提示:未处理时显示将输出的分辨率+帧率(随超分/补帧/目标帧率实时更新) -->
                    <TextBlock x:Name="VideoOutSpecText" FontSize="11" Opacity="0.75"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <!-- 【第 3 项】DirectML 不可用 → 超分将落到 CPU 的醒目红字提示(内联,不弹窗):
                         常规只显示这一行;预计该阶段超过 30 分钟时,开始处理前会额外弹一次「仍要继续/取消」确认。
                         放在输出规格/进度条同一提示位(不是新开一块区域),保证用户一眼能看到。 -->
                    <TextBlock x:Name="CpuFallbackHint" FontSize="11" FontWeight="SemiBold"
                               Foreground="#E5484D" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <Border Background="{StaticResource AppBgBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8,6">
                        <!-- 【滚动条必须常驻:这是"布局循环"的根因,别改回 Auto(2026-09-12)】
                             原来写的是 VerticalScrollBarVisibility="Auto" + 里面 TextBlock TextWrapping="Wrap"
                             + 外面是 StackPanel(高度由内容决定)+ MaxHeight=220。这一组合会成环:
                               日志长过 220 → 滚动条出现 → 内容宽度变窄 → 自动折行 → 高度变化 →
                               又不需要滚动条了 → 宽度变回来 → 再折行 …… 来回横跳 = WinUI 判"布局循环"
                               (LayoutCycleException)。实测:50 系笔记本开【去重】时日志行暴增、正好越过这个临界点,
                               于是界面被冻死(后台任务其实还在跑,只能重启软件)。这就是"开了去重就卡死"的真正原因。
                             常驻滚动条 = 内容宽度恒定 → 折行结果恒定 → 高度不会再变 → 环路断掉。
                             代价:日志区一直留着一条滚动条槽(观感,可接受);换来的是界面绝不因日志变长而死。 -->
                        <ScrollViewer x:Name="VideoLogScroll" MaxHeight="220"
                                      VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="VideoLogText" FontSize="10" Opacity="0.7"
                                       TextWrapping="Wrap" Text="日志:等待任务..."/>
                        </ScrollViewer>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" Margin="0,0,10,10">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- 任务摘要:已处理几个 / 剩余几个(每个视频项上另有自己的进度条+状态+预计时间) -->
                <TextBlock x:Name="TaskSummary" Grid.Row="0" FontSize="12" Opacity="0.85"
                           Text="等待任务" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"/>
                <!-- 视频列表工具栏 -->
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AddVideosBtn" Content="添加视频" FontSize="12"
                            Padding="10,5" Click="PickVideoBtn_Click"/>
                    <Button x:Name="RemoveVideoBtn" Grid.Column="1" Content="删除选中" FontSize="12"
                            Padding="10,5" IsEnabled="False" Click="RemoveVideo_Click"/>
                    <Button x:Name="ClearVideosBtn" Grid.Column="2" Content="清空" FontSize="12"
                            Padding="10,5" IsEnabled="False" Click="ClearVideos_Click"/>
                    <Button x:Name="ClearDoneBtn" Grid.Column="3" Content="清除已完成" FontSize="12"
                            Padding="10,5" IsEnabled="False" Click="ClearDoneBtn_Click"
                            ToolTipService.ToolTip="清除所有已完成(灰)的项目"/>
                    <TextBlock Grid.Column="4" Text="双击预览 · 拖动裁剪" FontSize="11"
                               Opacity="0.5" VerticalAlignment="Center" HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
                <!-- 视频列表(支持鼠标框选多选,与图片放大一致) -->
                <Grid x:Name="VideoGridHost" Grid.Row="2"
                      PointerPressed="VideoGridHost_PointerPressed"
                      PointerMoved="VideoGridHost_PointerMoved"
                      PointerReleased="VideoGridHost_PointerReleased"
                      PointerCaptureLost="VideoGridHost_PointerCaptureLost"
                      AllowDrop="True" DragOver="DropBorder_DragOver" Drop="DropBorder_Drop">
                    <ListView x:Name="VideoList" SelectionMode="Multiple" SelectionChanged="VideoList_SelectionChanged"
                              IsItemClickEnabled="True" ItemClick="VideoList_ItemClick"
                              Background="Transparent" BorderThickness="0"
                              CanDragItems="True" CanReorderItems="True"
                              DoubleTapped="VideoList_DoubleTapped" KeyDown="VideoList_KeyDown"
                              AllowDrop="True" DragOver="DropBorder_DragOver" Drop="DropBorder_Drop"
                              ToolTipService.ToolTip="">   <!-- 显式空提示:覆盖 WinUI 对空列表悬停的默认"删除"伪影提示 -->
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" Padding="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="Thumb" Source="{Binding Thumb}" Stretch="Uniform"
                                           Width="120" Height="68" Opacity="{Binding DoneItemOpacity}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" Opacity="{Binding DoneItemOpacity}"/>
                                            <Border Background="#4C8DFF" CornerRadius="4" Padding="5,2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding TrimBadgeVisibility}">
                                                <TextBlock Text="已裁剪" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="White" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Background="#8A5A12" CornerRadius="4" Padding="5,2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding VfrBadgeVisibility, FallbackValue=Collapsed}">
                                                <TextBlock Text="可变帧率" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="White" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Background="{Binding DupBadgeBrush}" CornerRadius="4" Padding="5,2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding DupBadgeVisibility, FallbackValue=Collapsed}">
                                                <TextBlock Text="{Binding DupBadgeText}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="White" VerticalAlignment="Center"
                                                           ToolTipService.ToolTip="{Binding DupSummary}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Info}" FontSize="11" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- 有效输入帧率(实时联动,醒目) -->
                                        <Border Background="#2A4C8DFF" CornerRadius="4" Padding="6,2"
                                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                                Visibility="{Binding EffFpsVisibility, FallbackValue=Collapsed}">
                                            <TextBlock Text="{Binding EffFpsText}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#7FB1FF" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding OutputInfo}" FontSize="11"
                                                   Foreground="#4C8DFF" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar Height="4" Maximum="100" Value="{Binding Progress}"
                                                     Visibility="{Binding ProgressVisibility}"/>
                                        <Grid Visibility="{Binding ProgressVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" Opacity="0.7"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding EtaText}" FontSize="10"
                                                       Foreground="#E8A33D" Margin="8,0,0,0"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    Visibility="{Binding FpsEditVisibility}">
                                            <TextBox Text="{Binding FpsEditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="11" Width="80" Height="26"
                                                     IsEnabled="{Binding FpsEditEnabled}"
                                                     PlaceholderText="帧率" IsSpellCheckEnabled="False"/>
                                            <Button Content="恢复" FontSize="10" Padding="8,3"
                                                    Click="FpsReset_Click"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    Visibility="{Binding ReRunBtnVisibility, FallbackValue=Collapsed}">
                                            <Button Content="重新激活" FontSize="10" Padding="8,3"
                                                    Click="ReRunVideoBtn_Click"/>
                                            <Button Content="删除" FontSize="10" Padding="8,3"
                                                    Click="DoneDeleteBtn_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <!-- 框选橡皮筋(Canvas 内定位) -->
                    <Canvas IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Rectangle x:Name="RbRectV" Visibility="Collapsed"
                                   Stroke="#5B8DEF" StrokeThickness="1" Fill="#335B8DEF"
                                   IsHitTestVisible="False"/>
                    </Canvas>
                </Grid>

                <StackPanel x:Name="VideoDropHint" Grid.Row="2" VerticalAlignment="Center" Spacing="12"
                            IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE714;" FontSize="48" Opacity="0.3"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="拖入项目" HorizontalAlignment="Center"
                               FontSize="15" Opacity="0.6"/>
                    <TextBlock Text="MP4 / MKV / MOV / WebM / AVI" HorizontalAlignment="Center"
                               Style="{StaticResource HintText}"/>
                    <TextBlock x:Name="CompStatus" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- 预览/裁剪覆盖层(2026-09-17 拆成两页:双击=裁剪页(只有裁剪),「预览效果」=预览页(只有预览)) -->
                <Grid x:Name="VideoPreviewOverlay" Grid.Row="2" Visibility="Collapsed" Background="#F20D0F14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 唯一画面:结果在下、原片在上(对比时原片按分割线裁切,左边原片/右边结果) -->
                        <RowDefinition Height="*" MinHeight="140"/>
                        <!-- 裁剪页控制区 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 预览页控制区 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 裁剪页的「重复帧」工具行(默认收起) -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ① 顶栏:素材信息 | 视图三选一(仅预览页) | 放大 | 退出 -->
                    <Grid Grid.Row="0" Margin="14,10,14,6" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewName" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                            <TextBlock x:Name="PreviewMeta" FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <RadioButtons x:Name="PreviewViewRadios" Grid.Column="1" MaxColumns="3" SelectedIndex="0"
                                      VerticalAlignment="Center"
                                      SelectionChanged="PreviewViewRadios_SelectionChanged"
                                      ToolTipService.ToolTip="看原片 / 看处理效果 / 左右对比(左原片右结果,中间那条线可以拖)">
                            <RadioButton Content="看原片"/>
                            <RadioButton Content="看处理效果"/>
                            <RadioButton Content="左右对比"/>
                        </RadioButtons>
                        <Button x:Name="EffectZoomBtn" Grid.Column="2" Content="放大画面" FontSize="12" Padding="12,6"
                                VerticalAlignment="Center" Click="EffectZoomBtn_Click"
                                ToolTipService.ToolTip="收起下方控制区,让画面占满整页(再点一次回来)"/>
                        <Button Grid.Column="3" Content="退出" Click="PreviewClose_Click" FontSize="13" Padding="16,7"
                                VerticalAlignment="Center" ToolTipService.ToolTip="退出回到列表"/>
                    </Grid>

                    <!-- ② 画面区:结果播放器在下层、原片在上层(对比时把原片裁到分割线左边) -->
                    <Grid x:Name="PlayerArea" Grid.Row="1" Margin="14,0,14,8" SizeChanged="PlayerArea_SizeChanged"
                          Tapped="PlayerArea_Tapped" PointerMoved="PlayerArea_PointerMoved">
                        <!-- 【2026-09-17 用户要求】提示文字放【最底层】:左边原片会自然盖住它,
                             于是它只在"没有结果的那一半"露出来 —— 不用按钮、也不会被中间那条分割线压住。 -->
                        <TextBlock x:Name="EffectPlayerHint" Text="点下面「开始预览」,处理结果会在这里播放"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12" Opacity="0.45" TextWrapping="Wrap"
                                   TextAlignment="Center" IsHitTestVisible="False"/>
                        <Grid x:Name="EffectPlayerHost" Visibility="Collapsed">
                            <MediaPlayerElement x:Name="EffectPlayer" AreTransportControlsEnabled="False" Stretch="Uniform"/>
                        </Grid>
                        <Grid x:Name="PreviewPlayerHost"
                              PointerMoved="PreviewPlayerHost_PointerMoved"
                              PointerExited="PreviewPlayerHost_PointerExited">
                            <MediaPlayerElement x:Name="PreviewPlayer" AreTransportControlsEnabled="False"/>
                        </Grid>
                        <!-- 对比模式:左右两半的身份标签(不然两边都是同一画面,看不出谁是谁) -->
                        <Border x:Name="CmpLabelLeft" Visibility="Collapsed" HorizontalAlignment="Left"
                                VerticalAlignment="Top" Margin="10" Padding="10,4" CornerRadius="4"
                                Background="#B30D0F14" IsHitTestVisible="False">
                            <TextBlock Text="原片" FontSize="12" Foreground="#E8ECF2"/>
                        </Border>
                        <Border x:Name="CmpLabelRight" Visibility="Collapsed" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="10" Padding="10,4" CornerRadius="4"
                                Background="#B3101318" IsHitTestVisible="False">
                            <TextBlock Text="处理后" FontSize="12" Foreground="#7FB2FF"/>
                        </Border>
                        <!-- 左右对比的分割线(可左右拖) -->
                        <Grid x:Name="CompareSplitter" Width="28" HorizontalAlignment="Left" Visibility="Collapsed"
                              Background="Transparent"
                              PointerPressed="CompareSplitter_PointerPressed"
                              PointerMoved="CompareSplitter_PointerMoved"
                              PointerReleased="CompareSplitter_PointerReleased"
                              PointerCaptureLost="CompareSplitter_PointerReleased"
                              ToolTipService.ToolTip="左右拖动这条线:左边原片、右边处理结果">
                            <Rectangle Width="2" Fill="#FFFFFF" Opacity="0.9" HorizontalAlignment="Center"
                                       Margin="0,0,0,52" IsHitTestVisible="False"/>
                            <Border Width="34" Height="56" CornerRadius="16" Background="#E67FB2FF"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    PointerPressed="CompareSplitter_PointerPressed"
                                    PointerMoved="CompareSplitter_PointerMoved">
                                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" IsHitTestVisible="False">
                                    <FontIcon Glyph="&#xE76B;" FontSize="11" Foreground="#0D0F14"/>
                                    <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="#0D0F14"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <!-- 对比模式专用:一套播放控件(自己画,盖在最上层;两个播放器自带的控件都关掉) -->
                        <Border x:Name="CompareBar" Visibility="Collapsed" VerticalAlignment="Bottom"
                                Margin="8,0,8,8" Padding="8,4" CornerRadius="6" Background="#E6101318"
                                HorizontalAlignment="Stretch" Opacity="0" IsHitTestVisible="False">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="CmpPlayBtn" Padding="14,3" VerticalAlignment="Center" Click="CmpPlayBtn_Click"
                                        ToolTipService.ToolTip="播放/暂停(左右两边同步;也可以直接点画面)">
                                    <FontIcon x:Name="CmpPlayIcon" Glyph="&#xE768;" FontSize="15"/>
                                </Button>
                                <Slider Margin="-11,0,-11,0" x:Name="CmpSeek" Grid.Column="1" Minimum="0" Maximum="100" Value="0"
                                        StepFrequency="0.5" VerticalAlignment="Center"
                                        ValueChanged="CmpSeek_ValueChanged"
                                        ToolTipService.ToolTip="拖动定位:左右两边同时跳到同一时刻"/>
                                <TextBlock x:Name="CmpTime" Grid.Column="2" Text="0:00 / 0:00" FontSize="11"
                                           VerticalAlignment="Center" MinWidth="96" TextAlignment="Right"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ③ 裁剪页:一条时间线 + 首尾两个把手(拖动时画面跟着跳到那个点) -->
                    <StackPanel x:Name="TrimDeck" Grid.Row="2" Margin="14,0,14,10" Spacing="8" Visibility="Collapsed">
                        <Grid x:Name="TrimTimeline" Height="52" Background="Transparent"
                              SizeChanged="TrimTimeline_SizeChanged"
                              PointerPressed="TrimTimeline_PointerPressed"
                              PointerMoved="TrimTimeline_PointerMoved"
                              PointerReleased="TrimTimeline_PointerReleased"
                              PointerCaptureLost="TrimTimeline_PointerReleased"
                              ToolTipService.ToolTip="拖左把手=入点 · 拖右把手=出点 · 拖的时候画面跟着跳到那个点">
                            <Border Height="16" CornerRadius="4" Background="#2A3240"
                                    Margin="0,20,0,0" VerticalAlignment="Top"/>
                            <Border x:Name="TrimRange" Height="16" CornerRadius="4" Background="#4C8DFF"
                                    Margin="0,20,0,0" VerticalAlignment="Top"
                                    HorizontalAlignment="Left" Width="0"/>
                            <Border x:Name="TrimStartThumb" Width="16" Height="26" CornerRadius="3" Background="#E8ECF2"
                                    VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,15,0,0"/>
                            <Border x:Name="TrimEndThumb" Width="16" Height="26" CornerRadius="3" Background="#E8ECF2"
                                    VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,15,0,0"/>
                            <Canvas x:Name="TrimTicks" Height="16" VerticalAlignment="Bottom"
                                    HorizontalAlignment="Stretch" IsHitTestVisible="False"/>
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TrimInfo" Text="未裁剪" FontSize="11" Opacity="0.8"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="DupToggleBtn" Content="重复帧 ▾" FontSize="12" Padding="12,7"
                                        Visibility="Collapsed" Click="ToggleDup_Click"
                                        ToolTipService.ToolTip="重复帧分布分析(只在需要治理重复帧时用,平时收起)"/>
                                <Button x:Name="ClearTrimBtn" Content="清除裁剪" FontSize="12" Padding="12,7"
                                        Click="ClearTrim_Click" ToolTipService.ToolTip="清除这个视频的裁剪范围(整段都保留)"/>
                                <Button x:Name="SaveTrimBtn" Content="应用裁剪" FontSize="12" Padding="16,7"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="ApplyTrim_Click"
                                        ToolTipService.ToolTip="把这段范围应用到视频:导出时只输出这一段"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ④ 预览页:时间线(拖起点) + 精调 + 一行动作 -->
                    <StackPanel x:Name="PreviewDeck" Grid.Row="3" Margin="14,0,14,10" Spacing="8" Visibility="Collapsed">
                        <Grid x:Name="PrevTimeline" Height="52" Background="Transparent"
                              SizeChanged="PrevTimeline_SizeChanged"
                              PointerPressed="PrevTimeline_PointerPressed"
                              PointerMoved="PrevTimeline_PointerMoved"
                              PointerReleased="PrevTimeline_PointerReleased"
                              PointerCaptureLost="PrevTimeline_PointerReleased"
                              ToolTipService.ToolTip="拖蓝线=选起点 · 拖右端白把手=改长度 · ←/→ 一帧 · PageUp/PageDown 一秒">
                            <Border Height="16" CornerRadius="4" Background="#2A3240"
                                    Margin="0,20,0,0" VerticalAlignment="Top"/>
                            <Border x:Name="PrevRangeBar" Height="16" CornerRadius="4" Background="#3E6FBF"
                                    Margin="0,20,0,0" VerticalAlignment="Top"
                                    HorizontalAlignment="Left" Width="0"/>
                            <Border x:Name="PrevEndGrip" Width="14" Height="24" CornerRadius="3" Background="#E8ECF2"
                                    VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                            <Grid x:Name="PrevHeadGrip" Width="20" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Rectangle Width="2" Height="38" Fill="#7FB2FF" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,14,0,0"/>
                                <Border Width="16" Height="14" CornerRadius="3" Background="#7FB2FF"
                                        HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            </Grid>
                            <Canvas x:Name="PrevTicks" Height="16" VerticalAlignment="Bottom"
                                    HorizontalAlignment="Stretch" IsHitTestVisible="False"/>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="起点" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                <TextBlock x:Name="EffectStartValueText" Text="00:00.0" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" MinWidth="52"/>
                                <Button x:Name="EffectNudgeDownBtn" Content="−0.1" FontSize="11" Padding="8,4"
                                        Click="EffectStartNudge_Click" Tag="-0.1"
                                        ToolTipService.ToolTip="起点后退 0.1 秒(拖不准时用它)"/>
                                <Button x:Name="EffectNudgeUpBtn" Content="+0.1" FontSize="11" Padding="8,4"
                                        Click="EffectStartNudge_Click" Tag="0.1"
                                        ToolTipService.ToolTip="起点前进 0.1 秒(拖不准时用它)"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="这一段多长" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                <Button x:Name="EffectLenChip2" Content="2 秒" Tag="2" FontSize="11" Padding="10,4"
                                        Click="EffectLenChip_Click"/>
                                <Button x:Name="EffectLenChip3" Content="3 秒" Tag="3" FontSize="11" Padding="10,4"
                                        Click="EffectLenChip_Click"/>
                                <Button x:Name="EffectLenChip5" Content="5 秒" Tag="5" FontSize="11" Padding="10,4"
                                        Click="EffectLenChip_Click"/>
                                <Button x:Name="EffectLenChip10" Content="10 秒" Tag="10" FontSize="11" Padding="10,4"
                                        Click="EffectLenChip_Click"/>
                                <Button x:Name="EffectLenChip15" Content="15 秒" Tag="15" FontSize="11" Padding="10,4"
                                        Click="EffectLenChip_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="EffectRangeText" Grid.Column="2" Text="" FontSize="11" Opacity="0.75"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="EffectRunBtn" Content="开始预览" FontSize="12" Padding="16,7"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="EffectRunBtn_Click"
                                        ToolTipService.ToolTip="用左侧当前参数只跑这一段(可随时「取消」;跑完自动切到对比画面播放)"/>
                                <Button x:Name="SavePreviewBtn" Content="保存此预览" FontSize="12" Padding="12,7"
                                        IsEnabled="False" Click="SavePreview_Click"
                                        ToolTipService.ToolTip="把这次预览的成片保存到你指定的位置(视频文件,和全片处理同一套参数/画质)"/>
                                <Button x:Name="EffectCancelBtn" Content="取消" FontSize="12" Padding="12,7"
                                        IsEnabled="False" Click="EffectCancelBtn_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <ProgressBar x:Name="EffectProgress" Width="170" Minimum="0" Maximum="100" Value="0"/>
                                <TextBlock x:Name="EffectDirtyHint" Text="参数已改动 · 点「重新预览」看新效果" FontSize="11"
                                           Foreground="#E8A33D" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock x:Name="EffectStatusText" Text="" FontSize="11" Opacity="0.8"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <ComboBox x:Name="EffectVideoCombo" Grid.Column="2" Width="210" FontSize="12"
                                      DisplayMemberPath="Name" PlaceholderText="选择素材"
                                      VerticalAlignment="Center"
                                      SelectionChanged="EffectVideoCombo_SelectionChanged"
                                      ToolTipService.ToolTip="要预览的素材:默认是右侧列表里选中的那个,也可以在这里直接换"/>
                        </Grid>
                    </StackPanel>

                    <!-- ⑤ 裁剪页的「重复帧」工具行(默认收起) -->
                    <Border x:Name="DupToolsPanel" Grid.Row="4" Visibility="Collapsed"
                            Margin="14,0,14,12" Padding="10" CornerRadius="6"
                            Background="#33222A38" BorderBrush="#3A4150" BorderThickness="1">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="重复帧:分析整片的重复帧分布,可据此一键设置去重(只影响「开始处理」时的去重策略)"
                                       FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
                            <Grid Grid.Row="1" RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DupSummaryText" Text="" FontSize="11" Opacity="0.75"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="AnalyzeDupBtn" Content="分析重复帧" FontSize="11" Padding="8,4"
                                                Click="AnalyzeDupBtn_Click"
                                                ToolTipService.ToolTip="全文分析当前视频的重复帧分布(只做预估,不精确):为求速度会把画面缩到 400 宽灰度再采样,且智能模式这里用「自适应判据」预估,而真正处理时走「拍数识别+网格采样」——所以数字是估计值,与处理结果可能有小幅差异"/>
                                        <Button x:Name="ApplyDupBtn" Content="据此设置去重" FontSize="11" Padding="8,4"
                                                Click="ApplyDupBtn_Click"
                                                ToolTipService.ToolTip="按分析结果推荐去重模式/强度,并自动勾选去重"/>
                                    </StackPanel>
                                </Grid>
                                <Canvas x:Name="DupStrip" Grid.Row="1" Height="10" VerticalAlignment="Center"
                                        Background="Transparent" SizeChanged="DupStrip_SizeChanged"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
