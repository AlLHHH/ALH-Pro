                    <FontIcon Glyph="&#xE714;" FontSize="48" Opacity="0.3"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="拖入项目" HorizontalAlignment="Center"
                               FontSize="15" Opacity="0.6"/>
                    <TextBlock Text="MP4 / MKV / MOV / WebM / AVI" HorizontalAlignment="Center"
                               Style="{StaticResource HintText}"/>
                    <TextBlock x:Name="CompStatus" HorizontalAlignment="Center"
                               FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- 预览/裁剪覆盖层(2026-09-17 拆成两页:双击=裁剪页(只有裁剪),「预览效果」=预览页(只有预览)) -->
                <Grid x:Name="VideoPreviewOverlay" Grid.Row="2" Visibility="Collapsed" Background="#F20D0F14"
                      PreviewKeyDown="VideoPreviewOverlay_PreviewKeyDown">
                    <!-- 空格 = 播放/暂停(用户反馈"部分情况下空格没用":以前只有播放器自带控件吃空格,
                         对比模式把自带控件关了就没反应了)。做成加速键,焦点在哪都能用(输入框除外,见处理函数)。
                         【2026-09-19 用户实测补一刀】只要焦点落在某个按钮上,XAML 会**先把空格当成"按下这个按钮"** ⇒
                         处理期间按空格就把「取消」按下去了 ✗。所以这里再加一层 PreviewKeyDown(隧道路由,
                         比焦点元素的 KeyDown 更早),把空格统一改道到"播放/暂停" ✔ —— 见 VideoPreviewOverlay_PreviewKeyDown。 -->
                    <Grid.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Space" Invoked="PreviewSpaceAccel_Invoked"/>
                    </Grid.KeyboardAccelerators>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 唯一画面:结果在下、原片在上(对比时原片按分割线裁切,左边原片/右边结果) -->
                        <RowDefinition Height="*" MinHeight="140"/>
                        <!-- 裁剪页控制区 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 预览页控制区 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 裁剪页的「重复帧」工具行(默认收起) -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ① 顶栏:素材信息 | 视图三选一(仅预览页) | 放大 | 退出 -->
                    <Grid Grid.Row="0" Margin="14,10,14,6" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewName" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                            <TextBlock x:Name="PreviewMeta" FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <!-- 【2026-09-19 用户要求:高分辨率素材要红字提示】预览要"大分辨率解码"两条,
                                 素材/成片越大越容易掉帧卡顿 ⇒ 用红字直说"该担心什么 + 怎么办",不吓人、不挡操作 ✔ -->
                            <TextBlock x:Name="PreviewLoadWarn" FontSize="11" FontWeight="SemiBold" Foreground="#FF7070"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                        <RadioButtons x:Name="PreviewViewRadios" Grid.Column="1" MaxColumns="4" SelectedIndex="0"
                                      VerticalAlignment="Center"
                                      SelectionChanged="PreviewViewRadios_SelectionChanged"
                                      ToolTipService.ToolTip="看原片 / 看处理效果 / 两者同时(整幅并排,预览跑完后**后台**合成一条对比片,合好自动切过去) / 左右对比(两个播放器实时裁切,分割线可拖,左原片右结果 —— 这条**不用等**合成)">
                            <!-- 【2026-09-22 无障碍/自测】四项原来都没有 AutomationId ⇒ 补 x:Name(注意**不能**叫
                                 ViewOriginal/ViewEffect/ViewBoth/ViewSplit —— 那些名字已被同名的 int 常量占用,会编译冲突)。
                                 可见文字本身就是它们给 UIA 的 Name,所以只补 id、不改显示。 -->
                            <RadioButton x:Name="ViewOriginalRadio" Content="看原片"/>
                            <RadioButton x:Name="ViewEffectRadio" Content="看处理效果"/>
                            <RadioButton x:Name="ViewBothRadio" Content="两者同时"/>
                            <RadioButton x:Name="ViewSplitRadio" Content="左右对比"/>
                        </RadioButtons>
                        <!-- 【2026-09-19 用户要求】原来的「放大画面」按钮(只是收起控制区,不是真缩放)已删除。
                             改成:鼠标滚轮在画面上缩放(1~8 倍、以光标为中心),这里只留一个「还原」;
                             还原按钮平时隐藏,只有放大过才出现 —— 不乱占地方。 -->
                        <!-- 【2026-09-19 已按用户要求回退】这里的缩放档位(适应/50%/100%/200%/400%)是
                             我按 Topaz 文档做的"整体缩放",**不是用户要的东西** ✗ —— 用户要的是:
                             「两者同时」里**两侧锁同一块区域**、**中间是边界**,缩放其中一个另一个跟着到同一处。
                             在做出那个之前,这里不再放任何缩放控件。
                             (缩放层/裁切框等结构保留但恒为恒等变换:不缩放时行为与改动前逐帧一致 ✔) -->
                        <!-- 【2026-09-23 用户要求:删掉「1:1 对比」】这一格原来放着那个按钮
                             (2026-09-19 加的"静止帧原画质对比":把原片与成片各取一帧、按各自原始像素 1:1 并排),
                             用户实测觉得没用 ⇒ **整套删除**:按钮 + 下面那个整屏 PixelCmpPanel + code-behind
                             里全部相关代码(含只被它调用的 CropFrameAsync / LoadPngAsync),
                             并把 4 处指向它的提示文案一起改掉(否则会叫人去点一个不存在的按钮)。
                             这一格现在空着:用户 2026-09-19 明确不要实时缩放控件,所以不放别的东西 ✔
                             【别再加回来】用户已经点过两次名(先加、后删) -->
                        <Button Grid.Column="3" Content="退出" Click="PreviewClose_Click" FontSize="13" Padding="16,7"
                                VerticalAlignment="Center" ToolTipService.ToolTip="退出回到列表"/>
                    </Grid>

                    <!-- ② 画面区:结果播放器在下层、原片在上层(对比时把原片裁到分割线左边)
                         【2026-09-19 结构还原】这里曾经被我包过一层"缩放层+裁切框",用户实测
                         "播放期间换视角会黑屏 卡住" ✗ —— 本文件早有的注释就写着"视频面(SwapChainPanel)对裁切有脾气",
                         多包的那层 + 给它设的裁切正是最可疑处 ⇒ **结构整个还原成原来的扁平结构**,缩放一并撤掉 ✔ -->
                    <Grid x:Name="PlayerArea" Grid.Row="1" Margin="14,0,14,8" SizeChanged="PlayerArea_SizeChanged"
                          Tapped="PlayerArea_Tapped" PointerMoved="PlayerArea_PointerMoved"
                          PointerWheelChanged="PlayerArea_Wheel">
                        <!-- 【2026-09-17 用户要求】提示文字放【最底层】:左边原片会自然盖住它,
                             于是它只在"没有结果的那一半"露出来 —— 不用按钮、也不会被中间那条分割线压住。 -->
                        <TextBlock x:Name="EffectPlayerHint" Text="点下面「开始预览」,处理结果会在这里播放"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12" Opacity="0.45" TextWrapping="Wrap"
                                   TextAlignment="Center" IsHitTestVisible="False"/>
                        <Grid x:Name="EffectPlayerHost" Visibility="Collapsed">
                            <MediaPlayerElement x:Name="EffectPlayer" AreTransportControlsEnabled="False" Stretch="Uniform"/>
                        </Grid>
                        <Grid x:Name="PreviewPlayerHost"
                              PointerMoved="PreviewPlayerHost_PointerMoved"
                              PointerExited="PreviewPlayerHost_PointerExited">
                            <MediaPlayerElement x:Name="PreviewPlayer" AreTransportControlsEnabled="False"/>
                        </Grid>
                        <!-- 【① 换视角不重装媒体 · 倒装】这两个"单视图专用"播放器常驻各自的源:
                             CmpPlayerTop = 「看原片」(源文件)、CmpPlayerBottom = 「看处理效果」(预览成片)。
                             它们**替代** PreviewPlayer/EffectPlayer 去服务单视图,而 PreviewPlayer/EffectPlayer
                             从此只服务「两者同时 / 左右对比」(对比子系统一字不改)⇒ 换视角只改可见性,零装载。
                             (指针事件与 PreviewPlayerHost 保持一致:自绘播放条靠它唤出) -->
                        <Grid x:Name="CmpPlayerHostBottom" Visibility="Collapsed"
                              PointerMoved="PreviewPlayerHost_PointerMoved"
                              PointerExited="PreviewPlayerHost_PointerExited">
                            <MediaPlayerElement x:Name="CmpPlayerBottom" AreTransportControlsEnabled="False" Stretch="Uniform"/>
                        </Grid>
                        <Grid x:Name="CmpPlayerHostTop" Visibility="Collapsed"
                              PointerMoved="PreviewPlayerHost_PointerMoved"
                              PointerExited="PreviewPlayerHost_PointerExited">
                            <MediaPlayerElement x:Name="CmpPlayerTop" AreTransportControlsEnabled="False" Stretch="Uniform"/>
                        </Grid>
                        <!-- 对比模式:左右两半的身份标签(带各自的画面规格,一眼看出分辨率/帧率差在哪) -->
                        <Border x:Name="CmpLabelLeft" Visibility="Collapsed" HorizontalAlignment="Left"
                                VerticalAlignment="Top" Margin="10" Padding="10,4" CornerRadius="4"
                                Background="#B30D0F14" IsHitTestVisible="False">
                            <TextBlock x:Name="CmpLabelLeftText" Text="原片" FontSize="12" Foreground="#E8ECF2"/>
                        </Border>
                        <Border x:Name="CmpLabelRight" Visibility="Collapsed" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="10" Padding="10,4" CornerRadius="4"
                                Background="#B3101318" IsHitTestVisible="False">
                            <TextBlock x:Name="CmpLabelRightText" Text="处理后" FontSize="12" Foreground="#7FB2FF"/>
                        </Border>
                        <!-- 对比片还在后台合成时的提示(压在两层画面之上,否则会被画面盖住看不见)
                             【2026-09-22 文案更新】原来写「正在生成对比画面…」—— 用户读成"生成 50% 画面",
                             因为它是和一句 `正在生成 50% 处的对比画面 37%` 配套的(两个百分号挨在一起)。
                             现在:说清是"后台合成**一条对比片**"、给**哪个视角**用,进度只留一个百分号。
                             文案的唯一出处是 VideoView.xaml.cs 的 CompareBuildText(改文案去那里改)。 -->
                        <Border x:Name="CmpBuildingText" Visibility="Collapsed" HorizontalAlignment="Center"
                                VerticalAlignment="Top" Margin="0,56,0,0" Padding="12,5" CornerRadius="4"
                                Background="#CC101318" IsHitTestVisible="False">
                            <TextBlock x:Name="CmpBuildingLabel" Text="正在后台合成对比片…" FontSize="12" Foreground="#E8ECF2"/>
                        </Border>
                        <!-- 【2026-09-19 结构还原】画面区**回到原来的扁平结构**(两层画面 + 标签 + 提示 + 分割线,
                             不再多包一层"裁切框/缩放层")。原因:用户实测"播放期间换视角会黑屏 卡住" ✗,
                             而本文件早有的注释就写着"视频面(SwapChainPanel)对裁切有脾气"——
                             多包的那层 + 我给它设的裁切,正是最可疑的那一处 ⇒ 结构整个还原,缩放一并撤掉 ✔ -->
                        <Grid x:Name="CompareSplitter" Width="28" HorizontalAlignment="Left" Visibility="Collapsed"
                              Background="Transparent"
                              PointerPressed="CompareSplitter_PointerPressed"
                              PointerMoved="CompareSplitter_PointerMoved"
                              PointerReleased="CompareSplitter_PointerReleased"
                              PointerCaptureLost="CompareSplitter_PointerReleased"
                              >   <!-- 【2026-09-18 用户要求"不要有提示"】分割线的悬停提示已按用户要求移除 ✔ -->
                            <Rectangle Width="1.2" Fill="#FFFFFF" Opacity="0.72" HorizontalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <Border x:Name="CmpSplitHandle" Width="26" Height="42" CornerRadius="13" Background="#D9FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    PointerPressed="CompareSplitter_PointerPressed"
                                    PointerMoved="CompareSplitter_PointerMoved">
                                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" IsHitTestVisible="False">
                                    <FontIcon Glyph="&#xE76B;" FontSize="9" Foreground="#FF12161C"/>
                                    <FontIcon Glyph="&#xE76C;" FontSize="9" Foreground="#FF12161C"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid x:Name="CompareSplitGhost" Width="10" HorizontalAlignment="Left" Visibility="Collapsed"
                              IsHitTestVisible="False">
                            <Rectangle Width="2" Fill="#FFE8A33D" Opacity="0.8" HorizontalAlignment="Center"/>
                        </Grid>
                        <!-- 对比模式专用:一套播放控件(自己画,盖在最上层;两个播放器自带的控件都关掉) -->
                        <!-- 布局:进度条独占一行(拉满),下一行才是 播放键 / 倍速 / 时间 —— 之前全挤在一行,太紧凑 -->
                        <Border x:Name="CompareBar" Visibility="Collapsed" VerticalAlignment="Bottom"
                                Margin="8,0,8,8" Padding="14,8" CornerRadius="8" Background="#E6101318"
                                HorizontalAlignment="Stretch" Opacity="0" IsHitTestVisible="False">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Slider Margin="-6,0,-11,0" x:Name="CmpSeek" Grid.Row="0" Minimum="0" Maximum="100" Value="0"
                                        StepFrequency="0.5" VerticalAlignment="Center"
                                        ValueChanged="CmpSeek_ValueChanged"
                                        ToolTipService.ToolTip="拖动定位:对比两边同时跳到同一时刻"/>
                                <Grid Grid.Row="1" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 【2026-09-22 无障碍】它是个纯图标按钮(FontIcon),UIA 实测 name="" ⇒ 屏幕阅读器
                                         读出"按钮"什么都没说。补 AutomationProperties.Name(不改外观)。
                                         【2026-09-22 用户要求"空格键的悬停提示不要有"】提示里原来还写着
                                         "…也可以直接点画面,或按空格" —— 现在只留"点画面"这条。
                                         注意:**空格键本身照旧能用**(见 PreviewSpaceAccel_Invoked / PreviewKeyDown),
                                         删掉的只是那句悬停文字,不是功能。 -->
                                    <Button x:Name="CmpPlayBtn" Grid.Column="0" Padding="18,4" VerticalAlignment="Center"
                                            Click="CmpPlayBtn_Click"
                                            AutomationProperties.Name="播放或暂停"
                                            ToolTipService.ToolTip="播放/暂停(对比两边同步;也可以直接点画面)">
                                        <FontIcon x:Name="CmpPlayIcon" Glyph="&#xE768;" FontSize="16"/>
                                    </Button>
                                    <!-- 慢放:补帧后的片段用来看补出来的中间帧(原速1× / 慢动作2× / 4× / 8×)
                                         放在播放键旁边(都是"怎么播"),时间单独留在最右边 —— 之前全挤在一行太紧凑 -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <ToggleButton x:Name="CmpRate1Btn" Content="原速1×" Tag="1" IsChecked="True" FontSize="12"
                                                      Padding="14,4" MinWidth="80" Click="CmpRate_Click"
                                                      ToolTipService.ToolTip="原速播放"/>
                                        <ToggleButton x:Name="CmpRate2Btn" Content="慢动作2×" Tag="0.5" FontSize="12"
                                                      Padding="14,4" MinWidth="80" Click="CmpRate_Click"
                                                      ToolTipService.ToolTip="半速(2 倍慢动作)—— 看补出来的中间帧"/>
                                        <ToggleButton x:Name="CmpRate4Btn" Content="慢动作4×" Tag="0.25" FontSize="12"
                                                      Padding="14,4" MinWidth="80" Click="CmpRate_Click"
                                                      ToolTipService.ToolTip="四分之一速(4 倍慢动作)"/>
                                        <ToggleButton x:Name="CmpRate8Btn" Content="慢动作8×" Tag="0.125" FontSize="12"
                                                      Padding="14,4" MinWidth="80" Click="CmpRate_Click"
                                                      ToolTipService.ToolTip="八分之一速(8 倍慢动作)"/>
                                    </StackPanel>
                                    <!-- 静音(用户要求:**默认静音**,且按键要能正常开关)
                                         上一版把"用户开关"和"慢动作自动静音"混成一个状态 → 慢动作下按钮怎么点都关不掉,
                                         已拆开:按钮是唯一真相,点了就生效;想听就自己打开(慢动作下会听到变调,是用户的选择) -->
                                    <ToggleButton x:Name="CmpMuteBtn" Grid.Column="2" FontSize="12" Padding="10,4"
                                                  Click="CmpMute_Click" HorizontalAlignment="Right" IsChecked="True"
                                                  AutomationProperties.Name="静音开关"
                                                  ToolTipService.ToolTip="当前:静音(默认)。点一下打开声音 —— 注意慢动作下打开会听到变调">
                                        <FontIcon x:Name="CmpMuteIcon" Glyph="&#xE74F;" FontSize="14"/>
                                    </ToggleButton>
                                    <TextBlock x:Name="CmpTime" Grid.Column="3" Text="0:00 / 0:00" FontSize="12"
                                               VerticalAlignment="Center" MinWidth="110" TextAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 【2026-09-23 用户要求:删掉「1:1 对比」】这里原本是 PixelCmpPanel(2026-09-19 加的
                         "静止帧原画质对比"整屏面板:标题 + 「取当前帧」+ 左右两格原生像素裁切图 + 说明行)。
                         用户实测觉得没用(原话「1:1对比这个功能简直没有用 删掉他」)⇒ 连同入口按钮与
                         code-behind 的实现一起整套删掉了,删除原因与清单写在 VideoView.xaml.cs 的对应注释里。 -->

                    <!-- ③ 裁剪页:一条时间线 + 首尾两个把手(拖动时画面跟着跳到那个点) -->                    <StackPanel x:Name="TrimDeck" Grid.Row="2" Margin="14,0,14,10" Spacing="8" Visibility="Collapsed">
                        <Grid x:Name="TrimTimeline" Height="52" Background="Transparent"
                              SizeChanged="TrimTimeline_SizeChanged"
                              PointerPressed="TrimTimeline_PointerPressed"
                              PointerMoved="TrimTimeline_PointerMoved"
                              PointerReleased="TrimTimeline_PointerReleased"
                              PointerCaptureLost="TrimTimeline_PointerReleased"
                              ToolTipService.ToolTip="拖左把手=入点 · 拖右把手=出点 · 拖的时候画面跟着跳到那个点">
                            <Border Height="16" CornerRadius="4" Background="#2A3240"
                                    Margin="0,20,0,0" VerticalAlignment="Top"/>
                            <Border x:Name="TrimRange" Height="16" CornerRadius="4" Background="#4C8DFF"
                                    Margin="0,20,0,0" VerticalAlignment="Top"
                                    HorizontalAlignment="Left" Width="0"/>
                            <Border x:Name="TrimStartThumb" Width="16" Height="26" CornerRadius="3" Background="#E8ECF2"
                                    VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,15,0,0"/>
                            <Border x:Name="TrimEndThumb" Width="16" Height="26" CornerRadius="3" Background="#E8ECF2"
                                    VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,15,0,0"/>
                            <Canvas x:Name="TrimTicks" Height="16" VerticalAlignment="Bottom"
                                    HorizontalAlignment="Stretch" IsHitTestVisible="False"/>
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TrimInfo" Text="未裁剪" FontSize="11" Opacity="0.8"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="DupToggleBtn" Content="重复帧 ▾" FontSize="12" Padding="12,7"
                                        Visibility="Collapsed" Click="ToggleDup_Click"
                                        ToolTipService.ToolTip="重复帧分布分析(只在需要治理重复帧时用,平时收起)"/>
                                <Button x:Name="ClearTrimBtn" Content="清除裁剪" FontSize="12" Padding="12,7"
                                        Click="ClearTrim_Click" ToolTipService.ToolTip="清除这个视频的裁剪范围(整段都保留)"/>
                                <Button x:Name="SaveTrimBtn" Content="应用裁剪" FontSize="12" Padding="16,7"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="ApplyTrim_Click"
                                        ToolTipService.ToolTip="把这段范围应用到视频:导出时只输出这一段"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ④ 预览页:时间线(拖起点) + 精调 + 一行动作 -->
                    <StackPanel x:Name="PreviewDeck" Grid.Row="3" Margin="14,0,14,10" Spacing="8" Visibility="Collapsed">
                        <Grid x:Name="PrevTimeline" Height="52" Background="Transparent"
                              SizeChanged="PrevTimeline_SizeChanged"
                              PointerPressed="PrevTimeline_PointerPressed"
                              PointerMoved="PrevTimeline_PointerMoved"
                              PointerReleased="PrevTimeline_PointerReleased"
                              PointerCaptureLost="PrevTimeline_PointerReleased"
                              ToolTipService.ToolTip="拖蓝线=选起点 · 拖右端白把手=改长度 · ←/→ 一帧 · PageUp/PageDown 一秒">
                            <Border Height="16" CornerRadius="4" Background="#2A3240"
                                    Margin="0,20,0,0" VerticalAlignment="Top"/>
                            <Border x:Name="PrevRangeBar" Height="16" CornerRadius="4" Background="#3E6FBF"
                                    Margin="0,20,0,0" VerticalAlignment="Top"
                                    HorizontalAlignment="Left" Width="0"/>
                            <Border x:Name="PrevEndGrip" Width="14" Height="24" CornerRadius="3" Background="#E8ECF2"
                                    VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                            <Grid x:Name="PrevHeadGrip" Width="20" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Rectangle Width="2" Height="38" Fill="#7FB2FF" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,14,0,0"/>
                                <Border Width="16" Height="14" CornerRadius="3" Background="#7FB2FF"
                                        HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            </Grid>
                            <Canvas x:Name="PrevTicks" Height="16" VerticalAlignment="Bottom"
                                    HorizontalAlignment="Stretch" IsHitTestVisible="False"/>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="起点" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                <TextBlock x:Name="EffectStartValueText" Text="00:00.0" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" MinWidth="52"/>
                                <Button x:Name="EffectNudgeDownBtn" Content="−0.1" FontSize="11" Padding="8,4"
                                        Click="EffectStartNudge_Click" Tag="-0.1"
                                        ToolTipService.ToolTip="起点后退 0.1 秒(拖不准时用它)"/>
                                <Button x:Name="EffectNudgeUpBtn" Content="+0.1" FontSize="11" Padding="8,4"
                                        Click="EffectStartNudge_Click" Tag="0.1"
                                        ToolTipService.ToolTip="起点前进 0.1 秒(拖不准时用它)"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="这一段多长" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                <Button x:Name="EffectLenChip2" Content="2 秒" Tag="2" FontSize="11" Padding="10,4"
                                        Click="EffectLenChip_Click"/>
                                <Button x:Name="EffectLenChip3" Content="3 秒" Tag="3" FontSize="11" Padding="10,4"
                                        Click="EffectLenChip_Click"/>
                                <Button x:Name="EffectLenChip5" Content="5 秒" Tag="5" FontSize="11" Padding="10,4"
                                        Click="EffectLenChip_Click"/>
                                <Button x:Name="EffectLenChip10" Content="10 秒" Tag="10" FontSize="11" Padding="10,4"
                                        Click="EffectLenChip_Click"/>
                                <Button x:Name="EffectLenChip15" Content="15 秒" Tag="15" FontSize="11" Padding="10,4"
                                        Click="EffectLenChip_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="EffectRangeText" Grid.Column="2" Text="" FontSize="11" Opacity="0.75"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="EffectRunBtn" Content="开始预览" FontSize="12" Padding="16,7"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="EffectRunBtn_Click"
                                        ToolTipService.ToolTip="用左侧当前参数只跑这一段(可随时「取消」;跑完自动切到对比画面播放)"/>
                                <Button x:Name="SavePreviewBtn" Content="保存此预览" FontSize="12" Padding="12,7"
                                        IsEnabled="False" Click="SavePreview_Click"
                                        ToolTipService.ToolTip="把这次预览的成片保存到你指定的位置(视频文件,和全片处理同一套参数/画质)"/>
                                <!-- 用户要求:取消做成红色按钮(破坏性动作,一眼可辨) -->
                                <Button x:Name="EffectCancelBtn" Content="取消" FontSize="12" Padding="12,7"
                                        IsEnabled="False" Click="EffectCancelBtn_Click"
                                        Background="#FFE5484D" Foreground="White" BorderThickness="0"
                                        ToolTipService.ToolTip="中止这次预览(已跑的部分会被丢掉)"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <ProgressBar x:Name="EffectProgress" Width="170" Minimum="0" Maximum="100" Value="0"/>
                                <TextBlock x:Name="EffectDirtyHint" Text="参数已改动 · 点「重新预览」看新效果" FontSize="11"
                                           Foreground="#E8A33D" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock x:Name="EffectStatusText" Text="" FontSize="11" Opacity="0.8"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <ComboBox x:Name="EffectVideoCombo" Grid.Column="2" Width="210" FontSize="12"
                                      DisplayMemberPath="Name" PlaceholderText="选择素材"
                                      VerticalAlignment="Center"
                                      SelectionChanged="EffectVideoCombo_SelectionChanged"
                                      ToolTipService.ToolTip="要预览的素材:默认是右侧列表里选中的那个,也可以在这里直接换"/>
                        </Grid>
                    </StackPanel>

                    <!-- ⑤ 裁剪页的「重复帧」工具行(默认收起) -->
                    <Border x:Name="DupToolsPanel" Grid.Row="4" Visibility="Collapsed"
                            Margin="14,0,14,12" Padding="10" CornerRadius="6"
                            Background="#33222A38" BorderBrush="#3A4150" BorderThickness="1">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="重复帧:分析整片的重复帧分布,可据此一键设置去重(只影响「开始处理」时的去重策略)"
                                       FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
                            <Grid Grid.Row="1" RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DupSummaryText" Text="" FontSize="11" Opacity="0.75"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="AnalyzeDupBtn" Content="分析重复帧" FontSize="11" Padding="8,4"
                                                Click="AnalyzeDupBtn_Click"
                                                ToolTipService.ToolTip="全文分析当前视频的重复帧分布(只做预估,不精确):为求速度会把画面缩到 400 宽灰度再采样,且智能模式这里用「自适应判据」预估,而真正处理时走「拍数识别+网格采样」——所以数字是估计值,与处理结果可能有小幅差异"/>
                                        <Button x:Name="ApplyDupBtn" Content="据此设置去重" FontSize="11" Padding="8,4"
                                                Click="ApplyDupBtn_Click"
                                                ToolTipService.ToolTip="按分析结果推荐去重模式/强度,并自动勾选去重"/>
                                    </StackPanel>
                                </Grid>
                                <Canvas x:Name="DupStrip" Grid.Row="1" Height="10" VerticalAlignment="Center"
                                        Background="Transparent" SizeChanged="DupStrip_SizeChanged"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
