<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="ALHPro.Views.VideoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 【蓝色「测试」小药丸 · 2026-09-15 第二次改小】给两支**自训**模型(游戏 · game2x / 现实 · real2x)用的标记。
             【命名 · 用户定稿】这两支在界面上写作「游戏」「现实」+ 英文名(`类别 · 名字`;
             名字 = `game2x` / `real2x`,与权重文件名 alhpro-game2x / alhpro-real2x 的后缀一字不差),
             **不出现"实验/实验性"字样**;括号里写**速度档**(`快`,见 Core.ExperimentalEsrgan.SpeedTier)——
             【2026-09-16 用户定稿】"括号内要写快 而不是时间":括号与官方项用同一套词(`快`/`中`/`超慢`),
             测出来的秒/帧数字挪到悬停提示与下拉下方那行提示里(那两处才是写数字的地方)。
             为什么还要标记:它们不是官方权重(自己训练的),与官方互有胜负 —— 三档色偏都低于官方,
             细节/锐度多数低于官方默认模型,所以这一项绝不能只写模型名了事。
             小标文字仍是「测试」(用户 2026-09-15:先保留,是否改由用户定)。
             【尺寸 · 用户 2026-09-15 收尾要求「更小更简约」】原来是 FontSize 12 + Padding 6,1 + 圆角 7 + 1px 蓝描边,
             整行(项内文字 + 间距 6 + 药丸 33)会顶到 218px,而收起状态可用宽度只有约 212px ⇒ 会被裁。
             现改为 **FontSize 11 + Padding 4,0 + 圆角 4 + 无描边**,药丸宽 33 → 26px。
             【宽度 · 2026-09-16 起余量最大】项内文字现在是 `现实 · real2x（快）` / `游戏 · game2x（快）`
             (2026-09-15 那版 `…（0.35s/帧）` 实测整行 192 / 205px;更早的中文名版 211px,压线),
             括号里只需放一个档词,离 212px 上限更远。
             配色也压暗一档(#2A3E63/#A8C8FF → #232E42/#8FA9D6),不再抢模型名。
             两个样式被下面两支模型的 ComboBoxItem 共用(改一处即可,别在项里内联颜色)。 -->
        <Style x:Key="TestBadgePill" TargetType="Border">
            <Setter Property="Background" Value="#232E42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TestBadgeText" TargetType="TextBlock">
            <Setter Property="Text" Value="测试"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8FA9D6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 【宽度回退 410 → 300 · 2026-09-14 用户反馈】
                 加宽面板会把右侧任务列表挤窄,用户要求"缩回去、改成把括号内容简写"。
                 于是恢复原宽,并把该面板里**所有**超过可用宽度的标签统一缩写
                 (可用宽度 ≈ 300 − 32(面板留白) − 56(边框+下拉箭头) = 212px,用界面字体实测):
                   旧「通用 · general-wdn-x4v3（5MB · 快）」258px → 新「通用 · wdn-x4v3（快）」~161px
                   旧「nlmeans + hqdn3d（空间域与时间域联合降噪,推荐）」355px → 新「nlmeans + hqdn3d（推荐）」~150px
                 体积/耗时档没丢:改放模型下拉的 ToolTip(悬停可见),见下面 VideoEsrganModelCombo。 -->
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource AppPanelBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="12" Margin="0,0,10,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="14,16" Spacing="14">

                    <TextBlock Text="输入" Style="{StaticResource SectionTitle}"/>
                    <Button x:Name="PickVideoBtn" Content="选择视频文件(可多选)..." Click="PickVideoBtn_Click"
                            HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="VideoInfo" Text="未选择视频"
                               Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="裁剪:在右侧选中视频后可设置开始/结束时间" Style="{StaticResource HintText}"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <TextBlock Text="视频超分" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="UpscaleToggle" Content="启用超分(逐帧放大)" ToolTipService.ToolTip="逐帧 AI 放大画面"
                              IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed"/>

                    <TextBlock Text="超分引擎" Style="{StaticResource SectionTitle}"/>
                    <!-- 【顺序:Real-ESRGAN 在上、waifu2x 在下】(用户要求)列表顺序只影响界面,
                         存盘值仍用旧约定(0=waifu2x / 1=realesrgan),转换在 VideoView 的 EngineFromStored/EngineToStored,
                         这样老用户已保存的选择不会被翻转。 -->
                    <RadioButtons x:Name="VideoEngineRadios" SelectedIndex="0" ToolTipService.ToolTip="超分引擎:Real-ESRGAN 会主动合成细节(动漫/写实都明显变清晰);waifu2x 只做去噪/去压缩块 —— 干净素材上看起来≈单纯放大,只适合有噪点的老片源"
                                  SelectionChanged="Combo_Changed">
                        <RadioButton Content="Real-ESRGAN"/>
                        <RadioButton Content="waifu2x"/>
                    </RadioButtons>
                    <TextBlock x:Name="VideoModelLabel" Text="超分模型" Style="{StaticResource SectionTitle}"/>
                    <ComboBox x:Name="VideoWaifu2xModelCombo" ToolTipService.ToolTip="waifu2x 模型(动漫/通用/现实)"
                              SelectionChanged="Combo_Changed">
                        <!-- 【标签长度 · 2026-09-14】第 2 项原来写全名 `models-upconv_7_anime_style_art_rgb`,
                             界面字体实测 398px —— 比加宽后的下拉(可用 ~322px)还长,必然被裁。
                             改成 `upconv_7_anime`:与「预设摘要」里既有的叫法(`动漫·upconv_7_anime`,
                             见 VideoView.xaml.cs 的 UpWaifu2xModelNames)一致,长度 ~250px 可完整显示。
                             Tag 仍是引擎要的目录全名,不受显示名影响。 -->
                        <ComboBoxItem Content="通用 · cunet（24MB·中）" Tag="models-cunet"
                                      ToolTipService.ToolTip="通用 · cunet:官方 waifu2x 引擎的默认模型(不指定 -m 时就是它,出处:waifu2x-ncnn-vulkan README);架构比 upconv_7 新、更慢但更干净。&#x0a;适用:通用画面,动漫与实拍都能用。&#x0a;速度:1080p 约 0.37 秒/帧(2x,-n0)。&#x0a;模型大小:24 MB。"/>
                        <ComboBoxItem Content="动漫 · upconv_7_anime（快）" Tag="models-upconv_7_anime_style_art_rgb"
                                      ToolTipService.ToolTip="动漫 · upconv_7_anime:官方 waifu2x 面向动漫的模型(项目定位原文「Image Super-Resolution for Anime-style art」);upconv_7 是较早的架构,比 cunet 快、画面略软。&#x0a;适用:动漫 / 线稿类图像。&#x0a;模型大小:5.3 MB。"/>
                        <ComboBoxItem Content="现实 · upconv_7_photo（快）" Tag="models-upconv_7_photo"
                                      ToolTipService.ToolTip="现实 · upconv_7_photo:官方 waifu2x 的照片模型(README 原文「And it supports photo.」,使用时需指定 models/photo)。&#x0a;适用:实拍照片。&#x0a;速度:1080p 约 1.29 秒/帧(2x)。&#x0a;模型大小:5.3 MB。"/>
                    </ComboBox>
                    <ComboBox x:Name="VideoEsrganModelCombo" Visibility="Collapsed"
                              ToolTipService.ToolTip="Real-ESRGAN 模型(按速度与体积从快到慢排列):悬停每一项看官方说明、速度与模型大小。&#x0a;末尾两项是自训的 2x 模型(游戏 · game2x / 现实 · real2x,带蓝色「测试」标)。"
                              SelectionChanged="Combo_Changed">
                        <!-- 【标签长度 · 2026-09-14 用户反馈"下拉框被遮挡"】左栏内部留白吃掉约 104px,
                             即使左栏加宽到 410,ComboBox 也只有 306px ⇒ 文字可用宽度 ~250px。
                             用界面字体(微软雅黑 14px)实测带厂商前缀的老写法最长达 310px,收起状态必被裁。
                             所以去掉冗余前缀(`realesr-` / `realesrgan-` / `models-`;引擎名由上面的
                             「超分引擎」与 ToolTip 说明,预设摘要里也一直是这个短叫法),现在最长 ~240px ✓。
                             ⚠ 读模型名一律走 Tag(引擎要的全名),不许改成读 Content —— 见 VideoView.xaml.cs 的 SelModel。 -->
                        <ComboBoxItem Content="动漫 · animevideov3（快）" Tag="realesr-animevideov3"
                                      ToolTipService.ToolTip="动漫 · animevideov3:官方把它归在「For Animation Videos」,原文描述「Anime video model with XS size」(出处:Real-ESRGAN docs/anime_video_model.md)。&#x0a;专为动漫视频训练、体积最小最快的一档,动漫长视频首选。&#x0a;速度:1080p 约 0.26~0.30 秒/帧。&#x0a;模型大小:3.8 MB(含 x2 / x3 / x4 三份权重)。&#x0a;注:官方文档写它支持 X1,但本机实测 1x 输出全黑(缺 x1 权重)⇒ 请用 2x 及以上。"/>
                        <ComboBoxItem Content="通用 · general-x4v3（快）" Tag="realesr-general-x4v3"
                                      ToolTipService.ToolTip="通用 · general-x4v3:官方原文「A tiny small model (consume much fewer GPU memory and time); not too strong deblur and denoise capacity」(出处:Real-ESRGAN docs/model_zoo.md)。&#x0a;体积小、显存占用低;去模糊与去噪能力偏弱。&#x0a;速度:1080p 约 0.458 秒/帧。&#x0a;模型大小:4.9 MB。"/>
                        <!-- ↓ 第 3 项(序号 2):自转的带降噪通用模型。**这一行绝不能少** ——
                             2026-09-14 重排时曾漏掉它(只留了注释),结果下拉里 5 项变 4 项,
                             而 VideoModelOrder 仍按 5 项映射(Rev2 的 4→新 2),老用户存的序号会被解释成错的模型。
                             是"看真实界面截图"才发现的;以后改这个下拉,必须用界面确认 5 项都在且顺序如上。 -->
                        <ComboBoxItem Content="通用 · wdn-x4v3（快）" Tag="realesr-general-wdn-x4v3"
                                      ToolTipService.ToolTip="通用 · wdn-x4v3:权重取自上游官方 release v0.2.5.0(BSD 3-Clause,作者 xinntao 本人发布),由本项目自行转成 ncnn;官方用途同为「For General Images」。&#x0a;与 general-x4v3 同族同架构,带 WDN 去噪训练,游戏 / 动漫素材细节略多。&#x0a;速度:1080p 约 0.460 秒/帧。&#x0a;模型大小:4.9 MB。"/>
                        <!-- 【顺序 · Rev3 · 2026-09-14 用户要求】整个下拉按**速度与体积**排(快/小 → 慢/大):
                             0 realesr-animevideov3 4MB 0.26~0.30 秒/帧
                             1 realesr-general-x4v3  5MB 0.458 秒/帧
                             2 realesr-general-wdn-x4v3 5MB 0.460 秒/帧(新加,自转;实测 20 帧批跑与 general 差 0.42%)
                             3 realesrgan-x4plus-anime 9MB 3.85 秒/帧
                             4 realesrgan-x4plus      33.5MB 15.145 秒/帧(超慢,稳居最后)
                             ⚠【换位 = 改序号,必须迁移】Rev2 的 wdn 在第 4 位(当时是"末尾追加"最安全),
                             这次它要挪到第 2 位 ⇒ 映射 2→3、3→4、4→2,0/1 不变。
                             迁移已抽到 AlhPro.Core.VideoModelOrder(纯函数 + 单测),VideoView.xaml.cs 的
                             MigrateEsrganModelOrder 调用它;读设置与读预设都走那条路。
                             不迁移的后果:老用户"存的 2 = x4plus-anime"会静默变成 2 = wdn-x4v3。
                             以后若再调顺序:必须 +1 Rev、加一段映射、同步改这里与 UpEsrganModelNames。 -->
                        <ComboBoxItem Content="动漫 · x4plus-anime（中）" Tag="realesrgan-x4plus-anime"
                                      ToolTipService.ToolTip="动漫 · x4plus-anime:官方把它归在「For Anime Images / Illustrations」,原文「Optimized for anime images; 6 RRDB blocks (smaller network)」(出处:Real-ESRGAN docs/model_zoo.md)。&#x0a;官方定位是动漫插画 / 静态图,长视频请用 animevideov3。&#x0a;速度:1080p 约 3.3~4.4 秒/帧。&#x0a;模型大小:9.0 MB。"/>
                        <!-- 「通用 · realesrgan-x4plus」按体积(33.5MB)与耗时(最慢)排在最后,并红字标出"超慢"
                             (用户要求:不删除、只警示)。
                              依据(2026-09-11 本机 4060 Laptop 实测,源 1920×1080 每帧):x4plus 14.48s / x4plus-anime 4.84s /
                              animevideov3 0.84s;x4plus 还有"只有 4x 权重"的问题(选 2x 也照样全量算 4x 再缩回)。
                              注:本项 Content 是 StackPanel(富文本),读模型名一律走 Tag —— 不要改成读 Content。 -->
                        <ComboBoxItem Tag="realesrgan-x4plus"
                                      ToolTipService.ToolTip="通用 · x4plus:官方把它归在「For General Images」,原文「X4 model for general images」(出处:Real-ESRGAN docs/model_zoo.md)。&#x0a;只有 4x 权重:选 2x / 3x 也会全量按 4x 算再缩回。&#x0a;速度:1080p 约 15.9 秒/帧(本机 30 帧批跑;同机 4 次样本 10.2~19.1,差异来自笔记本 GPU 降频)。&#x0a;模型大小:33.5 MB(旧文案写的 41MB 与磁盘实测不符,已改正)。&#x0a;建议只在单张图片上用。">
                            <!-- 「慢」直接在括号里改成红字「超慢」,不再另挂一个红字标记(用户:冗余了) -->
                            <StackPanel Orientation="Horizontal" Spacing="0">
                                <TextBlock Text="通用 · x4plus（" VerticalAlignment="Center"/>
                                <TextBlock Text="超慢" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#E5484D"/>
                                <TextBlock Text="）" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <!-- ===== 【Rev4 · 2026-09-15】末尾**追加**两支自训的 2x 模型(序号 5=现实向、6=游戏向)=====
                             为什么追加在最后而不是插到中间:追加不动老序号 ⇒ Rev4 的迁移是**恒等映射**,
                             老用户存的 0~4 升级后仍然指向同一支模型(Rev2 期间加 wdn 用的也是这个手法)。
                             【命名 · 用户 2026-09-15 定稿 · 第三次改英文名】文字要**跟已有各项同一个格式**
                             —— `类别 · 名字（括号内速度）`(已有项:`动漫 · animevideov3（快）` / `通用 · x4plus（超慢）`),
                             所以这两项写成 `现实 · real2x（快）` / `游戏 · game2x（快）`;
                             类别用「游戏」/「现实」,**名字用英文**(= 权重文件名后缀 real2x / game2x),
                             括号里写**速度档**(「快」,口径见 Core.ExperimentalEsrgan.SpeedTier)——【2026-09-16 用户定稿】"括号内要写快 而不是时间",**不许出现"实验"**。
                             权重文件:engines\realesrgan\models\alhpro-real2x.param/.bin、alhpro-game2x.param/.bin
                             ⚠ Tag 必须与文件名一字不差:引擎按 `models/{Tag}.param` 取权重(视频路径下发的是
                               `-m models -n {Tag}`,见 EngineService.UpscaleDirAsync;实测这两支名字不在引擎内置表里,
                               所以它**不会**被追加 -x{scale} 后缀)。
                             ⚠ 只有 2x 原生权重:3x/4x 目标由 Core.EngineScalePolicy 固定按 2x 跑再放大到目标
                               (实测给 2x 权重下发 -s 4 会输出**镜像平铺的错帧**、exit=0 不报错)。
                             ⚠ 【R/B 缺陷 · 2026-09-15 **已修好**,别把旧说法抄回来】这两份导出权重曾经 **R/B 通道颠倒**
                               (旧实测:源 R143/G110/B92、官方 R143/G111/B89、本模型 R94/G111/B137,画面整幅偏蓝)。
                               本轮**重训 + 重新导出**后通道验收闸已 PASS(现实向 Δ+0.20/+0.34/+0.24、
                               游戏向 Δ+0.11/+0.12/+0.18,判据「每通道差 小于 5」;多宽度 1920/2048/2348/2560 全过)
                               ⇒ 界面文案里**不得再出现"偏蓝 / R-B 颠倒 / 需重新导出 / 不可用于正片"**。
                               两处文案与 Core.ExperimentalEsrgan 里的**逐字相同**(有单测钉住),改时一起改。
                             ⚠ Content 是 StackPanel(富文本 + 蓝色「测试」药丸),读模型名一律走 Tag —— 别改成读 Content。 -->
                        <ComboBoxItem Tag="alhpro-real2x" AutomationProperties.Name="现实 · real2x（快）测试">
                            <!-- 【可访问性 · 2026-09-15】这两项(以及上面的 x4plus 项)的 Content
                                 是 StackPanel(富文本),UIA 算出来的 Name 是**空**的 —— 读屏软件念不出选了什么,
                                 自动化脚本也只能靠猜序号。这里显式给一个名字,把"类别 · 名字/速度口径/测试标"都带上
                                 (UIA 名字不受下拉宽度限制,所以给全,含 1080p 口径)。
                                 【宽度 · 2026-09-15 真机截图实测】项内文字同时用于收起状态,而收起状态可用宽度约 212px
                                 ⇒ 项内只写一个速度档词("快"),秒/帧与口径放在悬停提示与下方提示里。
                                 【命名 · 用户定稿】文字里**不许出现"实验"**;括号里是**快慢档形容词**(「快」),不是秒/帧(那个数字放在悬停提示里)。 -->
                            <ToolTipService.ToolTip>现实 · real2x:三档色偏都低于官方 —— 实拍 1.48(官方 6.34)、动漫帧 0.18(官方 2.73)、游戏帧 0.34(官方 2.00)。&#x0a;细节与锐度多数低于官方默认模型(实拍 59.13 对 73.66、动漫帧 1.83 对 2.06;只在游戏帧上 3.20 略高于官方 2.91)。&#x0a;适合优先要颜色准确、能接受略软画面时使用。&#x0a;通道验收(2026-09-15 重训+重新导出):引擎输出与源的逐通道均值差 R+0.20/G+0.34/B+0.24 级,判据「每通道差 小于 5」通过(旧导出那次 R/B 颠倒已修)⇒ 颜色与源一致,可直接用于正片。&#x0a;速度:1080p 约 0.35 秒/帧(40 帧 1080p 目录批跑 -j 1:1:1 -t 0 冷态,与官方 animevideov3 同档)。&#x0a;倍率:网络原生 2x(放大倍数写死在网络里)。软件的 2x/3x/4x 是目标输出尺寸:选 3x/4x 时仍按原生 2x 跑一遍、再把成片缩放到目标(不是把引擎跑两遍);实测同一段 24 帧素材超分阶段 2x=2.0s、3x=3.9s、4x=4.7s(官方 animevideov3 有原生 3x/4x 权重,同样条件只要 2.2/2.3/2.8s),画面≈2x 细节放大、清晰度不会真的变成 3x/4x。推荐用 2x。&#x0a;模型大小:2.4 MB(权重 alhpro-real2x.bin 2.29 MB + alhpro-real2x.param 2 KB,本机磁盘实测)。</ToolTipService.ToolTip>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="现实 · real2x（快）" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource TestBadgePill}">
                                    <TextBlock Style="{StaticResource TestBadgeText}"/>
                                </Border>
                            </StackPanel>
                        </ComboBoxItem>
