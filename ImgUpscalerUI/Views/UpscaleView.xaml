<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="ALHPro.Views.UpscaleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ALHPro.Views"
    mc:Ignorable="d">

    <!-- 内容区(背景由 MainPage 统一,这里只做内部圆角卡片) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 参数面板 -->
            <ColumnDefinition Width="300"/>
            <!-- 右侧:图片列表 + 预览 -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 参数面板(圆角卡片) ============ -->
        <Border Grid.Column="0" Background="{StaticResource AppPanelBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="12" Margin="0,0,10,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="14,16" Spacing="14">

                    <TextBlock Text="输入" Style="{StaticResource SectionTitle}"/>
                    <Button x:Name="PickBtn" Content="添加图片(可多选)..." Click="PickBtn_Click"
                            HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="FileInfo" Text="未添加图片" Style="{StaticResource HintText}"
                               TextTrimming="CharacterEllipsis"/>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <TextBlock Text="超分引擎" Style="{StaticResource SectionTitle}"/>
                    <!-- 顺序与视频页一致:Real-ESRGAN 在上(索引 0)、waifu2x 在下(索引 1)。
                         存盘仍用旧约定(0=waifu2x / 1=Real-ESRGAN),换算见 UpscaleView 的 ModeFromStored/ModeToStored,
                         默认选中保持"动漫(waifu2x)"不变(SelectedIndex=1)。 -->
                    <RadioButtons x:Name="ModeRadios" SelectedIndex="1"
                                  ToolTipService.ToolTip="算法模式:动漫插画用 waifu2x;真实照片用 Real-ESRGAN">
                        <RadioButton Content="Real-ESRGAN"/>
                        <RadioButton Content="waifu2x"/>
                    </RadioButtons>

                    <StackPanel x:Name="ModelPanel" Spacing="6">
                        <TextBlock x:Name="ModelLabel" Text="超分模型" Style="{StaticResource SectionTitle}"/>
                        <ComboBox x:Name="ModelCombo" HorizontalAlignment="Stretch"
                                  SelectedIndex="0"
                                  ToolTipService.ToolTip="超分模型(动漫:waifu2x;照片:Real-ESRGAN)"/>
                    </StackPanel>

                    <TextBlock Text="放大倍数" Style="{StaticResource SectionTitle}"/>
                    <RadioButtons x:Name="ScaleRadios" SelectedIndex="1"
                                  ToolTipService.ToolTip="放大倍数:输出尺寸 = 原图 × 倍数(1x 超分 = 先 2x 超分再缩回原尺寸,画质更好)">
                        <RadioButton x:Name="Scale1xRadio" Content="1x 超分（2x 放大后缩回）"/>
                        <RadioButton x:Name="Scale2xRadio" Content="2x"/>
                        <RadioButton x:Name="Scale3xRadio" Content="3x"/>
                        <RadioButton x:Name="Scale4xRadio" Content="4x"/>
                    </RadioButtons>
                    <TextBlock x:Name="ScaleHint" FontSize="10" Opacity="0.6"
                               Foreground="#E8A33D" TextWrapping="Wrap"
                               Text="当前模型不支持 3x/4x 倍率(已置灰);倍率由引擎内置权重决定,请选择灰色项以外的倍数"
                               Visibility="Collapsed"/>

                    <StackPanel x:Name="NoisePanel" Spacing="6">
                        <TextBlock Text="降噪级别" Style="{StaticResource SectionTitle}"/>
                        <ComboBox x:Name="NoiseCombo" HorizontalAlignment="Stretch"
                                  SelectedIndex="0"
                                  ToolTipService.ToolTip="降噪级别:不降噪/弱/中/强(仅动漫模式 waifu2x 生效)">
                            <ComboBoxItem Content="不降噪"/>
                            <ComboBoxItem Content="弱"/>
                            <ComboBoxItem Content="中"/>
                            <ComboBoxItem Content="强"/>
                        </ComboBox>
                        <TextBlock x:Name="NoiseHint" FontSize="10" Opacity="0.6"
                                   Foreground="#E8A33D" TextWrapping="Wrap"
                                   Text="Real-ESRGAN 不支持降噪,可用下方「预处理降噪」弥补"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- 照片模式弥补:预处理降噪(waifu2x cunet 先降噪,再超分) -->
                    <StackPanel x:Name="PhotoDenoisePanel" Spacing="6" Visibility="Collapsed">
                        <CheckBox x:Name="PreDenoiseCheck"
                                  Content="预处理降噪 (waifu2x)"
                                  ToolTipService.ToolTip="照片模式专属:先降噪再超分,适合噪点多的照片(Real-ESRGAN 本身不降噪)"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="强度" FontSize="11" Opacity="0.7"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="DenoiseLevelCombo" SelectedIndex="0" Width="100"
                                      ToolTipService.ToolTip="预处理降噪强度:弱/中/强">
                                <ComboBoxItem Content="弱"/>
                                <ComboBoxItem Content="中"/>
                                <ComboBoxItem Content="强"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <!-- 增强:与视频页后处理一致(紧凑滑块行,只留一个总重置) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="增强" Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="EnhanceResetBtn" Grid.Column="1" Content="重置"
                                FontSize="11" Padding="12,4" Click="EnhanceResetBtn_Click"
                                ToolTipService.ToolTip="把所有增强参数恢复默认"/>
                    </Grid>
                    <StackPanel Spacing="2">
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="去雾:暗通道先验去雾,去除雾霾/逆光灰蒙。⚠ 只对真有雾/灰蒙蒙的图有效,没雾的图开了只会变灰变脏。本版已把强度压到实测有效区间(拉满 = 最彻底,约在 87 处效果最好)">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="去雾" VerticalAlignment="Center"/>
                            <Slider x:Name="DehazeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    Value="0" StepFrequency="5"/>
                            <TextBlock x:Name="DehazeValue" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="减少杂色:中值滤波去噪点/颗粒,保边缘不糊(先降噪再做锐化最稳)。强度是连续力度:20~30 只轻抹颗粒,70 以上才接近「彻底」。⚠ 3×3 中值会抹掉 1 像素宽的细线/发丝(强度 50 时留一半、100 时全没)">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="减少杂色" VerticalAlignment="Center"/>
                            <Slider x:Name="DenoiseSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    Value="0" StepFrequency="5"/>
                            <TextBlock x:Name="DenoiseValue" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="锐化:亮度域小半径锐化 + 按边缘强度加权 —— 强边缘多给、平坦区与细纹理少给,不会出彩色描边(实测同强度下白边比「钝化蒙版」少一半)。想要更利落用它,想要更保险用「钝化蒙版」">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="锐化" VerticalAlignment="Center"/>
                            <Slider x:Name="SharpenSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    Value="0" StepFrequency="5"/>
                            <TextBlock x:Name="SharpenValue" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="清晰:大范围局部对比,但只作用在中间调 —— 暗部与高光几乎不动,提的是通透感而不是锐度(所以高光边缘不会被顶白)">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="清晰" VerticalAlignment="Center"/>
                            <Slider x:Name="ClaritySlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    Value="0" StepFrequency="5"/>
                            <TextBlock x:Name="ClarityValue" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="钝化蒙版:经典做法 —— 逐通道反锐化,带阈值保护(平坦区、弱噪声不动)。三档锐化里最标准的一个,拿不准就用它">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="钝化蒙版" VerticalAlignment="Center"/>
                            <Slider x:Name="UsmSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    Value="0" StepFrequency="5"/>
                            <TextBlock x:Name="UsmValue" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="保留细节:自适应直方图均衡(CLAHE),提的是局部明暗层次 —— 六个档里唯一天生不出白边的(实测白边像素 ≈0),边缘也几乎无损。⚠ 它提的不是「锐度」,拉普拉斯细节指标看不出变化,得看图">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="保留细节" VerticalAlignment="Center"/>
                            <Slider x:Name="DetailSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    Value="50" StepFrequency="5"/>
                            <TextBlock x:Name="DetailValue" Grid.Column="2" Text="50" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="细节增强:3×3 高通提微细节 + 软门槛 —— 幅值太小的(噪点)不放大,只放大成形的纹理。六个锐化档里同等清晰度下代价最小的一个,日常首选用它">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="细节增强" VerticalAlignment="Center"/>
                            <Slider x:Name="DetailEnhanceSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    Value="0" StepFrequency="5"/>
                            <TextBlock x:Name="DetailEnhanceValue" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="去模糊:理查森-露西反卷积,复原轻微运动/对焦模糊(核与迭代都随强度连续变化)。⚠ 只对真的糊了的原片有用;放大后的图本身不糊,开了基本是白亏。⚠ 超过 900 万像素(约 4K 以上)会自动退化成普通锐化">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="去模糊" VerticalAlignment="Center"/>
                            <Slider x:Name="DeblurSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    Value="0" StepFrequency="5"/>
                            <TextBlock x:Name="DeblurValue" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="边缘增强:Sobel 边缘掩膜(幅值 + 拉普拉斯符号偏置),轮廓更硬。⚠ 它只往亮的方向加,所以只出白边不出暗边 —— 十档里最不建议开的一档(本版已把强度限幅,拉满约等于原来的 31 档)">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="边缘增强" VerticalAlignment="Center"/>
                            <Slider x:Name="EdgeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    Value="0" StepFrequency="5"/>
                            <TextBlock x:Name="EdgeValue" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="边缘抗锯齿:只磨局部对比度 ≥16 的边缘阶梯,平坦区不动。它是十档里唯一各项指标都变好的一档(PSNR 升、白边降),代价是细节变少 —— Real-ESRGAN 基底 40~60 合适,waifu2x 本来就软,建议 ≤30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="边缘抗锯齿" VerticalAlignment="Center"/>
                            <Slider x:Name="AaSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    Value="0" StepFrequency="5"/>
                            <TextBlock x:Name="AaValue" Grid.Column="2" Text="0" TextAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                        </Grid>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <!-- 高级(TTA):放在「记住上次参数」上方,与「增强」后处理隔开,默认折叠 -->
                    <Button x:Name="HighQualityToggleBtn" Content="高级 ▾" HorizontalAlignment="Stretch"
                            Click="HighQualityToggleBtn_Click"
                            ToolTipService.ToolTip="高级:反复推演,细节更稳更清晰。⚠ 开启后会严重增加导出时间(约 2~3 倍)"/>
                    <StackPanel x:Name="HighQualityPanel" Spacing="8" Margin="0,8,0,4" Visibility="Collapsed">
                        <CheckBox x:Name="TtaCheck" Content="开启高级增强(反复推演,更清晰)"
                                  ToolTipService.ToolTip="高级:反复推演,细节更稳更清晰。⚠ 开启后会严重增加导出时间(约 2~3 倍)"/>
                        <TextBlock Text="⚠ 开启后会严重增加导出时间" Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- 参数预设:整套图片超分参数快照,一键保存/应用(与视频页预设区分,导出为 .alhimg) -->
                    <TextBlock Text="参数预设" Style="{StaticResource SectionTitle}"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="使用预设" Click="OpenPresetWindowBtn_Click"
                                HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="打开图片预设列表:点选应用、删除、导出/导入"/>
                        <Button Grid.Column="1" Content="保存预设" Click="SavePresetBtn_Click"
                                HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="把当前图片参数保存为一个预设(上限 100 个)"/>
                    </Grid>

                    <!-- 重置所有参数 / 记住上次:与视频页同一布局(两栏) -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ImgResetBtn" Grid.Column="0" Content="重置所有参数"
                                ToolTipService.ToolTip="恢复全部默认参数(算法/模型/倍率/降噪/TTA/格式/全部增强/预处理降噪)"
                                HorizontalAlignment="Stretch" Click="ImgResetBtn_Click"/>
                        <CheckBox x:Name="RememberCheck" Grid.Column="1" Content="记住上次参数" IsChecked="True"
                                  VerticalAlignment="Center"
                                  ToolTipService.ToolTip="记住:算法模式、waifu2x 模型、放大倍数、降噪级别、TTA、输出格式、输出目录、保留细节、锐化、预处理降噪及其强度"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <TextBlock Text="输出" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Spacing="6">
                        <TextBlock Text="格式" Style="{StaticResource HintText}"/>
                        <ComboBox x:Name="FmtCombo" HorizontalAlignment="Stretch"
                                  SelectedIndex="0"
                                  ToolTipService.ToolTip="输出格式:JPG 有损压缩(文件小,照片日常首选);PNG 无损(文件大,用于需要透明/后续编辑)">
                            <ComboBoxItem Content="JPG"/>
                            <ComboBoxItem Content="PNG"/>
                        </ComboBox>
                        <TextBlock Text="输出码率" Style="{StaticResource HintText}"/>
                        <ComboBox x:Name="ImgQualityCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="ImgQualityCombo_Changed"
                                  ToolTipService.ToolTip="JPG=压缩质量(越高文件越大画质越好);PNG=无损,档位只影响文件大小与保存速度,画质不变"/>
                        <Grid x:Name="ImgQualityCustomRow" ColumnSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="质量" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox x:Name="ImgQualityCustomBox" Grid.Column="1" PlaceholderText="1~100"
                                     IsSpellCheckEnabled="False" TextChanged="ImgQualityCustomBox_TextChanged"/>
                            <TextBlock Grid.Column="2" Text="1~100" VerticalAlignment="Center" FontSize="11" Opacity="0.6"/>
                        </Grid>
                    </StackPanel>
                    <TextBox x:Name="OutDirBox" PlaceholderText="默认与源图同目录"
                             IsSpellCheckEnabled="False" TextChanged="OutDirBox_TextChanged"
                             ToolTipService.ToolTip="输出文件夹:留空=和源图同目录"/>
                    <Button Content="选择输出文件夹..." Click="BrowseOut_Click"
                            HorizontalAlignment="Stretch"/>
                    <TextBlock Text="多张图片时自动在输出目录创建子文件夹"
                               Style="{StaticResource HintText}" TextWrapping="Wrap"/>

                    <!-- 操作按钮:上一排「开始放大」(占满变宽),中间「暂停/恢复」,最下方「停止」 -->
                    <StackPanel Spacing="8">
                        <Button x:Name="RunBtn" Content="开始处理"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" MinHeight="48"
                                IsEnabled="False" Click="RunBtn_Click"/>
                        <!-- 耗时提示(黄色):启用耗时功能时提示处理时间会增加 -->
                        <TextBlock x:Name="SpeedHint" Text=""
                                   Foreground="#E8A33D" FontSize="11" TextWrapping="Wrap"
                                   TextAlignment="Center" Visibility="Collapsed"/>
                        <!-- 引擎能力提示(黄色):当前引擎不支持用户已选的参数(如 ONNX 稳定引擎的降噪/TTA)时显式告知,不许静默忽略 -->
                        <TextBlock x:Name="EngineCapHint" Text=""
                                   Foreground="#E8A33D" FontSize="11" TextWrapping="Wrap"
                                   TextAlignment="Center" Visibility="Collapsed"/>
                        <CheckBox x:Name="SelectedOnlyCheck" Content="只处理选中的项目"
                                  ToolTipService.ToolTip="勾选后只处理右侧列表里选中的项;不勾选则处理全部"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PauseBtn" Grid.Column="0" Content="暂停"
                                    HorizontalAlignment="Stretch" MinHeight="44"
                                    IsEnabled="False" Click="PauseBtn_Click"
                                    ToolTipService.ToolTip="暂停:处理完当前这张后停下,可删除还没处理的项目"/>
                            <Button x:Name="ResumeBtn" Grid.Column="1" Content="恢复"
                                    HorizontalAlignment="Stretch" MinHeight="44"
                                    IsEnabled="False" Click="ResumeBtn_Click"
                                    ToolTipService.ToolTip="恢复:立即继续处理"/>
                        </Grid>
                        <Button x:Name="CancelBtn" Content="强制结束"
                                HorizontalAlignment="Stretch" MinHeight="44" Background="#E5484D" Foreground="White"
                                IsEnabled="False" Click="CancelBtn_Click"
                                ToolTipService.ToolTip="强制结束当前任务;休息时变「跳过休息」,点一下跳过休息继续处理"/>
                    </StackPanel>

                    <ProgressBar x:Name="TaskProgress" Minimum="0" Maximum="100" Value="0"/>
                    <TextBlock x:Name="TaskStatus" Style="{StaticResource HintText}"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- 输出规格提示:未处理时显示当前选中项将输出的分辨率(随倍率/选中项实时更新) -->
                    <TextBlock x:Name="OutSpecText" FontSize="11" Opacity="0.75"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <!-- 日志详情:记录处理过程,自动滚动,超限自动清理 -->
                    <Border Background="{StaticResource AppPanelBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8,6">
                        <!-- 滚动条常驻:见 VideoView.xaml 的说明(Auto + 自动折行会成布局循环) -->
                        <ScrollViewer x:Name="TaskLogScroll" MaxHeight="220"
                                      VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="TaskLogText" FontSize="10" Opacity="0.7"
                                       TextWrapping="Wrap"
                                       Text="日志:等待任务..."/>
                        </ScrollViewer>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ 右侧:列表控件 + 预览覆盖层 ============ -->
        <Grid Grid.Column="1" Margin="0,0,10,10">
            <Grid>
                <local:ImageToolGrid x:Name="ToolGrid"
                                     SelectionChanged="ToolGrid_SelectionChanged"/>

                <!-- 大图预览覆盖层(双击缩略图打开,纯查看) -->
                <Grid x:Name="PreviewOverlay" Visibility="Collapsed" Background="#CC0D0F14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="16"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Button Content="关闭预览" Click="PreviewClose_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
