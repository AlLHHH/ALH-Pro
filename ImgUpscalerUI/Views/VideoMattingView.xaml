<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="ALHPro.Views.VideoMattingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ALHPro.Views"
    mc:Ignorable="d">

    <!-- 视频抠图:独立板块(2026-09-22 用户明确要求)。
         结构照其它模式:左侧参数面板 + 右侧【任务列表】;进度与结果走底部状态栏(StatusChanged),
         页面里不放日志框(用户 2026-09-22 反馈:"日志怎么在这里 要和其他模式一样")。 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 参数面板(圆角卡片,与图片抠图页同款) ============ -->
        <Border Grid.Column="0" Background="{StaticResource AppPanelBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="12" Margin="0,0,10,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="14,16" Spacing="14">

                    <TextBlock Text="素材" Style="{StaticResource SectionTitle}"/>
                    <Button x:Name="PickBtn" Content="添加视频(可多选)..." Click="PickBtn_Click"
                            HorizontalAlignment="Stretch"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ClearBtn" Content="清空" Click="Clear_Click"/>
                        <Button x:Name="RemoveBtn" Content="移除选中" Click="Remove_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="FileInfo" Text="未添加视频" Style="{StaticResource HintText}"
                               TextTrimming="CharacterEllipsis"/>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <TextBlock Text="输出方式" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Spacing="6">
                        <RadioButton x:Name="ModeBgRadio" Content="换背景(输出普通视频)" IsChecked="True"
                                     GroupName="MattingOutputMode" Checked="OutputMode_Changed"/>
                        <RadioButton x:Name="ModeAlphaRadio" Content="透明通道(带 alpha,给剪辑软件用)"
                                     GroupName="MattingOutputMode" Checked="OutputMode_Changed"/>
                    </StackPanel>

                    <StackPanel x:Name="BgPanel" Spacing="8">
                        <TextBlock Text="背景" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Spacing="6">
                            <RadioButton x:Name="BgColorRadio" Content="纯色" IsChecked="True" GroupName="MattingBg"
                                         Checked="BgMode_Changed"/>
                            <RadioButton x:Name="BgImageRadio" Content="图片" GroupName="MattingBg"
                                         Checked="BgMode_Changed"/>
                        </StackPanel>
                        <Grid x:Name="BgColorRow" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BgColorBox" Text="#1E3A5F" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="背景色" Style="{StaticResource HintText}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <Button x:Name="BgImageBtn" Content="选择背景图片..." Click="BgImage_Click" Visibility="Collapsed"
                                HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="BgImageInfo" Text="未选择背景图片" Style="{StaticResource HintText}"
                                   Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <TextBlock Text="抠图模型" Style="{StaticResource SectionTitle}"/>
                    <ComboBox x:Name="ModelCombo" HorizontalAlignment="Stretch"
                              SelectionChanged="ModelCombo_SelectionChanged"
                              ToolTipService.ToolTip="默认 ISNet 精细边缘:本机 GPU 实测最快(约 0.26 秒/帧蒙版)、边缘最细;BiRefNet 判别力强但本机 DirectML 上会回退 CPU"/>
                    <TextBlock x:Name="ModelHint" Style="{StaticResource HintText}" TextWrapping="Wrap"/>

                    <TextBlock Text="抠图参数" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="FgLabel" Style="{StaticResource HintText}"/>
                    <Slider x:Name="FgSlider" Minimum="0" Maximum="255" Value="152" StepFrequency="1"
                            ValueChanged="Param_ValueChanged"/>
                    <TextBlock x:Name="BgLabel" Style="{StaticResource HintText}"/>
                    <Slider x:Name="BgSlider" Minimum="0" Maximum="255" Value="84" StepFrequency="1"
                            ValueChanged="Param_ValueChanged"/>
                    <TextBlock x:Name="FeatherLabel" Style="{StaticResource HintText}"/>
                    <Slider x:Name="FeatherSlider" Minimum="0" Maximum="20" Value="1" StepFrequency="1"
                            ValueChanged="Param_ValueChanged"/>
                    <TextBlock x:Name="MorphLabel" Style="{StaticResource HintText}"/>
                    <Slider x:Name="MorphSlider" Minimum="0" Maximum="100" Value="28" StepFrequency="1"
                            ValueChanged="Param_ValueChanged"/>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <TextBlock Text="时序稳定" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="StabilityLabel" Style="{StaticResource HintText}"/>
                    <Slider x:Name="StabilitySlider" Minimum="0" Maximum="100" Value="50" StepFrequency="1"
                            ValueChanged="Param_ValueChanged"/>
                    <TextBlock Text="抖动越小越稳,但过高会让快速运动拖影;静止画面建议 50~80。"
                               Style="{StaticResource HintText}" TextWrapping="Wrap"/>

                    <Border Height="1" Background="{StaticResource AppBorderBrush}"/>

                    <TextBlock Text="输出" Style="{StaticResource SectionTitle}"/>
                    <Button x:Name="OutDirBtn" Content="选择输出文件夹..." Click="OutDir_Click"
                            HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="OutDirText" Text="默认与源视频同目录" Style="{StaticResource HintText}"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- 容器:仅"透明通道"显示;默认第一项 = MOV/ProRes 4444(实测到处都认) -->
                    <StackPanel x:Name="ContainerPanel" Spacing="6" Visibility="Collapsed">
                        <TextBlock Text="容器" Style="{StaticResource HintText}"/>
                        <ComboBox x:Name="ContainerCombo" HorizontalAlignment="Stretch"
                                  ToolTipService.ToolTip="MOV / ProRes 4444:剪辑软件普遍认,体积较大;&#x0a;WebM / VP9-alpha:体积小,但能否透明取决于对方解码器(连 ffmpeg 原生 vp9 解码器都会丢 alpha)"/>
                        <TextBlock Text="要叠加请用剪辑软件(Premiere / 剪映 / DaVinci / OBS):多数播放器会把透明显示成黑底。"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button x:Name="StartBtn" Content="开始处理" Click="Start_Click"
                            HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                    <Button x:Name="CancelBtn" Content="取消" Click="Cancel_Click" IsEnabled="False"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ 右侧任务列表(与视频处理页同款:ListView + 进度条) ============ -->
        <Border Grid.Column="1" Background="{StaticResource AppPanelBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="12" Margin="0,0,0,10">
            <Grid Padding="14" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TaskTitle" Text="任务列表" FontSize="15"/>
                <ListView Grid.Row="1" x:Name="TaskList" SelectionMode="Extended"
                          BorderThickness="0" Background="Transparent"/>
                <Grid Grid.Row="2" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ProgressText" TextWrapping="Wrap" Style="{StaticResource HintText}"
                               Text="添加视频后点「开始处理」。换背景输出普通视频;透明通道输出带 alpha 的视频给剪辑软件用。"/>
                    <ProgressBar Grid.Row="1" x:Name="TaskBar" Minimum="0" Maximum="100" Value="0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
