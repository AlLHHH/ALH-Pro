<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="ALHPro.Views.VideoMattingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ALHPro.Views"
    mc:Ignorable="d">

    <!-- 视频抠图:独立板块。骨架照 VideoView.xaml:左栏 322 + 右侧裸 Grid(摘要/工具栏/列表宿主)。
         用户 2026-09-22 追加要求:
           ① 进度条放到「开始处理」下面(不放右侧项目页下面);
           ② 顶部摘要用视频页那套"已处理 / 剩余"计数,不再堆"未处理/待处理";
           ③ 主按钮与视频页完全一致:开始处理=AccentButtonStyle+MinHeight 48,取消=红底 #FFE5484D;
           ④ 背景色加色块(白/黑/绿)+ 调色板(ColorPicker)直接选色。
         用户 2026-09-23 欠账(本轮落实):
           ⑤ **色块挪到输入框右侧**:那一格显示"当前颜色"、点它开调色板 ⇒ 输入框/色块/调色板三者
              永远是同一个值,不用再在"上面的色块"和"下面的输入框"之间来回看;
           ⑥ **焦点离开时归一化**:输入框失焦或按回车 → 把 `fff` / `#F0A` / `0x1E3A5F` 这类写法
              统一成 `#RRGGBB`;解析不了就**明确提示并退回上一个有效值**(绝不静默变黑 —— 下游只认
              6 位十六进制,不归一化就会悄悄变黑,这正是本条欠账要治的病);
           ⑦ **框选**:右侧任务列表支持鼠标橡皮筋多选(与视频页 VideoGridHost 同一套四个指针处理器)。
         本文件是**整份重写**的(结构改动不用脚本打补丁 —— 上个会话在 XAML 上被脚本锚点坑过 4 次)。-->
    <Grid Background="Transparent" AllowDrop="True" DragOver="DropArea_DragOver" Drop="DropArea_Drop">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="322"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左栏 ============ -->
        <Border Grid.Column="0" Background="{StaticResource AppPanelBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="12" Margin="0,0,10,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="14,16" Spacing="12">

                    <TextBlock Text="输出方式" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Spacing="4">
                        <RadioButton x:Name="ModeBgRadio" Content="换背景(输出普通视频)" IsChecked="True"
                                     GroupName="MattingOutputMode" Checked="OutputMode_Changed"/>
                        <RadioButton x:Name="ModeAlphaRadio" Content="透明通道(带 alpha,给剪辑软件用)"
                                     GroupName="MattingOutputMode" Checked="OutputMode_Changed"/>
                    </StackPanel>

                    <StackPanel x:Name="BgPanel" Spacing="6">
                        <TextBlock Text="背景" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <RadioButton x:Name="BgColorRadio" Content="纯色" IsChecked="True" GroupName="MattingBg"
                                         Checked="BgMode_Changed"/>
                            <RadioButton x:Name="BgImageRadio" Content="图片" GroupName="MattingBg"
                                         Checked="BgMode_Changed"/>
                        </StackPanel>

                        <!-- 纯色:第一行=三个常用色块(一键设值);第二行=十六进制输入框 + **右侧当前色块**
                             (那一格显示当前颜色、点它开调色板)。三者共用同一个值,写入都走 SetBgColor。 -->
                        <StackPanel x:Name="BgColorRow" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="SwatchWhite" Click="Swatch_Click" Tag="#FFFFFF"
                                        ToolTipService.ToolTip="白色" Padding="0" Width="34" Height="26"
                                        BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                                    <Border Background="White" CornerRadius="2" Width="24" Height="16"/>
                                </Button>
                                <Button x:Name="SwatchBlack" Click="Swatch_Click" Tag="#000000"
                                        ToolTipService.ToolTip="黑色" Padding="0" Width="34" Height="26"
                                        BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                                    <Border Background="Black" CornerRadius="2" Width="24" Height="16"/>
                                </Button>
                                <Button x:Name="SwatchGreen" Click="Swatch_Click" Tag="#00B140"
                                        ToolTipService.ToolTip="绿幕(抠像后期常用)" Padding="0" Width="34" Height="26"
                                        BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                                    <Border Background="#00B140" CornerRadius="2" Width="24" Height="16"/>
                                </Button>
                                <TextBlock Text="背景色" VerticalAlignment="Center" FontSize="11" Opacity="0.6"/>
                            </StackPanel>

                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BgColorBox" Grid.Column="0" Text="#1E3A5F" IsSpellCheckEnabled="False"
                                         LostFocus="BgColorBox_LostFocus" KeyDown="BgColorBox_KeyDown"
                                         ToolTipService.ToolTip="背景色(十六进制)。#RRGGBB 或简写 #RGB 都行;离开输入框时会自动归一化"/>
                                <!-- 输入框右侧的**当前色块**:显示现在的颜色;点它开调色板
                                     (Button.Flyout 本身就是"点一下弹出来"的语义,不另挂 Click,免得弹两次)。 -->
                                <Button x:Name="SwatchCurrent" Grid.Column="1" Padding="0" Height="32"
                                        BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                        ToolTipService.ToolTip="当前背景色 —— 点这里打开调色板选任意颜色">
                                    <Border x:Name="SwatchCurrentFill" Background="#1E3A5F" CornerRadius="3"
                                            Width="30" Height="22"/>
                                    <Button.Flyout>
                                        <Flyout>
                                            <ColorPicker x:Name="BgColorPicker" IsAlphaEnabled="False"
                                                         IsAlphaSliderVisible="False" IsAlphaTextInputVisible="False"
                                                         IsHexInputVisible="True" IsColorChannelTextInputVisible="True"
                                                         ColorChanged="BgColorPicker_ColorChanged"/>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="BgColorHint" Style="{StaticResource HintText}" TextWrapping="Wrap"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <Button x:Name="BgImageBtn" Content="选择背景图片..." Click="BgImage_Click"
                                Visibility="Collapsed" HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="BgImageInfo" Text="未选择背景图片" Visibility="Collapsed"
                                   Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <TextBlock Text="抠图模型" Style="{StaticResource SectionTitle}"/>
                    <ComboBox x:Name="ModelCombo" HorizontalAlignment="Stretch"
                              SelectionChanged="ModelCombo_SelectionChanged"
                              ToolTipService.ToolTip="默认 ISNet 精细边缘:本机 GPU 实测最快、边缘最细;BiRefNet 判别力强但本机 DirectML 上会回退 CPU"/>
                    <TextBlock x:Name="ModelHint" Style="{StaticResource HintText}" TextWrapping="Wrap"/>

                    <TextBlock Text="抠图参数" Style="{StaticResource SectionTitle}"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="前景" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="FgSlider" Minimum="0" Maximum="255" Value="152"
                                StepFrequency="1" ValueChanged="Param_ValueChanged"/>
                        <TextBlock Grid.Column="2" x:Name="FgVal" Text="152" VerticalAlignment="Center"
                                   Opacity="0.7" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="1" Text="背景" VerticalAlignment="Center"/>
                        <Slider Grid.Row="1" Grid.Column="1" x:Name="BgSlider" Minimum="0" Maximum="255" Value="84"
                                StepFrequency="1" ValueChanged="Param_ValueChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="BgVal" Text="84" VerticalAlignment="Center"
                                   Opacity="0.7" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="2" Text="羽化" VerticalAlignment="Center"/>
                        <Slider Grid.Row="2" Grid.Column="1" x:Name="FeatherSlider" Minimum="0" Maximum="20" Value="1"
                                StepFrequency="1" ValueChanged="Param_ValueChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="FeatherVal" Text="1" VerticalAlignment="Center"
                                   Opacity="0.7" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="3" Text="形态学" VerticalAlignment="Center"/>
                        <Slider Grid.Row="3" Grid.Column="1" x:Name="MorphSlider" Minimum="0" Maximum="100" Value="28"
                                StepFrequency="1" ValueChanged="Param_ValueChanged"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" x:Name="MorphVal" Text="28" VerticalAlignment="Center"
                                   Opacity="0.7" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="4" Text="时序稳定" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="治逐帧抖动:静止区更稳,运动区少平滑;切镜自动重置"/>
                        <Slider Grid.Row="4" Grid.Column="1" x:Name="StabilitySlider" Minimum="0" Maximum="100"
                                Value="50" StepFrequency="1" ValueChanged="Param_ValueChanged"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" x:Name="StabilityVal" Text="50" VerticalAlignment="Center"
                                   Opacity="0.7" HorizontalAlignment="Right"/>
                    </Grid>
                    <Button x:Name="ResetBtn" Content="重置调整" HorizontalAlignment="Right" Click="Reset_Click"
                            FontSize="12" Padding="12,4"/>
                    <TextBlock Text="前景/背景阈值以上算实心、以下算透明,中间羽化过渡;时序稳定越高越稳,但快速运动会拖影。"
                               Style="{StaticResource HintText}" TextWrapping="Wrap"/>

                    <TextBlock Text="输出" Style="{StaticResource SectionTitle}"/>
                    <TextBox x:Name="OutDirBox" IsReadOnly="True" PlaceholderText="默认与源视频同目录"
                             IsSpellCheckEnabled="False"/>
                    <Button x:Name="OutDirBtn" Content="选择输出位置..." Click="OutDir_Click"
                            HorizontalAlignment="Stretch"/>

                    <TextBlock Text="码率 / 格式" Style="{StaticResource SectionTitle}"/>
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="码率" VerticalAlignment="Center" FontSize="12"
                                   ToolTipService.ToolTip="输出画质:跟随应用既有的编码器策略(硬编优先),本页不单独改写"/>
                        <ComboBox Grid.Column="1" x:Name="BitrateCombo" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="自动 (推荐)"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="格式" VerticalAlignment="Center" FontSize="12"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FormatCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="FormatCombo_Changed"
                                  ToolTipService.ToolTip="换背景=MP4(通用性最好);透明通道=MOV/ProRes 4444(剪辑软件都认)或 WebM/VP9-alpha(体积小)"/>

                        <TextBlock Grid.Row="2" Text="编码格式" VerticalAlignment="Center" FontSize="12"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CodecCombo" HorizontalAlignment="Stretch"
                                  IsEnabled="False"
                                  ToolTipService.ToolTip="由上面选的格式决定:MP4 跟随全局编码器策略;MOV=ProRes 4444;WebM=VP9-alpha"/>

                        <CheckBox Grid.Row="3" Grid.ColumnSpan="2" x:Name="MuteCheck"
                                  Content="静音(输出不含音频)" FontSize="12"
                                  ToolTipService.ToolTip="音频由输出方式决定:透明通道不带音频;换背景保留源音频"/>
                    </Grid>

                    <!-- 主按钮:与视频页完全一致(AccentButtonStyle + MinHeight 48;取消为红底) -->
                    <Button x:Name="StartBtn" Content="开始处理" Click="Start_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" MinHeight="48" Margin="0,4,0,0"/>
                    <Button x:Name="CancelBtn" Content="取消" Click="Cancel_Click" IsEnabled="False"
                            FontSize="12" Padding="12,7" HorizontalAlignment="Stretch"
                            Background="#FFE5484D" Foreground="White" BorderThickness="0"/>

                    <!-- 处理进度:紧跟「开始处理」下方(用户要求:进度不该在右侧项目页下面) -->
                    <Border Background="{StaticResource AppBgBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8,6">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="ProgressText" FontSize="11" Opacity="0.8"
                                       TextWrapping="Wrap" Text="就绪"/>
                            <ProgressBar x:Name="TaskBar" Minimum="0" Maximum="100" Value="0" Height="4"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource AppBgBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8,6">
                        <ScrollViewer x:Name="VideoLogScroll" MaxHeight="220"
                                      VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="VideoLogText" FontSize="10" Opacity="0.7"
                                       TextWrapping="Wrap" Text="日志:等待任务..."/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ 右侧(裸 Grid,与视频页同构) ============ -->
        <Grid Grid.Column="1" Margin="0,0,10,10">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 任务摘要:与视频页同款属性(计数由 code-behind 写成"已处理 X / 剩余 Y") -->
                <TextBlock x:Name="TaskTitle" Grid.Row="0" FontSize="12" Opacity="0.85"
                           Text="等待任务" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"/>

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PickBtn" Content="添加视频" FontSize="12" Padding="10,5" Click="PickBtn_Click"/>
                    <Button Grid.Column="1" x:Name="RemoveBtn" Content="删除选中" FontSize="12" Padding="10,5"
                            IsEnabled="False" Click="Remove_Click"/>
                    <Button Grid.Column="2" x:Name="ClearBtn" Content="清空" FontSize="12" Padding="10,5"
                            IsEnabled="False" Click="Clear_Click"/>
                    <Button Grid.Column="3" x:Name="DoneBtn" Content="清除已完成" FontSize="12" Padding="10,5"
                            IsEnabled="False" Click="Done_Click" ToolTipService.ToolTip="清除所有已完成(灰)的项目"/>
                    <TextBlock Grid.Column="4" Text="拖入视频即可添加 · 空白处拖动可框选" FontSize="11" Opacity="0.5"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- 任务列表宿主(**橡皮筋框选的挂载点**,照 VideoView 的 VideoGridHost):
                     四个指针处理器挂在**宿主 Grid** 上、可见的矩形画在宿主里的 Canvas 上。
                     注意:按在列表项上不启动框选(交回 ListView 做点击选中/拖拽排序),见 code-behind 的 IsPressOnTaskItem。 -->
                <Grid x:Name="TaskGridHost" Grid.Row="2" Background="Transparent" AllowDrop="True"
                      PointerPressed="TaskGridHost_PointerPressed"
                      PointerMoved="TaskGridHost_PointerMoved"
                      PointerReleased="TaskGridHost_PointerReleased"
                      PointerCaptureLost="TaskGridHost_PointerCaptureLost"
                      DragOver="DropArea_DragOver" Drop="DropArea_Drop">
                    <ListView x:Name="TaskList" SelectionMode="Multiple" SelectionChanged="TaskList_SelectionChanged"
                              KeyDown="TaskList_KeyDown"
                              IsItemClickEnabled="True" CanDragItems="True" CanReorderItems="True"
                              Background="Transparent" BorderThickness="0" AllowDrop="True"
                              DragOver="DropArea_DragOver" Drop="DropArea_Drop"
                              ToolTipService.ToolTip="">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" Padding="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="Thumb" Source="{Binding Thumb}" Stretch="Uniform"
                                           Width="120" Height="68" Opacity="{Binding DoneItemOpacity}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" Opacity="{Binding DoneItemOpacity}"/>
                                            <Border Background="{Binding StateBadgeBrush}" CornerRadius="4" Padding="5,2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding StateBadgeVisibility}">
                                                <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="White" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Info}" FontSize="11" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding OutputInfo}" FontSize="11"
                                                   Foreground="#4C8DFF" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding OutputInfoVisibility}"/>
                                        <ProgressBar Height="4" Maximum="100" Value="{Binding Progress}"
                                                     Visibility="{Binding ProgressVisibility}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 框选橡皮筋(Canvas 内定位;IsHitTestVisible=false ⇒ 不吃指针,也不会挡列表) -->
                    <Canvas IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Rectangle x:Name="RbRectM" Visibility="Collapsed"
                                   Stroke="#5B8DEF" StrokeThickness="1" Fill="#335B8DEF"
                                   IsHitTestVisible="False"/>
                    </Canvas>

                    <StackPanel x:Name="EmptyHint" IsHitTestVisible="False" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="6">
                        <TextBlock Text="＋" FontSize="34" HorizontalAlignment="Center" Opacity="0.5"/>
                        <TextBlock Text="拖入项目" HorizontalAlignment="Center" FontSize="14"/>
                        <TextBlock Text="MP4 / MKV / MOV / WebM / AVI" HorizontalAlignment="Center" FontSize="11"
                                   Opacity="0.55"/>
                        <TextBlock x:Name="EngineHint" Text="组件: ffmpeg ✓ · 模型 ✓" HorizontalAlignment="Center"
                                   FontSize="11" Opacity="0.55"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============ 【开发中】遮罩横幅(2026-09-23 用户要求:"加一个开发中横幅 敬请期待 并且背景模糊") ============
             做法 = "整页禁用(代码后端 VideoMattingView() 里那一行 this.IsEnabled = false) + 盖一层磨砂
                    + 居中一块横幅":
               ① 锁:本页(UserControl 本身就是 Control)禁用 ⇒ 整棵页面子树收不到点击/滚轮/Tab/回车,
                  也没有任何 drop 目标。UIA 里全页控件会报 en=False,这就是"真的锁住了"的客观证据
                  (不是肉眼猜)。**子控件自己设 IsEnabled=true 翻不过来** —— 有效可用性 = 自己 ∩ 所有祖先。
                  【为什么不写在 XAML 里】WinUI 3 的 IsEnabled 是 **Control 的成员,不是 UIElement 的**
                  (实测:钉在根 Grid 上报 XamlCompiler error WMC0011 "Unknown member 'IsEnabled' on
                  element 'Grid'")。所以要么钉在 Control 上(本页自己),要么包一层 ContentControl —— 选前者。
               ② 模糊:AcrylicBrush ⇒ 系统去模糊**它下层的内容**,也就是下面那一整页控件(应用内 acrylic,
                  不是糊窗口外的桌面),再压深色 tint 让横幅文字看得清;系统关了"透明效果"或省电模式时
                  自动退化成 FallbackColor 的纯色 ⇒ **不会出现"全透明糊成一片啥也看不见"**。
                  【注意】WinUI 3 的 AcrylicBrush **没有 BackgroundSource 属性**(实测:WMC0011 Unknown
                  member'BackgroundSource'),别再照着 UWP 文档写那一句。
               ③ 横幅:圆角卡片 + 图标 + 「视频抠图 · 开发中」+「敬请期待」+ 一行小字(只说这一页没开放,
                  不让用户以为整个软件坏了)。
             【撤掉"开发中"状态】= 删掉这一整块 + 去掉代码后端构造函数末尾那句 this.IsEnabled = false。
             【坑,别踩】横幅自己在"被禁用"的页面里 —— 纯文本无所谓;以后若想在横幅上加按钮(比如"预约提醒"),
             就得改成只禁用内容区(包一层 ContentControl 设 IsEnabled=false)并把横幅放到它外面,不能再整页禁用。 -->
        <Grid x:Name="DevBannerOverlay" Grid.ColumnSpan="2">
            <Grid.Background>
                <AcrylicBrush TintColor="#FF0E131A" TintOpacity="0.25"
                              TintLuminosityOpacity="0.55" FallbackColor="#F00E131A"/>
            </Grid.Background>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16" Padding="38,28"
                    Background="#FA151A22" BorderBrush="#4D6E8BF0" BorderThickness="1">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Text="🚧" FontSize="36" HorizontalAlignment="Center"/>
                    <TextBlock Text="视频抠图 · 开发中" FontSize="24" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="敬请期待" FontSize="16" Foreground="#FFB9C6DE" HorizontalAlignment="Center"/>
                    <TextBlock Text="这个功能还没做完,先没放出来。现有的「图片抠图」照常可用。"
                               FontSize="12" Foreground="#FF8C97A8" MaxWidth="420"
                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
