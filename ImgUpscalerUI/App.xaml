<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="ALHPro.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ALHPro"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- 全局深色调色板 -->
            <Color x:Key="AppBg">#14161B</Color>
            <Color x:Key="AppPanel">#1B1D24</Color>
            <Color x:Key="AppPanel2">#20222A</Color>
            <Color x:Key="AppBorder">#2C2F38</Color>
            <Color x:Key="AppAccent">#5B8DEF</Color>

            <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBg}" />
            <SolidColorBrush x:Key="AppPanelBrush" Color="{StaticResource AppPanel}" />
            <SolidColorBrush x:Key="AppPanel2Brush" Color="{StaticResource AppPanel2}" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorder}" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccent}" />
            <SolidColorBrush x:Key="WhiteBrush" Color="White" />
            <SolidColorBrush x:Key="BlackBrush" Color="Black" />

            <x:Double x:Key="AppFontSize">13</x:Double>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#B8C0CC"/>
            </Style>

            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#667"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
