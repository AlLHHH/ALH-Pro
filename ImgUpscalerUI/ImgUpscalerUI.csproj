<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <OutputType>WinExe</OutputType>

        <!-- WinUI 3 -->
        <UseWinUI>true</UseWinUI>
        <EnableMsixTooling>true</EnableMsixTooling>
        <WindowsPackageType>None</WindowsPackageType>
        <!-- 自包含部署:Windows App Runtime 一起打包进输出目录,发给别人直接运行,
             无需安装任何运行时(框架依赖模式才需要对方装对应版本运行时,装错版本会闪退) -->
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

        <!-- Project Options -->
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>ALHPro</RootNamespace>
        <AssemblyName>ALHPro</AssemblyName>
        <Version>1.2.2</Version>
        <!-- 汇编元数据:文件属性里显示的作者/版权(版权保护的第一步:署名清晰、可追责) -->
        <Authors>AlL.H</Authors>
        <Company>AlL.H</Company>
        <Product>ALH Pro</Product>
        <Copyright>© 2026 AlL.H. 保留所有权利。</Copyright>

        <!-- App Options -->
        <UseRidGraph>true</UseRidGraph>
        <WindowsSdkPackageVersion>10.0.19041.38</WindowsSdkPackageVersion>
        <Platforms>x64</Platforms>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>
        <PublishProfile>win-$(Platform).pubxml</PublishProfile>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    </PropertyGroup>

    <!-- Release:不产 PDB(发布包小 100MB+,诊断日志靠托管堆栈文本,无需符号文件) -->
    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.19.2" />
        <PackageReference Include="System.Drawing.Common" Version="8.0.7" />
    </ItemGroup>

    <!-- ===== 关键:VC++ 运行库(自包含部署必须手动带上)=====
         Windows App SDK 自包含模式(SelfContained=true)不自动携带 VC++ 运行库,
         缺 msvcp140.dll 的干净电脑启动即闪退(转圈后无窗口)。
         微软许可允许再分发;从仓库 assets\runtime 复制,任何人 clone 后都可构建。
         ⚠ vcruntime140_threads.dll 必须带:新版组件依赖它导出
         __std_parallel_algorithms_hw_threads;缺它报"无法定位程序输入点"(真机实测)。
         ⚠ 不带 d3dcompiler_47.dll:它是 Windows 10/11 系统自带 DLL,系统版本已含所需符号;
         随包带反而会"程序目录旧文件覆盖系统新版"引发"无法定位程序输入点"报错(真机实测)。 -->
    <ItemGroup>
        <None Include="..\assets\runtime\msvcp140.dll" Link="msvcp140.dll" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\assets\runtime\vcruntime140.dll" Link="vcruntime140.dll" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\assets\runtime\vcruntime140_1.dll" Link="vcruntime140_1.dll" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\assets\runtime\vcruntime140_threads.dll" Link="vcruntime140_threads.dll" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- 窗口顶栏图标:复制到输出目录供 AppWindow.SetIcon 使用 -->
    <ItemGroup>
        <None Include="..\assets\icon.ico" Link="ALHPro.ico" CopyToOutputDirectory="PreserveNewest"/>

        <None Include="LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="THIRD_PARTY_NOTICES.txt" Link="THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="..\RELEASE_NOTES.md" Link="RELEASE_NOTES.md" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="..\release_history.json" Link="release_history.json" CopyToOutputDirectory="PreserveNewest"/>
        <!-- 使用教程:打包到输出目录,软件内教程页读取渲染(替换此文件即可更新教程,无需重编译) -->
        <None Include="..\使用教程.md" Link="使用教程.md" CopyToOutputDirectory="PreserveNewest"/>
        <!-- 标题栏/应用内图标:由 icon.ico 提取的 PNG(ffmpeg 转换)。BitmapImage 不支持 .ico,用 PNG 加载 -->
        <None Include="ALHPro_icon.png" Link="ALHPro_icon.png" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Assets\SplashScreen.scale-200.png" />
        <Content Include="Assets\LockScreenLogo.scale-200.png" />
        <Content Include="Assets\Square150x150Logo.scale-200.png" />
        <Content Include="Assets\Square44x44Logo.scale-200.png" />
        <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
        <Content Include="Assets\StoreLogo.png" />
        <Content Include="Assets\Wide310x150Logo.scale-200.png" />
        <!-- 标题栏/内页图标(ALHPro 品牌,PNG):打包资源,用 ms-appx 协议加载,无运行时 IO 风险 -->
        <Content Include="Assets\ALHPro_icon.png" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="ALHPro.slnx" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.*" />

        <Manifest Include="$(ApplicationManifest)" />
    </ItemGroup>

    <!-- 
        Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
        Tools extension to be activated for this project even if the Windows App SDK Nuget
        package has not yet been restored.
    -->
    <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <ProjectCapability Include="Msix"/>
    </ItemGroup>

    <!-- 
        Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution 
        Explorer "Package and Publish" context menu entry to be enabled for this project even if 
        the Windows App SDK Nuget package has not yet been restored.
    -->
    <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
    </PropertyGroup>
</Project>
